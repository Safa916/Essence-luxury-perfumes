<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.name %> — Essence</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/user/common.css">
  <link rel="stylesheet" href="/user/product/productDetails.css">
</head>
<body>

  <%- include('../partials/header', { activePage: 'product', user: typeof user !== 'undefined' ? user : null }) %>

  <main class="product-page">

    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> <span class="crumb-sep">/</span>
      <a href="/shop">Shop</a> <span class="crumb-sep">/</span>
      <% if (product.category_id) { %>
        <a href="/shop?category=<%= product.category_id._id %>"><%= product.category_id.name %></a> <span class="crumb-sep">/</span>
      <% } %>
      <span class="crumb-current"><%= product.name %></span>
    </nav>

    <% if (!inStock) { %>
      <div class="stock-banner">This fragrance is currently out of stock in all sizes.</div>
    <% } %>

    <section class="product-top">

      <!-- ===== Gallery ===== -->
      <div class="product-gallery">
        <div class="gallery-thumbs">
          <% (product.images || []).slice(0, 3).forEach(function (img, i) { %>
            <button type="button" class="thumb-btn <%= i === 0 ? 'is-active' : '' %>" data-image="<%= img %>">
              <img src="<%= img %>" alt="<%= product.name %> view <%= i + 1 %>">
            </button>
          <% }); %>
        </div>
        <div class="gallery-main" id="galleryMain">
          <img src="<%= (product.images && product.images[0]) || '/user/images/placeholder.jpg' %>" alt="<%= product.name %>" id="mainImage">
          <div class="zoom-lens" id="zoomLens"></div>
          <span class="zoom-hint">Click to zoom</span>
        </div>
      </div>

      <!-- ===== Product info ===== -->
      <div class="product-info">
        <p class="product-eyebrow">
          <%= product.brand_id ? product.brand_id.name.toUpperCase() : '' %><% if (product.category_id) { %> &middot; <%= product.category_id.name.toUpperCase() %> COLLECTION<% } %>
        </p>
        <h1 class="product-title"><%= product.name %></h1>

        <div class="rating-summary">
          <span class="stars" aria-hidden="true">
            <% for (let s = 1; s <= 5; s++) { %><span class="star <%= s <= Math.round(avgRating) ? 'is-filled' : '' %>">&#9733;</span><% } %>
          </span>
          <a href="#reviews" class="rating-count">
            <%= totalReviews > 0 ? avgRating.toFixed(1) : 'No ratings yet' %><% if (totalReviews > 0) { %> (<%= totalReviews %> review<%= totalReviews === 1 ? '' : 's' %>)<% } %>
          </a>
        </div>

        <div class="price-row" id="priceRow">
          <span class="price-current" id="priceCurrent">
            &#8377;<%= variants[0] ? variants[0].price.toLocaleString('en-IN') : '0' %>
          </span>
          <% if (variants[0] && variants[0].compare_at_price && variants[0].compare_at_price > variants[0].price) { %>
            <span class="price-compare" id="priceCompare">&#8377;<%= variants[0].compare_at_price.toLocaleString('en-IN') %></span>
          <% } %>
        </div>

        <p class="product-description"><%= product.short_description || product.full_description %></p>

        <% if (variants.length) { %>
          <div class="size-selector">
            <p class="size-label">Select Size</p>
            <div class="size-options" id="sizeOptions">
              <% variants.forEach(function (v, i) { %>
                <button
                  type="button"
                  class="size-btn <%= i === 0 ? 'is-selected' : '' %> <%= v.quantity <= 0 ? 'is-disabled' : '' %>"
                  data-variant-id="<%= v._id %>"
                  data-price="<%= v.price %>"
                  data-compare="<%= v.compare_at_price || '' %>"
                  data-stock="<%= v.quantity %>"
                >
                  <%= v.size_ml %>ML
                </button>
              <% }); %>
            </div>
            <p class="size-stock-note" id="sizeStockNote" style="display:none;">This size is currently out of stock.</p>
          </div>
        <% } %>

        <button
          type="button"
          class="btn btn-dark add-to-bag-btn"
          id="addToBagBtn"
          data-product-id="<%= product._id %>"
          <%= !inStock ? 'disabled' : '' %>
        >
          <%= inStock ? 'Add to Atelier Bag' : 'Out of Stock' %>
        </button>
        <button type="button" class="btn btn-outline buy-now-btn" id="buyNowBtn" <%= !inStock ? 'disabled' : '' %>>
          Buy Now
        </button>

        <p class="delivery-note">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="14" height="10" rx="1"/><path d="M16 10h3l3 3v4h-6z"/><circle cx="7" cy="19" r="1.6"/><circle cx="17.5" cy="19" r="1.6"/></svg>
          Complimentary Delivery
        </p>
      </div>
    </section>

    <!-- ===== Similar Collections ===== -->
    <section class="related-section">
      <div class="related-header">
        <div>
          <p class="eyebrow">Explore More</p>
          <h2 class="related-title">Similar Collections</h2>
        </div>
        <% if (product.brand_id) { %>
          <a href="/shop?brand=<%= product.brand_id._id %>" class="view-all">View All <%= product.brand_id.name %></a>
        <% } %>
      </div>

      <% if (relatedProducts.length) { %>
        <div class="related-grid">
          <% relatedProducts.forEach(function (rp) { %>
            <a href="/product/<%= rp.slug %>" class="related-card">
              <div class="related-image">
                <img src="<%= (rp.images && rp.images[0]) || '/user/images/placeholder.jpg' %>" alt="<%= rp.name %>">
              </div>
              <p class="related-brand"><%= product.brand_id ? product.brand_id.name : '' %></p>
              <p class="related-name"><%= rp.name %></p>
              <p class="related-price">&#8377;<%= Number(rp.price).toLocaleString('en-IN') %></p>
            </a>
          <% }); %>
        </div>
      <% } else { %>
        <p class="related-empty">No similar products to show right now.</p>
      <% } %>
    </section>

    <!-- ===== Reviews ===== -->
    <section class="reviews-section" id="reviews">
      <div class="reviews-summary">
        <span class="stars-lg" aria-hidden="true">
          <% for (let s = 1; s <= 5; s++) { %><span class="star <%= s <= Math.round(avgRating) ? 'is-filled' : '' %>">&#9733;</span><% } %>
        </span>
        <span class="reviews-summary-text">
          <%= totalReviews > 0 ? avgRating.toFixed(1) + ' out of 5' : 'No reviews yet' %><% if (totalReviews > 0) { %> &middot; <%= totalReviews %> review<%= totalReviews === 1 ? '' : 's' %><% } %>
        </span>
      </div>

      <% if (!reviews.length) { %>
        <p class="reviews-empty">No reviews yet — be the first to share your experience.</p>
      <% } else { %>
        <div class="reviews-list">
          <% reviews.forEach(function (r) { %>
            <article class="review-card">
              <div class="review-top">
                <span class="stars" aria-hidden="true">
                  <% for (let s = 1; s <= 5; s++) { %><span class="star <%= s <= r.rating ? 'is-filled' : '' %>">&#9733;</span><% } %>
                </span>
                <span class="review-time"><%= r.relativeTime %></span>
              </div>
              <% if (r.headline) { %><h3 class="review-headline"><%= r.headline %></h3><% } %>
              <% if (r.review_text) { %><p class="review-text"><%= r.review_text %></p><% } %>
              <p class="review-byline">
                <% if (r.isVerified) { %><span class="verified-badge">Verified Purchase</span> &middot; <% } %>
                <%= r.reviewerName %>
              </p>
            </article>
          <% }); %>
        </div>
      <% } %>
    </section>

  </main>

  <%- include('../partials/footer') %>

  <%- include('../partials/logout-modal') %>

  <!-- ===== Lightbox (click-to-zoom, works on mobile too) ===== -->
  <div class="lightbox-overlay" id="lightboxOverlay">
    <button type="button" class="lightbox-close" id="lightboxClose" aria-label="Close">&times;</button>
    <img id="lightboxImage" src="" alt="">
  </div>

  <script src="/user/js/product/productDetails.js"></script>

<script src="/user/js/product/addToCart.js"></script>

<div class="lb-overlay" id="lbOverlay" role="dialog" aria-modal="true" aria-label="Image gallery">
  <!-- Close button -->
  <button class="lb-close" id="lbClose" aria-label="Close gallery">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none"
         stroke="currentColor" stroke-width="1.8">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
  <!-- Counter  e.g. "2 / 4" -->
  <div class="lb-counter" id="lbCounter" aria-live="polite"></div>
  <!-- Previous arrow -->
  <button class="lb-arrow lb-arrow--prev" id="lbPrev" aria-label="Previous image">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none"
         stroke="currentColor" stroke-width="1.6">
      <polyline points="15 18 9 12 15 6"/>
    </svg>
  </button>
  <!-- Image stage (the draggable/zoomable area) -->
  <div class="lb-stage" id="lbStage">
    <img class="lb-img" id="lbImg" src="" alt="Product image" draggable="false">
  </div>
  <!-- Next arrow -->
  <button class="lb-arrow lb-arrow--next" id="lbNext" aria-label="Next image">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none"
         stroke="currentColor" stroke-width="1.6">
      <polyline points="9 18 15 12 9 6"/>
    </svg>
  </button>
  <!-- Dot indicators -->
  <div class="lb-dots" id="lbDots" aria-label="Image navigation"></div>
  <!-- Zoom controls (bottom right) -->
  <div class="lb-zoom-controls">
    <button class="lb-zoom-btn" id="lbZoomIn"  aria-label="Zoom in">+</button>
    <button class="lb-zoom-btn" id="lbZoomOut" aria-label="Zoom out">−</button>
    <button class="lb-zoom-btn lb-zoom-reset" id="lbZoomReset" aria-label="Reset zoom">⊡</button>
  </div>
</div>

</body>
</html>

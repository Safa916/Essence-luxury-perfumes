<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password — Essence</title>
    <link rel="stylesheet" href="/user/auth/reset-password.css">
</head>
<body>

    <div class="reset-container">

        <a href="/user/login" class="close-btn" aria-label="Close">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </a>

        <!-- Left Panel: Brand Hero -->
        <div class="hero-panel">
            <div class="hero-overlay"></div>
            <!-- Replace with your product photo via CSS background-image -->
        </div>

        <!-- Right Panel: Reset Form -->
        <div class="form-panel">
            <div class="reset-form-wrapper">
                <h2 class="form-title">Reset<br>Password</h2>
                <p class="form-subtitle">Enter your email to receive a password reset code.</p>

                <form class="reset-form" action="/user/forgot-password" method="POST">
                    <div class="form-group">
                        <label class="form-label" for="email">Email Address</label>
                        <input type="email" id="email" name="email" class="form-input" placeholder="athlete@bootcamp.com" required>
                    </div>

                    <button type="submit" class="submit-btn">Send Reset Code</button>
                </form>

                <a href="/user/login" class="back-link">Back to Login</a>
            </div>
        </div>

    </div>

</body>
</html>

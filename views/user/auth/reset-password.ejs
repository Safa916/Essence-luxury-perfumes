<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password — Essence</title>
    <link rel="stylesheet" href="/user/auth/reset-password.css">
</head>
<body>

    <div class="reset-container">

        <a href="/auth/login" class="close-btn" aria-label="Close">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </a>

        <!-- Left Panel: Brand Hero -->
        <div class="hero-panel">
            <div class="hero-overlay"></div>
        </div>

        <!-- Right Panel: Reset Form -->
        <div class="form-panel">
            <div class="reset-form-wrapper">

                <!-- Custom toast (replaces alert()) -->
                <div id="info-toast" class="info-toast" role="status">
                    <span id="info-toast-message"></span>
                    <button type="button" class="info-toast-close" onclick="hideInfoToast()">&times;</button>
                </div>

                <h2 class="form-title">Reset<br>Password</h2>
                <p class="form-subtitle">Enter the email address of the account you want to reset. We'll send a code to it.</p>

                <form class="reset-form" id="resetForm" novalidate>
                    <div class="form-group">
                        <label class="form-label" for="email">Email Address</label>
                        <input type="email" id="email" name="email" class="form-input" placeholder="athlete@bootcamp.com" required>
                    </div>

                    <button type="submit" class="submit-btn">Send Reset Code</button>
                </form>

                <a href="/auth/login" class="back-link">Back to Login</a>
            </div>
        </div>

    </div>

    <script>
        // ===== Custom toast (replaces alert()) =====
        function showInfoToast(message) {
            const toast = document.getElementById('info-toast');
            const msgEl = document.getElementById('info-toast-message');
            msgEl.textContent = message;
            toast.classList.add('show');
        }

        function hideInfoToast() {
            document.getElementById('info-toast').classList.remove('show');
        }

        const resetForm = document.getElementById('resetForm');
        const submitBtn = document.querySelector('.submit-btn');
        const originalBtnText = submitBtn.textContent;

        resetForm.addEventListener('submit', async function (e) {
            e.preventDefault();

            if (submitBtn.disabled) return;

            const email = document.getElementById('email').value;

            submitBtn.disabled = true;
            submitBtn.textContent = 'Sending...';

            try {
                const res = await fetch('/auth/forgot-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email })
                });

                const data = await res.json();

                if (res.ok) {
                    showInfoToast(data.message || 'If this email is registered, a reset code has been sent');

                    setTimeout(function () {
                        window.location.href = '/auth/verify-otp-page?email=' + encodeURIComponent(email) + '&purpose=password_reset';
                    }, 2000);
                } else {
                    showInfoToast(data.message || 'Something went wrong');
                    submitBtn.disabled = false;
                    submitBtn.textContent = originalBtnText;
                }
            } catch (err) {
                console.error(err);
                showInfoToast('Something went wrong');
                submitBtn.disabled = false;
                submitBtn.textContent = originalBtnText;
            }
        });
    </script>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account — Essence</title>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <link rel="stylesheet" href="/user/auth/userSignup.css">
</head>
<body>

    <div class="signup-container">

        <!-- Left Panel: Brand Hero -->
        <div class="hero-panel">
            <div class="hero-overlay"></div>

            <div class="hero-content">
                <div class="hero-eyebrow">Essence</div>
                <h1 class="hero-title">Join the<br>Inner Circle</h1>
                <p class="hero-desc">Experience the invisible layer of luxury. Become a member to receive exclusive early access to our limited editions.</p>
                <div class="hero-divider"></div>
            </div>

            <div class="hero-footer">
                <div class="hero-collection-name">Maison de l'Or</div>
                <div class="hero-collection-sub">Élixir Luminuex</div>
            </div>
        </div>

        <!-- Right Panel: Signup Form -->
        <div class="form-panel">
            <div class="signup-form-wrapper">

                <!-- Custom toast (replaces alert()) -->
                <div id="error-toast" class="error-toast" role="alert">
                    <span id="error-toast-message"></span>
                    <button type="button" class="error-toast-close" onclick="hideErrorToast()">&times;</button>
                </div>

                <h2 class="form-title">Create Account</h2>
                <p class="form-subtitle">Enter your details to begin your journey with Essence.</p>

                <form class="signup-form" id="signupForm" novalidate>
                    <div class="form-group">
                        <label class="form-label" for="fullName">Full Name</label>
                        <input type="text" id="fullName" name="fullName" class="form-input" placeholder="Alex Walker" >
                        <span class="field-error" id="fullName-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="email">Email Address</label>
                        <input type="email" id="email" name="email" class="form-input" placeholder="alex@essence.com" >
                        <span class="field-error" id="email-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="password">Password</label>
                        <div class="password-wrapper">
                            <input type="password" id="password" name="password" class="form-input" placeholder="••••••••" >
                            <button type="button" class="password-toggle" data-target="password" aria-label="Show password">
                                <svg class="eye-icon eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                <svg class="eye-icon eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="display:none"><path d="M3 3l18 18M10.6 10.6a3 3 0 004.24 4.24M9.9 4.24A10.94 10.94 0 0112 4c7 0 11 7 11 7a17.9 17.9 0 01-3.11 3.94M6.1 6.1A17.9 17.9 0 001 11s4 7 11 7c1.35 0 2.6-.24 3.72-.66"/></svg>
                            </button>
                        </div>
                        <span class="field-error" id="password-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="confirmPassword">Confirm Password</label>
                        <div class="password-wrapper">
                            <input type="password" id="confirmPassword" name="confirmPassword" class="form-input" placeholder="••••••••" >
                            <button type="button" class="password-toggle" data-target="confirmPassword" aria-label="Show password">
                                <svg class="eye-icon eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                <svg class="eye-icon eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="display:none"><path d="M3 3l18 18M10.6 10.6a3 3 0 004.24 4.24M9.9 4.24A10.94 10.94 0 0112 4c7 0 11 7 11 7a17.9 17.9 0 01-3.11 3.94M6.1 6.1A17.9 17.9 0 001 11s4 7 11 7c1.35 0 2.6-.24 3.72-.66"/></svg>
                            </button>
                        </div>
                        <span class="field-error" id="confirmPassword-error"></span>
                    </div>

                    <button type="submit" class="submit-btn">Create Account</button>
                </form>

                <div class="divider-row">
                    <span class="divider-line"></span>
                    <span class="divider-text">Or</span>
                    <span class="divider-line"></span>
                </div>

                <button type="button" class="google-btn">
                    <svg class="google-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="18" height="18">
                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.9-2.26 5.36-4.78 7.02l7.73 6c4.51-4.18 7.09-10.36 7.09-17.49z"/>
                        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                    </svg>
                    Google
                </button>

                <p class="signin-prompt">Already have an account? <a href="/auth/login" class="signin-link">Sign in</a></p>
            </div>
        </div>

    </div>

    <!-- Hidden container where Google's real button renders -->
    <div id="hiddenGoogleBtn" style="display: none;"></div>

    <script>
        // ===== Custom toast (replaces alert()) =====
        let toastTimeout;

        function showErrorToast(message) {
            const toast = document.getElementById('error-toast');
            const msgEl = document.getElementById('error-toast-message');
            msgEl.textContent = message;
            toast.classList.add('show');

            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(hideErrorToast, 5000);
        }

        function hideErrorToast() {
            document.getElementById('error-toast').classList.remove('show');
        }

        // ===== Per-field inline errors =====
        function setFieldError(fieldId, message) {
            const errorEl = document.getElementById(fieldId + '-error');
            const inputEl = document.getElementById(fieldId);
            errorEl.textContent = message;
            inputEl.classList.add('input-invalid');
        }

        function clearFieldError(fieldId) {
            const errorEl = document.getElementById(fieldId + '-error');
            const inputEl = document.getElementById(fieldId);
            errorEl.textContent = '';
            inputEl.classList.remove('input-invalid');
        }

        // ===== Password show/hide toggle =====
        document.querySelectorAll('.password-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const input = document.getElementById(btn.dataset.target);
                const openIcon = btn.querySelector('.eye-open');
                const closedIcon = btn.querySelector('.eye-closed');
                const isPassword = input.type === 'password';

                input.type = isPassword ? 'text' : 'password';
                openIcon.style.display = isPassword ? 'none' : 'block';
                closedIcon.style.display = isPassword ? 'block' : 'none';
                btn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
            });
        });

                // ===== Live validation (clears errors as you type) =====
        const nameRegex = /^[A-Za-z]+([ '-][A-Za-z]+)*$/;
        const emailRegex = /^\S+@\S+\.\S+$/;
        const passwordRegex = /^(?=.*[A-Za-z])(?=.*\d).{8,}$/;

        function validateField(fieldId) {
            const value = document.getElementById(fieldId).value;

            if (fieldId === 'fullName') {
                if (value.trim() === '' || nameRegex.test(value.trim())) {
                    clearFieldError('fullName');
                } else {
                    setFieldError('fullName', 'Please enter a valid full name (letters only)');
                }
            }

            if (fieldId === 'email') {
                if (value.trim() === '' || emailRegex.test(value.trim())) {
                    clearFieldError('email');
                } else {
                    setFieldError('email', 'Please enter a valid email address');
                }
            }

            if (fieldId === 'password') {
                if (value === '' || passwordRegex.test(value)) {
                    clearFieldError('password');
                } else {
                    setFieldError('password', 'Must be at least 8 characters with a letter and a number');
                }
                // Password changed, so also re-check confirm password
                if (document.getElementById('confirmPassword').value !== '') {
                    validateField('confirmPassword');
                }
            }

            if (fieldId === 'confirmPassword') {
                const password = document.getElementById('password').value;
                if (value === '' || value === password) {
                    clearFieldError('confirmPassword');
                } else {
                    setFieldError('confirmPassword', 'Passwords do not match');
                }
            }
        }

        // Attach the live check to all 4 fields
        ['fullName', 'email', 'password', 'confirmPassword'].forEach(function (fieldId) {
            document.getElementById(fieldId).addEventListener('input', function () {
                validateField(fieldId);
            });
        });





        // ===== Regular email/password signup =====
        const signupForm = document.getElementById('signupForm');
        const submitBtn = document.querySelector('.submit-btn');
        const originalBtnText = submitBtn.textContent;

        signupForm.addEventListener('submit', async function (e) {
            e.preventDefault();

            if (submitBtn.disabled) return;

            const fullName = document.getElementById('fullName').value;
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;

            // Clear any previous inline errors before re-validating
            clearFieldError('fullName');
            clearFieldError('email');
            clearFieldError('password');
            clearFieldError('confirmPassword');

            // ===== Client-side validation (mirrors server-side rules) =====
            // Every field is checked independently so the user sees ALL problems
            // at once, not just the first one that fails.
            const nameRegex = /^[A-Za-z]+([ '-][A-Za-z]+)*$/;
            const emailRegex = /^\S+@\S+\.\S+$/;
            const passwordRegex = /^(?=.*[A-Za-z])(?=.*\d).{8,}$/;
            let hasError = false;

            if (!nameRegex.test(fullName.trim())) {
                setFieldError('fullName', 'Please enter a valid full name (letters only)');
                hasError = true;
            }

            if (!emailRegex.test(email.trim())) {
                setFieldError('email', 'Please enter a valid email address');
                hasError = true;
            }

            if (!passwordRegex.test(password)) {
                setFieldError('password', 'Must be at least 8 characters with a letter and a number');
                hasError = true;
            }

            if (confirmPassword !== password) {
                setFieldError('confirmPassword', 'Passwords do not match');
                hasError = true;
            }

            if (hasError) return;

            submitBtn.disabled = true;
            submitBtn.textContent = 'Creating Account...';

            try {
                const res = await fetch('/auth/signup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ fullName, email, password, confirmPassword })
                });

                const data = await res.json();

                if (res.ok) {
                    // Success — navigating away, so no need to re-enable the button.
                    window.location.href = '/auth/verify-otp-page?email=' + encodeURIComponent(email);
                    return;
                } else {
                    showErrorToast(data.message || 'Signup failed');
                    submitBtn.disabled = false;
                    submitBtn.textContent = originalBtnText;
                }
            } catch (err) {
                console.error(err);
                showErrorToast('Something went wrong during signup');
                submitBtn.disabled = false;
                submitBtn.textContent = originalBtnText;
            }
        });

        // ===== Google Sign-In =====
        window.onload = function () {
            google.accounts.id.initialize({
                client_id: '62999911980-oanmmfdvrergnvrjdvic0i6pvojp3jad.apps.googleusercontent.com',
                callback: handleGoogleSignIn
            });

            google.accounts.id.renderButton(
                document.getElementById('hiddenGoogleBtn'),
                { theme: 'outline', size: 'large' }
            );
        };

        document.querySelector('.google-btn').addEventListener('click', function () {
            const googleButton = document.querySelector('#hiddenGoogleBtn div[role="button"]');
            if (googleButton) {
                googleButton.click();
            }
        });

        async function handleGoogleSignIn(response) {
            try {
                const res = await fetch('/auth/google', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ idToken: response.credential })
                });

                const data = await res.json();

                if (res.ok) {
                    localStorage.setItem('token', data.token);
                    window.location.href = '/';
                } else {
                    showErrorToast(data.message || 'Google sign-in failed');
                }
            } catch (err) {
                console.error(err);
                showErrorToast('Something went wrong signing in with Google');
            }
        }
    </script>

</body>
</html>

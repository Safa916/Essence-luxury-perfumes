<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Email — Essence</title>
    <link rel="stylesheet" href="/user/auth/otp-verification.css">
</head>
<body>

    <div class="otp-container">

        <!-- Left Panel: Brand Hero -->
        <div class="hero-panel">
            <div class="hero-overlay"></div>

            <div class="hero-top">
                <div class="hero-brand">Essence</div>
            </div>

            <div class="hero-bottom">
                <h1 class="hero-title">The Art of Olfaction</h1>
                <p class="hero-desc">Enter the curated world of Ethereal Essence, where every scent tells a silent poem of luxury.</p>
            </div>
        </div>

        <!-- Right Panel: OTP Form -->
        <div class="form-panel">
            <div class="otp-form-wrapper">

                <!-- Custom toast (replaces alert()) -->
                <div id="info-toast" class="info-toast" role="status">
                    <span id="info-toast-message"></span>
                    <button type="button" class="info-toast-close" onclick="hideInfoToast()">&times;</button>
                </div>

                <h2 class="form-title">Verify Email</h2>
                <p class="form-subtitle">
                    An invitation code has been sent to
                    <span class="user-email" id="userEmail"><%= typeof email !== 'undefined' ? email : '' %></span>. Please authenticate to continue your journey.
                </p>

                <!--
                    Non-committal hint — shown only for password-reset flow.
                    Does NOT confirm or deny whether the email is registered;
                    just helps genuine users who mistyped or need to check spam.
                -->
                <% if (typeof purpose !== 'undefined' && purpose === 'password_reset') { %>
                    <p class="otp-hint">
                        Didn't get a code? Check your spam folder, confirm the email address is correct, or request a new code below.
                    </p>
                <% } %>

                <form class="otp-form" id="otpForm" novalidate>
                    <button type="submit" class="verify-btn">
                        Verify&amp;Continue
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </button>

                    <div class="otp-inputs">
                        <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" name="otp1" autocomplete="off">
                        <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" name="otp2" autocomplete="off">
                        <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" name="otp3" autocomplete="off">
                        <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" name="otp4" autocomplete="off">
                        <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" name="otp5" autocomplete="off">
                        <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" name="otp6" autocomplete="off">
                    </div>
                </form>

                <p class="resend-prompt">
                    Awaiting your code?<br>
                    <button type="button" class="resend-btn" id="resendBtn">Resend</button>
                    <span class="resend-timer" id="resendTimer">00:56</span>
                </p>

                <div class="otp-divider"></div>

                <% if (typeof purpose !== 'undefined' && purpose === 'password_reset') { %>
                    <a href="/auth/forgot-password" class="change-email-link">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="19" y1="12" x2="5" y2="12"></line>
                            <polyline points="12 19 5 12 12 5"></polyline>
                        </svg>
                        Change Email
                    </a>
                <% } else { %>
                    <a href="/auth/signup" class="change-email-link">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="19" y1="12" x2="5" y2="12"></line>
                            <polyline points="12 19 5 12 12 5"></polyline>
                        </svg>
                        Change Email
                    </a>
                <% } %>
            </div>
        </div>

    </div>

    <script>
        window.addEventListener('pageshow', function (event) {
    if (event.persisted) {
        // Page was restored from bfcache (e.g. via back button) — force a fresh reload
        window.location.reload();
    }
});
        // ===== Custom toast (replaces alert()) =====
        function showInfoToast(message) {
            const toast = document.getElementById('info-toast');
            const msgEl = document.getElementById('info-toast-message');
            msgEl.textContent = message;
            toast.classList.add('show');
        }

        function hideInfoToast() {
            document.getElementById('info-toast').classList.remove('show');
        }

        const purpose = "<%= typeof purpose !== 'undefined' ? purpose : 'registration' %>";
        const urlParams = new URLSearchParams(window.location.search);
        const userEmail = "<%= typeof email !== 'undefined' ? email : '' %>" || urlParams.get('email') || '';
        document.getElementById('userEmail').textContent = userEmail;

        // Auto-advance between OTP boxes
        const digits = document.querySelectorAll('.otp-digit');
        digits.forEach(function (input, index) {
            input.addEventListener('input', function () {
                this.value = this.value.replace(/[^0-9]/g, '');
                if (this.value && index < digits.length - 1) {
                    digits[index + 1].focus();
                }
            });
            input.addEventListener('keydown', function (e) {
                if (e.key === 'Backspace' && !this.value && index > 0) {
                    digits[index - 1].focus();
                }
            });
        });

        // Countdown timer for Resend button
// Countdown timer for Resend button
const resendBtn = document.getElementById('resendBtn');
const timerEl = document.getElementById('resendTimer');
let interval;
let endTime;

const timerStorageKey = 'otpTimerEnd_' + purpose + '_' + userEmail;

function startCountdown(forceNew) {
    if (interval) clearInterval(interval);

    const saved = sessionStorage.getItem(timerStorageKey);

    if (!forceNew && saved && parseInt(saved, 10) > Date.now()) {
        // Resume existing countdown (e.g. after a refresh)
        endTime = parseInt(saved, 10);
    } else {
        // Fresh countdown (first load, or after a real Resend click)
        endTime = Date.now() + 56 * 1000;
        sessionStorage.setItem(timerStorageKey, endTime);
    }

    resendBtn.disabled = true;
    resendBtn.classList.remove('active');
    timerEl.style.display = 'inline';

    interval = setInterval(updateTimerDisplay, 250);
    updateTimerDisplay();
}

function updateTimerDisplay() {
    const remainingMs = endTime - Date.now();
    const remainingSeconds = Math.max(0, Math.ceil(remainingMs / 1000));

    if (remainingSeconds <= 0) {
        clearInterval(interval);
        timerEl.textContent = '';
        resendBtn.disabled = false;
        resendBtn.classList.add('active');
        sessionStorage.removeItem(timerStorageKey);
        return;
    }

    const m = String(Math.floor(remainingSeconds / 60)).padStart(2, '0');
    const s = String(remainingSeconds % 60).padStart(2, '0');
    timerEl.textContent = m + ':' + s;
}

startCountdown(); // resumes if a valid saved timer exists

        // Submit OTP for verification
        document.getElementById('otpForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const otp = Array.from(digits).map(d => d.value).join('');

            if (otp.length !== 6) {
                showInfoToast('Please enter all 6 digits');
                return;
            }

            const endpoint = purpose === 'password_reset' ? '/auth/verify-reset-code' : '/auth/verify-otp';

            try {
                const res = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: userEmail, otp })
                });

                const data = await res.json();

                if (res.ok) {
                    if (purpose === 'password_reset') {
                        window.location.href = '/auth/new-password?email=' + encodeURIComponent(userEmail) + '&otp=' + otp;
                    } else {
                        window.location.href = '/';
                    }
                } else {
                    showInfoToast(data.message || 'Verification failed');
                }
            } catch (err) {
                console.error(err);
                showInfoToast('Something went wrong verifying your OTP');
            }
        });

        // Resend OTP
        resendBtn.addEventListener('click', async function () {
            if (resendBtn.disabled) return;

            const resendEndpoint = purpose === 'password_reset' ? '/auth/forgot-password' : '/auth/resend-otp';

            try {
                const res = await fetch(resendEndpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: userEmail })
                });

                const data = await res.json();

                if (res.ok) {
                    digits.forEach(d => d.value = '');
                    digits[0].focus();
                    startCountdown();
                    showInfoToast(data.message || 'A new code has been sent');
                } else {
                    showInfoToast(data.message || 'Could not resend code');
                }
            } catch (err) {
                console.error(err);
                showInfoToast('Something went wrong resending the code');
            }
        });
    </script>

</body>
</html>

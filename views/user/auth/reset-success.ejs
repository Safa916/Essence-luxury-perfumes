<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Reset Successful — Essence</title>
    <link rel="stylesheet" href="/user/auth/reset-success.css">
</head>
<body>

    <div class="success-container">

        <!-- Left Panel: Brand Hero -->
        <div class="hero-panel">
            <!-- Replace with your product photo via CSS background-image -->
        </div>

        <!-- Right Panel: Success Message -->
        <div class="form-panel">
            <div class="success-wrapper">
                <div class="success-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>

                <h2 class="success-title">Password Reset<br>Successful</h2>
                <p class="success-subtitle">Your password has been updated. You can now log in to your account with your new credentials.</p>

                <a href="/user/login" class="back-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    Back to Login
                </a>
            </div>
        </div>

    </div>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Set New Password — Essence</title>
    <link rel="stylesheet" href="/user/auth/new-password.css">
    <style>
        /* Reuse this block in new-password.css instead if you prefer keeping styles out of the template */
        .info-toast {
            position: fixed;
            top: 24px;
            right: 24px;
            background: #1a1a1a;
            color: #fff;
            padding: 14px 20px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 16px;
            transform: translateY(-20px);
            opacity: 0;
            pointer-events: none;
            transition: all 0.25s ease;
            z-index: 1000;
            font-size: 14px;
            max-width: 360px;
        }
        .info-toast.show {
            transform: translateY(0);
            opacity: 1;
            pointer-events: auto;
        }
        .info-toast.error { background: #7a2020; }
        .info-toast-close {
            background: none;
            border: none;
            color: #fff;
            font-size: 18px;
            cursor: pointer;
            line-height: 1;
        }
        .password-requirements {
            margin: 10px 0 4px;
            padding: 12px 14px;
            background: rgba(0,0,0,0.03);
            border-radius: 8px;
            font-size: 13px;
            max-height: 0;
            opacity: 0;
            overflow: hidden;
            padding-top: 0;
            padding-bottom: 0;
            transition: max-height 0.25s ease, opacity 0.25s ease, padding 0.25s ease;
        }
        .password-requirements.visible {
            max-height: 120px;
            opacity: 1;
            padding-top: 12px;
            padding-bottom: 12px;
        }
        .password-requirements ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .password-requirements li {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 3px 0;
            color: #888;
            transition: color 0.15s ease;
        }
        .password-requirements li.met {
            color: #2f7a3d;
        }
        .password-requirements li .icon {
            width: 14px;
            height: 14px;
            flex-shrink: 0;
        }
        .form-input.invalid {
            border-color: #a33 !important;
        }
    </style>
</head>
<body>

    <div class="newpass-container">

        <!-- Left Panel: Brand Hero -->
        <div class="hero-panel">
        </div>

        <!-- Right Panel: New Password Form -->
        <div class="form-panel">
            <div class="newpass-form-wrapper">

                <!-- Custom toast (replaces alert()) -->
                <div id="info-toast" class="info-toast" role="status">
                    <span id="info-toast-message"></span>
                    <button type="button" class="info-toast-close" onclick="hideInfoToast()">&times;</button>
                </div>

                <h2 class="form-title">Set New<br>Password</h2>
                <p class="form-subtitle">Choose a secure password to protect your performance data.</p>

                <form class="newpass-form" id="newPasswordForm" novalidate>
                    <div class="form-group">
                        <label class="form-label" for="newPassword">New Password</label>
                        <div class="input-with-icon">
                            <input type="password" id="newPassword" name="newPassword" class="form-input" placeholder="••••••••" required>
                            <button type="button" class="toggle-visibility" data-target="newPassword" aria-label="Show password">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            </button>
                        </div>

                        <!-- Live password requirements checklist -->
                        <div class="password-requirements" id="pwRequirements">
                            <ul>
                                <li id="req-length">
                                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    At least 8 characters
                                </li>
                                <li id="req-letter">
                                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    Includes at least one letter (a–z)
                                </li>
                                <li id="req-number">
                                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    Includes at least one number (0–9)
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="confirmPassword">Confirm Password</label>
                        <div class="input-with-icon">
                            <input type="password" id="confirmPassword" name="confirmPassword" class="form-input" placeholder="••••••••" required>
                            <button type="button" class="toggle-visibility" data-target="confirmPassword" aria-label="Show password">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="submit-btn">
                        Reset Password
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </button>
                </form>

                <div class="newpass-divider"></div>

                <a href="/auth/login" class="back-link">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    Back to Login
                </a>
            </div>
        </div>

    </div>

    <script>
        // Force a fresh reload if this page is restored from the browser's
        // back-forward cache (e.g. via Back button) — prevents a stale form
        // with an already-used OTP from lingering on screen.
        window.addEventListener('pageshow', function (event) {
            if (event.persisted) {
                window.location.reload();
            }
        });

        // ===== Custom toast (replaces alert()) =====
        function showInfoToast(message, isError) {
            const toast = document.getElementById('info-toast');
            const msgEl = document.getElementById('info-toast-message');
            msgEl.textContent = message;
            toast.classList.toggle('error', !!isError);
            toast.classList.add('show');
        }

        function hideInfoToast() {
            document.getElementById('info-toast').classList.remove('show');
        }

        // Toggle password visibility on eye icon click
        document.querySelectorAll('.toggle-visibility').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(this.dataset.target);
                var isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                this.classList.toggle('active', isPassword);
            });
        });

        // ===== Live password requirements checklist =====
        // Mirrors backend rule: /^(?=.*[A-Za-z])(?=.*\d).{8,}$/
        const newPasswordInput = document.getElementById('newPassword');
        const reqLength = document.getElementById('req-length');
        const reqLetter = document.getElementById('req-letter');
        const reqNumber = document.getElementById('req-number');

        const pwRequirementsBox = document.getElementById('pwRequirements');

        function checkPasswordRequirements(password) {
            const hasLength = password.length >= 8;
            const hasLetter = /[A-Za-z]/.test(password);
            const hasNumber = /\d/.test(password);

            reqLength.classList.toggle('met', hasLength);
            reqLetter.classList.toggle('met', hasLetter);
            reqNumber.classList.toggle('met', hasNumber);

            return hasLength && hasLetter && hasNumber;
        }

        newPasswordInput.addEventListener('input', function () {
            checkPasswordRequirements(this.value);
        });

        // Show checklist only once the user starts interacting with this field
        newPasswordInput.addEventListener('focus', function () {
            pwRequirementsBox.classList.add('visible');
        });

        // Hide it again on blur, but only if all requirements are already met —
        // if not met, keep it visible so the user still sees what's missing
        newPasswordInput.addEventListener('blur', function () {
            const allMet = checkPasswordRequirements(this.value);
            if (allMet) {
                pwRequirementsBox.classList.remove('visible');
            }
        });

        // Submit new password
        document.getElementById('newPasswordForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const newPasswordField = document.getElementById('newPassword');
            const confirmField = document.getElementById('confirmPassword');
            const newPassword = newPasswordField.value;
            const confirmNewPassword = confirmField.value;
            const email = "<%= typeof email !== 'undefined' ? email : '' %>";
            const otp = "<%= typeof otp !== 'undefined' ? otp : '' %>";

            newPasswordField.classList.remove('invalid');
            confirmField.classList.remove('invalid');

            const meetsRequirements = checkPasswordRequirements(newPassword);
            if (!meetsRequirements) {
                newPasswordField.classList.add('invalid');
                showInfoToast('Password must be at least 8 characters and include a letter and a number', true);
                return;
            }

            if (newPassword !== confirmNewPassword) {
                confirmField.classList.add('invalid');
                showInfoToast('Passwords do not match', true);
                return;
            }

            const submitBtn = document.querySelector('.submit-btn');
            const originalText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.textContent = 'Resetting...';

            try {
                const res = await fetch('/auth/reset-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, otp, newPassword, confirmNewPassword })
                });

                const data = await res.json();

                if (res.ok) {
                    showInfoToast('Password reset successfully!');
                    setTimeout(function () {
                        window.location.href = '/auth/reset-success';
                    }, 1200);
                } else {
                    showInfoToast(data.message || 'Something went wrong', true);
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            } catch (err) {
                console.error(err);
                showInfoToast('Something went wrong resetting your password', true);
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        });
    </script>

</body>
</html>

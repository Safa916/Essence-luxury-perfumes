<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Houses — Essence' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/user/common.css">
  <link rel="stylesheet" href="/user/home/homepage.css">
  <style>
    .houses-container {
      max-width: var(--container);
      margin: 3rem auto 6rem;
      padding: 0 1.5rem;
    }
    .houses-header {
      text-align: center;
      margin-bottom: 4rem;
    }
    .houses-title-big {
      font-family: var(--font-display);
      font-size: 3rem;
      font-weight: 400;
      margin: 0.5rem 0;
      letter-spacing: 0.05em;
    }
    .houses-desc {
      color: var(--ink-soft);
      font-size: 1rem;
      max-width: 600px;
      margin: 0 auto;
    }
    .houses-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 2rem;
      margin-top: 3rem;
    }
    .house-card {
      background: var(--white);
      border: 1px solid var(--line);
      padding: 3rem 2rem;
      text-align: center;
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 250px;
    }
    .house-card:hover {
      border-color: var(--gold);
      transform: translateY(-5px);
    }
    .house-name {
      font-family: var(--font-display);
      font-size: 2rem;
      color: var(--ink);
      margin: 0 0 1rem;
    }
    .house-tagline {
      font-size: 0.9rem;
      color: var(--ink-soft);
      font-style: italic;
      line-height: 1.5;
      margin-bottom: 2rem;
    }
    .btn-explore {
      margin-top: auto;
      font-size: 0.7rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 400;
      border-bottom: 1px solid var(--gold);
      padding-bottom: 4px;
      align-self: center;
    }
  </style>
</head>
<body>

  <%- include('../partials/header', { activePage: 'brands', user: typeof user !== 'undefined' ? user : null, cartCount: typeof cartCount !== 'undefined' ? cartCount : 0 }) %>

  <main class="houses-container">
    <div class="houses-header">
      <p class="eyebrow">The Curators</p>
      <h1 class="houses-title-big">The Fragrance Houses</h1>
      <p class="houses-desc">We work directly with the world’s most prestigious fragrance houses, bringing you selected luxury scents of unparalleled craftsmanship.</p>
    </div>

    <div class="houses-grid">
      <% if (typeof brands !== 'undefined' && brands.length) { %>
        <% brands.forEach(function(brand) { %>
          <a href="/brands/<%= brand.slug %>" class="house-card">
            <div>
              <h2 class="house-name"><%= brand.name %></h2>
              <p class="house-tagline">“<%= brand.tagline || 'Exquisite quality and unique formulation.' %>”</p>
            </div>
            <span class="btn-explore">Explore House</span>
          </a>
        <% }); %>
      <% } else { %>
        <p style="grid-column: 1/-1; text-align: center; font-family: var(--font-display); font-size: 1.5rem; color: var(--ink-soft);">No houses found.</p>
      <% } %>
    </div>
  </main>

  <%- include('../partials/footer') %>

</body>
</html>

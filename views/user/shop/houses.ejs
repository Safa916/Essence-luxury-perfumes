<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Houses — Essence' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/user/home/homepage.css">
  <style>
    .houses-container {
      max-width: var(--container);
      margin: 3rem auto 6rem;
      padding: 0 1.5rem;
    }
    .houses-header {
      text-align: center;
      margin-bottom: 4rem;
    }
    .houses-title-big {
      font-family: var(--font-display);
      font-size: 3rem;
      font-weight: 400;
      margin: 0.5rem 0;
      letter-spacing: 0.05em;
    }
    .houses-desc {
      color: var(--ink-soft);
      font-size: 1rem;
      max-width: 600px;
      margin: 0 auto;
    }
    .houses-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 2rem;
      margin-top: 3rem;
    }
    .house-card {
      background: var(--white);
      border: 1px solid var(--line);
      padding: 3rem 2rem;
      text-align: center;
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 250px;
    }
    .house-card:hover {
      border-color: var(--gold);
      transform: translateY(-5px);
    }
    .house-name {
      font-family: var(--font-display);
      font-size: 2rem;
      color: var(--ink);
      margin: 0 0 1rem;
    }
    .house-tagline {
      font-size: 0.9rem;
      color: var(--ink-soft);
      font-style: italic;
      line-height: 1.5;
      margin-bottom: 2rem;
    }
    .btn-explore {
      margin-top: auto;
      font-size: 0.7rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 400;
      border-bottom: 1px solid var(--gold);
      padding-bottom: 4px;
      align-self: center;
    }
  </style>
</head>
<body>

  <!-- ===== Header ===== -->
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="logo">ESSENCE</a>
      <nav class="main-nav">
        <a href="/" class="nav-link">Home</a>
        <a href="/collections" class="nav-link">Collections</a>
        <a href="/houses" class="nav-link is-active">Houses</a>
        <a href="/about" class="nav-link">About</a>
      </nav>
      <div class="header-icons">
        <button class="icon-btn" aria-label="Search">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
        <a href="/cart" class="icon-btn" aria-label="Bag">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        </a>

        <% if (typeof user !== 'undefined' && user) { %>
          <div class="user-menu" style="display: inline-flex; align-items: center; gap: 10px;">
            <a href="/profile" class="icon-btn profile-btn" aria-label="My Profile">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
              <span class="profile-label" style="font-family: var(--font-body); font-size: 0.8rem; letter-spacing: 0.1em;"><%= user.fullName || 'Profile' %></span>
            </a>
            <form action="/auth/logout" method="POST" class="logout-form" style="display:inline;">
              <button type="submit" class="btn-logout" style="background: none; border: none; cursor: pointer; font-family: var(--font-body); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold);">Logout</button>
            </form>
          </div>
        <% } else { %>
          <a href="/auth/login" class="icon-btn" aria-label="Account">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
          </a>
          <a href="/auth/login" class="btn btn-login">Sign In</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="houses-container">
    <div class="houses-header">
      <p class="eyebrow">The Curators</p>
      <h1 class="houses-title-big">The Fragrance Houses</h1>
      <p class="houses-desc">We work directly with the world’s most prestigious fragrance houses, bringing you selected luxury scents of unparalleled craftsmanship.</p>
    </div>

    <div class="houses-grid">
      <% if (typeof brands !== 'undefined' && brands.length) { %>
        <% brands.forEach(function(brand) { %>
          <a href="/houses/<%= brand.slug %>" class="house-card">
            <div>
              <h2 class="house-name"><%= brand.name %></h2>
              <p class="house-tagline">“<%= brand.tagline || 'Exquisite quality and unique formulation.' %>”</p>
            </div>
            <span class="btn-explore">Explore House</span>
          </a>
        <% }); %>
      <% } else { %>
        <p style="grid-column: 1/-1; text-align: center; font-family: var(--font-display); font-size: 1.5rem; color: var(--ink-soft);">No houses found.</p>
      <% } %>
    </div>
  </main>

  <!-- ===== Footer ===== -->
  <footer class="site-footer">
    <div class="footer-columns">
      <div class="footer-brand">
        <p class="logo footer-logo">ESSENCE</p>
        <p class="footer-tagline">Fine fragrance, thoughtfully curated.</p>
      </div>
      <div class="footer-col">
        <h3>Shop</h3>
        <a href="/collections/for-her">For Her</a>
        <a href="/collections/for-him">For Him</a>
        <a href="/collections/new">New Arrivals</a>
        <a href="/houses">The Houses</a>
      </div>
      <div class="footer-col">
        <h3>Company</h3>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; <%= new Date().getFullYear() %> Essence. All rights reserved.</p>
    </div>
  </footer>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'My Orders — Essence' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/user/profile/user-profile.css">
  <style>
    .order-card {
      border: 1px solid var(--line);
      background: var(--white);
      padding: 1.5rem 2rem;
      margin-bottom: 2rem;
    }
    .order-card-header {
      display: flex;
      justify-content: space-between;
      border-bottom: 1px solid var(--line);
      padding-bottom: 1rem;
      margin-bottom: 1.5rem;
      font-size: 0.85rem;
      color: var(--ink-soft);
    }
    .order-id {
      font-weight: 500;
      color: var(--ink);
    }
    .order-card-body {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .order-product {
      display: flex;
      gap: 1.5rem;
      align-items: center;
    }
    .order-product-img {
      width: 60px;
      height: 60px;
      object-fit: contain;
      border: 1px solid var(--line);
      padding: 5px;
    }
    .order-product-name {
      font-family: var(--font-display);
      font-size: 1.35rem;
      margin: 0 0 0.25rem;
    }
    .order-product-desc {
      font-size: 0.8rem;
      color: var(--ink-soft);
      margin: 0;
    }
    .order-meta {
      text-align: right;
    }
    .order-total {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 500;
      margin-bottom: 0.5rem;
    }
    .order-status {
      display: inline-block;
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      background: #e8f5e9;
      color: #2e7d32;
      padding: 4px 10px;
    }
  </style>
</head>
<body>

  <!-- ===== Header ===== -->
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="logo">ESSENCE</a>
      <nav class="main-nav">
        <a href="/" class="nav-link">Home</a>
        <a href="/categories" class="nav-link">Categories</a>
        <a href="/brands" class="nav-link">Brands</a>
      </nav>
      <div class="header-icons">
        <button class="icon-btn" aria-label="Search">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
        <a href="/cart" class="icon-btn" aria-label="Bag">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        </a>
      </div>
    </div>
  </header>

  <div class="account-layout">
    <!-- ===== Sidebar ===== -->
    <aside class="account-sidebar">
      <p class="sidebar-label">Account</p>
      <nav class="sidebar-nav">
        <a href="/profile" class="sidebar-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
          Profile
        </a>
        <a href="/address" class="sidebar-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.3"/></svg>
          Address
        </a>
        <a href="/orders" class="sidebar-link is-active">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="7" width="16" height="13" rx="1"/><path d="M8 7V5a4 4 0 0 1 8 0v2"/></svg>
          My Orders
        </a>
        <a href="/wallet" class="sidebar-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="13" rx.1.5/><path d="M16 12.5h2.5"/><path d="M3 9.5h18"/></svg>
          Wallet
        </a>
      </nav>
    </aside>

    <!-- ===== Main ===== -->
    <main class="account-main">
      <p class="eyebrow">Purchase History</p>
      <h1 class="page-title" style="margin-bottom: 2rem;">My Orders</h1>

      <div class="orders-list">
        <article class="order-card">
          <div class="order-card-header">
            <div>
              <span>Placed: </span>
              <strong>June 29, 2026</strong>
            </div>
            <div>
              <span>Order ID: </span>
              <strong class="order-id">#ES-9830582</strong>
            </div>
          </div>
          <div class="order-card-body">
            <div class="order-product">
              <img src="/images/product-1.jpg" alt="Santal 33" class="order-product-img">
              <div>
                <h3 class="order-product-name">Santal 33</h3>
                <p class="order-product-desc">Le Labo — 100ml Eau de Parfum</p>
              </div>
            </div>
            <div class="order-meta">
              <div class="order-total">$245.00</div>
              <div class="order-status">Delivered</div>
            </div>
          </div>
        </article>
      </div>
    </main>
  </div>

</body>
</html>

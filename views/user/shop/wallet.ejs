<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'My Wallet — Essence' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/user/profile/user-profile.css">
  <style>
    .wallet-card-luxury {
      background: var(--ink);
      color: var(--cream);
      padding: 3rem;
      border: 1px solid var(--gold);
      margin-bottom: 3rem;
      text-align: center;
    }
    .wallet-balance-label {
      font-size: 0.8rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 1rem;
    }
    .wallet-balance-amount {
      font-family: var(--font-display);
      font-size: 3.5rem;
      font-weight: 400;
    }
    .transaction-list {
      margin-top: 2rem;
    }
    .transaction-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--line);
      padding: 1.5rem 0;
    }
    .transaction-info h3 {
      font-size: 1rem;
      font-weight: 500;
      margin: 0 0 0.25rem;
    }
    .transaction-info p {
      font-size: 0.8rem;
      color: var(--ink-soft);
      margin: 0;
    }
    .transaction-amount {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 500;
    }
    .amount-credit {
      color: #2e7d32;
    }
    .amount-debit {
      color: var(--ink);
    }
  </style>
</head>
<body>

  <!-- ===== Header ===== -->
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="logo">ESSENCE</a>
      <nav class="main-nav">
        <a href="/" class="nav-link">Home</a>
        <a href="/categories" class="nav-link">Categories</a>
        <a href="/brands" class="nav-link">Brands</a>
      </nav>
      <div class="header-icons">
        <button class="icon-btn" aria-label="Search">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
        <a href="/cart" class="icon-btn" aria-label="Bag">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        </a>
      </div>
    </div>
  </header>

  <div class="account-layout">
    <!-- ===== Sidebar ===== -->
    <aside class="account-sidebar">
      <p class="sidebar-label">Account</p>
      <nav class="sidebar-nav">
        <a href="/profile" class="sidebar-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
          Profile
        </a>
        <a href="/address" class="sidebar-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.3"/></svg>
          Address
        </a>
        <a href="/orders" class="sidebar-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="7" width="16" height="13" rx="1"/><path d="M8 7V5a4 4 0 0 1 8 0v2"/></svg>
          My Orders
        </a>
        <a href="/wallet" class="sidebar-link is-active">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="13" rx="1.5"/><path d="M16 12.5h2.5"/><path d="M3 9.5h18"/></svg>
          Wallet
        </a>
      </nav>
    </aside>

    <!-- ===== Main ===== -->
    <main class="account-main">
      <p class="eyebrow">Financial overview</p>
      <h1 class="page-title" style="margin-bottom: 2rem;">My Wallet</h1>

      <div class="wallet-card-luxury">
        <div class="wallet-balance-label">Available Balance</div>
        <div class="wallet-balance-amount">$150.00</div>
      </div>

      <section class="transactions-section">
        <h2 class="section-title">Recent Transactions</h2>
        <div class="transaction-list">
          <div class="transaction-item">
            <div class="transaction-info">
              <h3>Referral Credit</h3>
              <p>July 18, 2026</p>
            </div>
            <div class="transaction-amount amount-credit">+$50.00</div>
          </div>
          <div class="transaction-item">
            <div class="transaction-info">
              <h3>Santal 33 Purchase</h3>
              <p>June 29, 2026</p>
            </div>
            <div class="transaction-amount amount-debit">-$245.00</div>
          </div>
          <div class="transaction-item">
            <div class="transaction-info">
              <h3>Sign-up Welcome Bonus</h3>
              <p>June 28, 2026</p>
            </div>
            <div class="transaction-amount amount-credit">+$100.00</div>
          </div>
        </div>
      </section>
    </main>
  </div>

</body>
</html>

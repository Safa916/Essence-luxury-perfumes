<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Collections — Essence' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/user/common.css">
  <link rel="stylesheet" href="/user/home/homepage.css">
  <style>
    .collections-container {
      max-width: var(--container);
      margin: 3rem auto 6rem;
      padding: 0 1.5rem;
    }
    .collections-header {
      text-align: center;
      margin-bottom: 4rem;
    }
    .collections-title {
      font-family: var(--font-display);
      font-size: 3rem;
      font-weight: 400;
      margin: 0.5rem 0;
      letter-spacing: 0.05em;
    }
    .collections-desc {
      color: var(--ink-soft);
      font-size: 1rem;
      max-width: 600px;
      margin: 0 auto;
    }
    .grid-container {
      margin-top: 2rem;
    }
  </style>
</head>
<body>

  <%- include('../partials/header', { activePage: 'categories', user: typeof user !== 'undefined' ? user : null, cartCount: typeof cartCount !== 'undefined' ? cartCount : 0 }) %>

  <main class="collections-container">
    <div class="collections-header">
      <p class="eyebrow">The Fragrance Closet</p>
      <h1 class="collections-title">The Collections</h1>
      <p class="collections-desc">Discover our curated selection of high-end, artistic fragrances. Crafted by world-renowned perfume houses with selected premium essences.</p>
    </div>

    <div class="grid-container collections-grid-wrap" style="padding: 0; border: none;">
      <div class="product-grid">
        <% if (typeof products !== 'undefined' && products.length) { %>
          <% products.forEach(function(product) { %>
            <a href="/product/<%= product.slug %>" class="product-card">
              <div class="product-image">
                <img src="<%= product.images[0] %>" alt="<%= product.name %> by <%= product.house %>">
              </div>
              <p class="product-house"><%= product.house %></p>
              <p class="product-name"><%= product.name %></p>
              <p class="product-price">$<%= product.price %></p>
            </a>
          <% }); %>
        <% } else { %>
          <p style="grid-column: 1/-1; text-align: center; font-family: var(--font-display); font-size: 1.5rem; color: var(--ink-soft); margin-top: 3rem;">No products found in this collection.</p>
        <% } %>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>

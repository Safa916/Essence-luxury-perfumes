<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.name %> — Essence</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/user/home/homepage.css">
  <style>
    .product-container {
      max-width: var(--container);
      margin: 4rem auto 6rem;
      padding: 0 1.5rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
    @media (max-width: 768px) {
      .product-container {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
    }
    .product-gallery {
      background: var(--white);
      border: 1px solid var(--line);
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 2rem;
    }
    .product-gallery img {
      max-height: 500px;
      object-fit: contain;
    }
    .product-info-panel {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .product-house-label {
      font-size: 0.8rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 0.5rem;
    }
    .product-title-big {
      font-family: var(--font-display);
      font-size: 3rem;
      font-weight: 400;
      margin: 0 0 1.5rem;
      letter-spacing: 0.02em;
      line-height: 1.1;
    }
    .product-price-large {
      font-size: 1.8rem;
      font-weight: 400;
      color: var(--ink);
      margin-bottom: 2rem;
      font-family: var(--font-display);
    }
    .product-description {
      font-size: 0.95rem;
      line-height: 1.6;
      color: var(--ink-soft);
      margin-bottom: 2.5rem;
    }
    .variant-selector {
      margin-bottom: 2.5rem;
    }
    .variant-label {
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 0.75rem;
      display: block;
      color: var(--ink);
    }
    .variant-options {
      display: flex;
      gap: 1rem;
    }
    .variant-btn {
      border: 1px solid var(--line);
      padding: 0.75rem 1.5rem;
      font-family: var(--font-body);
      font-size: 0.8rem;
      background: transparent;
      cursor: pointer;
      transition: all 0.25s ease;
    }
    .variant-btn.is-active, .variant-btn:hover {
      border-color: var(--ink);
      background: var(--ink);
      color: var(--cream);
    }
    .action-row {
      display: flex;
      gap: 1rem;
    }
    .btn-add-bag {
      flex-grow: 1;
      text-align: center;
    }
    .btn-wishlist {
      border: 1px solid var(--line);
      background: transparent;
      padding: 0 1.25rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: border-color 0.25s ease;
    }
    .btn-wishlist:hover {
      border-color: var(--ink);
    }
  </style>
</head>
<body>

  <!-- ===== Header ===== -->
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="logo">ESSENCE</a>
      <nav class="main-nav">
        <a href="/" class="nav-link">Home</a>
        <a href="/collections" class="nav-link is-active">Collections</a>
        <a href="/houses" class="nav-link">Houses</a>
        <a href="/about" class="nav-link">About</a>
      </nav>
      <div class="header-icons">
        <button class="icon-btn" aria-label="Search">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
        <a href="/cart" class="icon-btn" aria-label="Bag">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        </a>

        <% if (typeof user !== 'undefined' && user) { %>
          <div class="user-menu" style="display: inline-flex; align-items: center; gap: 10px;">
            <a href="/profile" class="icon-btn profile-btn" aria-label="My Profile">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
              <span class="profile-label" style="font-family: var(--font-body); font-size: 0.8rem; letter-spacing: 0.1em;"><%= user.fullName || 'Profile' %></span>
            </a>
            <form action="/auth/logout" method="POST" class="logout-form" style="display:inline;">
              <button type="submit" class="btn-logout" style="background: none; border: none; cursor: pointer; font-family: var(--font-body); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold);">Logout</button>
            </form>
          </div>
        <% } else { %>
          <a href="/auth/login" class="icon-btn" aria-label="Account">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
          </a>
          <a href="/auth/login" class="btn btn-login">Sign In</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="product-container">
    <div class="product-gallery">
      <img src="<%= product.images && product.images.length ? product.images[0] : '/images/product-placeholder.jpg' %>" alt="<%= product.name %>">
    </div>

    <div class="product-info-panel">
      <span class="product-house-label"><%= brand.name %></span>
      <h1 class="product-title-big"><%= product.name %></h1>
      
      <div class="product-price-large" id="productPrice">
        $<%= variants && variants.length ? variants[0].price.toString() : '195.00' %>
      </div>

      <p class="product-description">
        <%= product.full_description || product.short_description || 'An exquisite fragrance that represents pure luxury.' %>
      </p>

      <% if (variants && variants.length) { %>
        <div class="variant-selector">
          <span class="variant-label">Select Size</span>
          <div class="variant-options">
            <% variants.forEach(function(variant, index) { %>
              <button type="button" 
                      class="variant-btn <%= index === 0 ? 'is-active' : '' %>" 
                      data-price="<%= variant.price.toString() %>"
                      onclick="selectVariant(this)">
                <%= variant.variant_name || (variant.size_ml + 'ml') %>
              </button>
            <% }); %>
          </div>
        </div>
      <% } %>

      <div class="action-row">
        <button class="btn btn-dark btn-add-bag" onclick="addToBag()">Add to Bag</button>
        <button class="btn-wishlist" aria-label="Add to Wishlist" onclick="addToWishlist()">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20.5s-7.5-4.6-10-9.3C.5 7.8 2.4 4.5 5.8 4c2-.3 3.9.6 5.2 2.4C12.3 4.6 14.2 3.7 16.2 4c3.4.5 5.3 3.8 3.8 7.2-2.5 4.7-10 9.3-10 9.3z"/></svg>
        </button>
      </div>
    </div>
  </main>

  <!-- ===== Footer ===== -->
  <footer class="site-footer">
    <div class="footer-columns">
      <div class="footer-brand">
        <p class="logo footer-logo">ESSENCE</p>
        <p class="footer-tagline">Fine fragrance, thoughtfully curated.</p>
      </div>
      <div class="footer-col">
        <h3>Shop</h3>
        <a href="/collections/for-her">For Her</a>
        <a href="/collections/for-him">For Him</a>
        <a href="/collections/new">New Arrivals</a>
        <a href="/houses">The Houses</a>
      </div>
      <div class="footer-col">
        <h3>Company</h3>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; <%= new Date().getFullYear() %> Essence. All rights reserved.</p>
    </div>
  </footer>

  <script>
    function selectVariant(btn) {
      document.querySelectorAll('.variant-btn').forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      document.getElementById('productPrice').textContent = '$' + btn.getAttribute('data-price');
    }

    function addToBag() {
      alert('Product added to your shopping bag.');
      window.location.href = '/cart';
    }

    function addToWishlist() {
      alert('Product added to your wishlist.');
      window.location.href = '/wishlist';
    }
  </script>

</body>
</html>

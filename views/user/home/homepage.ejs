<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Essence — Fine Fragrance' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/user/common.css">
  <link rel="stylesheet" href="/user/home/homepage.css">
</head>
<body>

  <%- include('../partials/header', { activePage: 'home', user: typeof user !== 'undefined' ? user : null }) %>

  <main>

    <!-- ===== Hero ===== -->
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">The Fragrance Journal</p>
        <blockquote class="hero-quote">
          &ldquo;A fragrance is a silent poem, an invisible layer of luxury that lingers long after a presence has faded.&rdquo;
        </blockquote>
        <a href="/shop" class="btn btn-dark">Explore the Fragrances</a>
      </div>
      <div class="hero-image">
        <img src="/user/images/hero-banner.jpg" alt="Essence Haute Parfumerie Collection">
      </div>
    </section>

    <!-- ===== For Her / For Him ===== -->
  <section class="split-banner">
    <a href="/categories" class="banner-card" aria-label="Browse Categories - For Her">
      <img src="<%= (categoryForHer && categoryForHer.banner_url) || '/user/images/for-her.jpg' %>" alt="Shop the For Her collection">
      <span class="banner-label">For Her</span>
    </a>
    <a href="/categories" class="banner-card" aria-label="Browse Categories - For Him">
      <img src="<%= (categoryForHim && categoryForHim.banner_url) || '/user/images/for-him.jpg' %>" alt="Shop the For Him collection">
      <span class="banner-label">For Him</span>
    </a>
  </section>

    <!-- ===== The Houses / Brands ===== -->
    <section class="houses">
      <h2 class="houses-title">The Houses</h2>
      <ul class="houses-list">
        <% if (typeof brands !== 'undefined' && brands.length) { %>
          <% brands.forEach(function(brand) { %>
            <li><a href="/brands/<%= brand.slug %>"><%= brand.name %></a></li>
          <% }); %>
        <% } else { %>
          <li><span style="color:#888; font-size:0.9rem;">No brands available</span></li>
        <% } %>
      </ul>
    </section>

  </main>

<!-- ===== Footer ===== -->
 <%- include('../partials/footer') %>

  <%- include('../partials/logout-modal') %>

</body>
</html>

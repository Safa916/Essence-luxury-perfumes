<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Return Product | Essence</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/user/common.css">
  <link rel="stylesheet" href="/user/orders/return-request.css">
</head>
<body>

  <%
    const o = (typeof order !== 'undefined' && order) ? order : {};
    const firstItem = (o.items && o.items[0]) || {};
    const hasError  = typeof query !== 'undefined' && query && query.error;

    const inr = (n) => '₹' + Number(n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 });

    const RETURN_REASONS = [
      'Incorrect Size',
      'Defective Product',
      "Don't Like the Style",
      'Wrong Item Received',
      'Other',
    ];
  %>

  <%- include('../partials/header', { activePage: 'orders', user: typeof user !== 'undefined' ? user : null }) %>

  <div class="account-layout">

    <%- include('../partials/account-sidebar', { activePage: 'orders' }) %>

    <main class="account-main return-main">

      <!-- Header -->
      <header class="return-head">
        <p class="eyebrow">Order #<%= o.orderId %></p>
        <h1 class="page-title">Return Product</h1>
        <p class="return-sub">Please select a reason for your return for order #<%= o.orderId %></p>
      </header>

      <!-- Error flash -->
      <% if (hasError && query.error === 'reason_required') { %>
        <div class="return-flash return-flash--error" role="alert">
          Please select a reason before submitting your return.
        </div>
      <% } else if (hasError && query.error === 'invalid_comments') { %>
        <div class="return-flash return-flash--error" role="alert">
          Additional comments can only contain letters and spaces. No numbers or special characters are allowed.
        </div>
      <% } else if (hasError && query.error === 'return_failed') { %>
        <div class="return-flash return-flash--error" role="alert">
          Something went wrong. Please try again.
        </div>
      <% } %>

      <form method="POST" action="/orders/<%= o._id %>/return<%= typeof itemId !== 'undefined' && itemId ? '?itemId=' + itemId : '' %>" class="return-form" id="returnForm">

        <div class="return-layout">

          <!-- LEFT: Product snapshot -->
          <div class="return-product-col">
            <% (o.items || []).forEach(function(it) { %>
              <div class="return-product-card">
                <div class="return-product-img">
                  <% if (it.image) { %>
                    <img src="<%= it.image %>" alt="<%= it.name %>">
                  <% } else { %>
                    <div class="return-img-placeholder">
                      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.2">
                        <rect x="3" y="3" width="18" height="18" rx="1"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <polyline points="21 15 16 10 5 21"/>
                      </svg>
                    </div>
                  <% } %>
                </div>
                <div class="return-product-info">
                  <h2 class="return-product-name"><%= it.name %></h2>
                  <% if (it.size) { %>
                    <p class="return-product-size">Size: <%= it.size %></p>
                  <% } %>
                  <p class="return-product-price"><%= inr(it.price) %></p>
                </div>
              </div>
            <% }); %>
          </div>

          <!-- RIGHT: Reason form -->
          <div class="return-form-col">

            <div class="return-section">
              <h3 class="return-section-title">Reason for Return</h3>
              <div class="return-reasons" id="returnReasons">
                <% RETURN_REASONS.forEach(function(reason, idx) { %>
                  <label class="return-reason-item" id="reason-label-<%= idx %>">
                    <input
                      type="radio"
                      name="return_reason"
                      value="<%= reason %>"
                      id="reason-<%= idx %>"
                      class="return-reason-radio"
                      required
                    >
                    <span class="return-reason-dot"></span>
                    <span class="return-reason-text"><%= reason.toUpperCase() %></span>
                  </label>
                <% }); %>
              </div>
            </div>

            <div class="return-section">
              <h3 class="return-section-title">Additional Comments <span class="optional">(Optional)</span></h3>
              <textarea
                name="comments"
                class="return-comments"
                id="returnComments"
                rows="3"
                maxlength="400"
                placeholder="Type here..."
              ></textarea>
            </div>

            <div class="return-actions">
              <button type="submit" class="btn btn-dark return-submit-btn" id="returnSubmitBtn">
                Initiate Return →
              </button>
              <a href="/orders/<%= o._id %>" class="btn return-back-btn">
                Back to Order
              </a>
            </div>

          </div>
        </div>

      </form>

    </main>
  </div>

  <%- include('../partials/footer') %>
  <%- include('../partials/logout-modal') %>

  <script>
    // Highlight selected radio card
    document.querySelectorAll('.return-reason-radio').forEach(function(radio) {
      radio.addEventListener('change', function() {
        document.querySelectorAll('.return-reason-item').forEach(function(l) {
          l.classList.remove('is-selected');
        });
        if (this.checked) this.closest('.return-reason-item').classList.add('is-selected');
      });
    });

    // Validate form before submission
    document.getElementById('returnForm').addEventListener('submit', function(e) {
      const selectedReason = document.querySelector('input[name="return_reason"]:checked');
      if (!selectedReason) {
        e.preventDefault();
        alert('Please select a reason for your return before submitting.');
        return;
      }
      
      const commentsInput = document.getElementById('returnComments').value;
      if (commentsInput.trim().length > 0) {
        // Regex allows only letters (a-z, A-Z) and spaces
        const textOnlyRegex = /^[A-Za-z\s]+$/;
        if (!textOnlyRegex.test(commentsInput)) {
          e.preventDefault();
          alert('Additional comments can only contain letters and spaces. No numbers or special characters are allowed.');
        }
      }
    });
  </script>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Order Details | Essence</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/user/common.css">
  <link rel="stylesheet" href="/user/orders/order-detail.css">
</head>
<body>

  <%
    const o    = (typeof order !== 'undefined' && order) ? order : {};
    const st   = o.status || 'placed';
    const addr = o.address || {};

    const inr = (n) => '₹' + Number(n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const dateStr = o.createdAt
      ? new Date(o.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })
      : '—';

    const stepIndex        = typeof o.stepIndex !== 'undefined' ? o.stepIndex : 0;
    const isCancelled       = o.isCancelled       || false;
    const isReturned        = o.isReturned         || false;
    const isReturnRequested = o.isReturnRequested  || false;
    const canCancel         = o.canCancel          || false;
    const canReturn         = o.canReturn          || false;
    const hasCancellableItems = (o.items || []).some(it => ['placed', 'processing'].includes(it.item_status || 'placed'));
    const canCancelAny      = canCancel || hasCancellableItems;
    const steps       = ['Order Placed', 'Shipped', 'Delivered'];
    const progress    = [0, 50, 100][stepIndex] || 0;
  %>

  <%- include('../partials/header', { activePage: 'orders' }) %>

  <div class="account-layout">

    <%- include('../partials/account-sidebar', { activePage: 'orders' }) %>

    <main class="account-main detail-main">

      <!-- Title + Download Invoice button -->
      <header class="detail-head">
        <a href="/orders" class="back-link">← Back to orders</a>
        <div class="detail-head-row">
          <div>
            <h1 class="page-title">Order Details</h1>
            <p class="detail-ref">Reference #<%= o.orderId %></p>
          </div>
          <div class="detail-head-actions">
            <% if (canCancel) { %>
              <button type="button" class="btn btn-cancel-order" id="openCancelOrderBtn">
                Cancel Order
              </button>
            <% } %>
            <!-- Invoice button: show for active orders (not cancelled) -->
            <% if (!isCancelled) { %>
              <a href="/orders/<%= o._id %>/invoice"
                 class="btn-invoice"
                 id="invoiceBtn"
                 target="_blank">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                Download Invoice
              </a>
            <% } %>
          </div>
        </div>
      </header>

      <!-- Flash banners (auto-dismiss in 4s + URL cleaned so refresh won't re-show) -->
      <% if (typeof query !== 'undefined' && query && query.cancelled) { %>
        <div class="detail-flash detail-flash--success js-flash" role="alert">
          ✦ Cancellation completed successfully.<% if (query.refunded) { %> Refund has been credited to your wallet.<% } %>
        </div>
      <% } %>
      <% if (typeof query !== 'undefined' && query && query.returned) { %>
        <div class="detail-flash detail-flash--success js-flash" role="alert">
          ✦ Return request submitted. Our team will process it within 2–3 business days.
        </div>
      <% } %>
      <% if (typeof query !== 'undefined' && query && query.error === 'reason_required') { %>
        <div class="detail-flash detail-flash--error js-flash" role="alert">
          Please select a cancellation reason before proceeding.
        </div>
      <% } else if (typeof query !== 'undefined' && query && query.error === 'comment_required') { %>
        <div class="detail-flash detail-flash--error js-flash" role="alert">
          Please enter at least 5 characters for your reason when selecting "Other".
        </div>
      <% } else if (typeof query !== 'undefined' && query && query.error === 'not_cancellable') { %>
        <div class="detail-flash detail-flash--error js-flash" role="alert">
          This order or item can no longer be cancelled (status: <%= o.status_label %>).
        </div>
      <% } else if (typeof query !== 'undefined' && query && query.error === 'cancel_failed') { %>
        <div class="detail-flash detail-flash--error js-flash" role="alert">
          Something went wrong while processing the cancellation. Please try again.
        </div>
      <% } %>

      <!-- Timeline / status banners -->
      <% if (isCancelled) { %>
        <div class="cancel-banner">
          <span class="status-dot"></span>
          <span>This order was cancelled.<% if (o.cancel_reason) { %> Reason: <em><%= o.cancel_reason %></em><% } %></span>
        </div>
      <% } else if (isReturned) { %>
        <div class="cancel-banner cancel-banner--returned">
          <span class="status-dot"></span>
          <span>This order has been returned.</span>
        </div>
      <% } else { %>
        <% if (isReturnRequested) { %>
          <div class="return-request-banner">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 12l4-4m-4 4 4 4"/></svg>
            Return request submitted — awaiting admin approval.
          </div>
        <% } %>
        <ol class="timeline" style="--progress: <%= progress %>%;">
          <% steps.forEach(function (label, i) { %>
            <li class="tl-step <%= i <= stepIndex ? 'done' : '' %> <%= i === stepIndex ? 'current' : '' %>">
              <span class="tl-dot">
                <% if (i <= stepIndex) { %>
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <% } %>
              </span>
              <span class="tl-label"><%= label %></span>
            </li>
          <% }) %>
        </ol>
      <% } %>

      <div class="detail-grid">

        <!-- LEFT: items -->
        <section class="shipment">
          <h2 class="section-title">Items In Shipment</h2>

          <% (o.items || []).forEach(function (it) { %>
            <article class="ship-item">
              <div class="ship-image">
                <% if (it.image) { %>
                  <img src="<%= it.image %>" alt="<%= it.name %>">
                <% } else { %>
                  <div class="ship-image-placeholder" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.2">
                      <rect x="3" y="3" width="18" height="18" rx="1"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <polyline points="21 15 16 10 5 21"/>
                    </svg>
                  </div>
                <% } %>
              </div>

              <div class="ship-info">
                <div class="ship-top">
                  <h3 class="ship-name"><%= it.name %></h3>
                  <span class="ship-price"><%= inr(it.total || it.price) %></span>
                </div>
                <p class="ship-meta">
                  <% if (it.size) { %><span>Size: <%= it.size %></span><% } %>
                  <span>Qty: <%= it.quantity %></span>
                  <span class="unit-price"><%= inr(it.price) %> each</span>
                </p>

                <div class="ship-actions">
                  <% 
                     const itemSt = it.item_status || 'placed';
                     const itemCanCancel = ['placed', 'processing'].includes(itemSt);
                     const itemReturnStatus = typeof o.returnMap !== 'undefined' ? (o.returnMap[it._id] || o.returnMap['ALL']) : null;
                     const itemIsReturnRequested = itemReturnStatus === 'requested';
                     const itemIsReturnRejected = itemReturnStatus === 'rejected';
                     const itemIsReturnProcessed = itemReturnStatus === 'refunded' || itemReturnStatus === 'approved';
                     const itemCanReturn = itemSt === 'delivered' && !itemReturnStatus;
                  %>
                  <% if (itemCanReturn) { %>
                    <a href="/orders/<%= o._id %>/return?itemId=<%= it._id %>" class="btn btn-small">Return Item</a>
                  <% } else if (itemSt === 'returned' || itemSt === 'cancelled' || itemIsReturnProcessed) { %>
                    <span class="btn btn-small is-disabled" aria-disabled="true" title="<%= (itemSt === 'returned' || itemIsReturnProcessed) ? 'Return completed' : 'Order was cancelled' %>">
                      <%= (itemSt === 'returned' || itemIsReturnProcessed) ? 'Returned' : 'Cancelled' %>
                    </span>
                  <% } else if (itemIsReturnRequested) { %>
                     <span class="btn btn-small is-disabled return-requested-btn" aria-disabled="true" title="Return request is pending">
                      Return Requested
                    </span>
                  <% } else if (itemIsReturnRejected) { %>
                     <span class="btn btn-small is-disabled" aria-disabled="true" title="Return request was rejected">
                      Return Rejected
                    </span>
                  <% } else { %>
                    <span class="btn btn-small is-disabled" aria-disabled="true" title="Available after delivery">
                      Return Item
                    </span>
                  <% } %>
                  <% if (itemCanCancel) { %>
                    <button type="button"
                            class="btn btn-small btn-danger cancel-item-btn"
                            data-item-id="<%= it._id %>"
                            data-item-name="<%= it.name %>">
                      Cancel Item
                    </button>
                  <% } %>
                  <% if (itemSt === 'cancelled' && (it.cancel_reason || o.cancel_reason)) { %>
                    <div class="item-cancel-reason-note">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                      <span>Reason: <strong><%= it.cancel_reason || o.cancel_reason %></strong></span>
                    </div>
                  <% } %>
                </div>
              </div>
            </article>
          <% }); %>
        </section>

        <!-- RIGHT: info cards -->
        <aside class="detail-side">

          <div class="info-card ship-to">
            <p class="card-label">Ship To</p>
            <p class="ship-to-name"><%= addr.fullName %></p>
            <p class="ship-to-text">
              <%= addr.line1 %><br>
              <% if (addr.line2) { %><%= addr.line2 %><br><% } %>
              <%= addr.state %> <%= addr.pincode %>
            </p>
          </div>

          <div class="info-card pay-card">
            <p class="card-label">Payment &amp; Date</p>
            <div class="kv"><span>Method</span><strong><%= o.paymentMethod %></strong></div>
            <div class="kv"><span>Order Date</span><strong><%= dateStr %></strong></div>
          </div>

          <div class="info-card summary-card">
            <p class="card-label">Summary</p>
            <div class="kv"><span>Subtotal</span><strong><%= inr(o.subtotal) %></strong></div>
            <div class="kv"><span>Shipping</span><strong><%= o.shipping ? inr(o.shipping) : 'Free' %></strong></div>
            <div class="kv"><span>Tax (GST)</span><strong><%= inr(o.tax) %></strong></div>
            <% if (o.discount) { %>
              <div class="kv"><span>Discount</span><strong>− <%= inr(o.discount) %></strong></div>
            <% } %>
            <div class="summary-total">
              <span>Total</span>
              <strong><%= inr(o.total) %></strong>
            </div>
          </div>

        </aside>
      </div>

    </main>
  </div>

  <%- include('../partials/footer') %>
  <%- include('../partials/logout-modal') %>

  <!-- ── Cancel Modal (Whole Order or Single Item) ─────────────────────── -->
  <% if (canCancelAny) { %>
  <dialog id="cancelModal" class="cancel-modal">
    <div class="cancel-modal-inner">
      <h2 class="cancel-modal-title" id="cancelModalTitle">Cancel this order?</h2>
      <p class="cancel-modal-sub" id="cancelModalSub">This action cannot be undone. Please select a reason for cancellation.</p>

      <div id="cancelItemPreview" class="cancel-item-preview" style="display:none;">
        <span class="cancel-item-preview-label">Item to cancel:</span>
        <strong id="cancelItemPreviewName"></strong>
      </div>

      <form method="POST" action="/orders/<%= o._id %>/cancel" id="cancelForm">
        <div class="cancel-reason-section">
          <label class="cancel-reason-label">Reason for cancellation <span class="required-star">*</span></label>
          <div class="cancel-reasons-list" id="cancelReasonsList">
            <% (o.cancellationReasons || [
              'Ordered by mistake',
              'Found a better price elsewhere',
              'Delayed delivery / Takes too long',
              'Need to change shipping address',
              'Need to change payment method',
              'Changed my mind / No longer needed',
              'Other'
            ]).forEach(function(reason, idx) { %>
              <label class="cancel-reason-item" id="cancelReasonItem-<%= idx %>">
                <input
                  type="radio"
                  name="cancel_reason"
                  value="<%= reason %>"
                  class="cancel-reason-radio"
                  id="cancelReason-<%= idx %>"
                  required
                >
                <span class="cancel-reason-dot"></span>
                <span class="cancel-reason-text"><%= reason %></span>
              </label>
            <% }); %>
          </div>
        </div>

        <div class="cancel-comment-field" id="cancelCommentField">
          <label for="cancelCommentInput" class="cancel-reason-label" id="cancelCommentLabel">
            Additional Comments <span class="optional" id="commentOptionalTag">(optional)</span>
          </label>
          <textarea
            id="cancelCommentInput"
            name="cancel_comment"
            class="cancel-reason-textarea"
            rows="2"
            maxlength="250"
            placeholder="Provide any additional details..."
          ></textarea>
          <div class="cancel-char-count"><span id="cancelCharCount">0</span> / 250</div>
        </div>

        <div class="modal-form-error" id="modalFormError" style="display:none;" role="alert"></div>

        <div class="cancel-modal-actions">
          <button type="button" class="btn btn-outline-modal" id="cancelModalCloseBtn">
            Keep Order
          </button>
          <button type="submit" class="btn btn-danger-modal" id="cancelSubmitBtn">
            Confirm Cancellation
          </button>
        </div>
      </form>
    </div>
  </dialog>
  <% } %>

  <script>
    // ── Auto-dismiss flash banners + clean URL so refresh won't re-show ──────
    const flashes = document.querySelectorAll('.js-flash');
    if (flashes.length) {
      history.replaceState(null, '', window.location.pathname);
      setTimeout(function() {
        flashes.forEach(function(el) {
          el.style.transition = 'opacity 0.5s ease';
          el.style.opacity = '0';
          setTimeout(function() { el.remove(); }, 520);
        });
      }, 4000);
    }

    // ── Cancellation modal management ──────────────────────────────────────────
    const cancelModal           = document.getElementById('cancelModal');
    const cancelForm            = document.getElementById('cancelForm');
    const cancelModalTitle      = document.getElementById('cancelModalTitle');
    const cancelModalSub        = document.getElementById('cancelModalSub');
    const cancelItemPreview     = document.getElementById('cancelItemPreview');
    const cancelItemPreviewName = document.getElementById('cancelItemPreviewName');
    const cancelModalCloseBtn   = document.getElementById('cancelModalCloseBtn');
    const cancelCommentInput    = document.getElementById('cancelCommentInput');
    const commentOptionalTag    = document.getElementById('commentOptionalTag');
    const cancelCharCount       = document.getElementById('cancelCharCount');
    const modalFormError        = document.getElementById('modalFormError');
    const cancelSubmitBtn       = document.getElementById('cancelSubmitBtn');

    function resetCancelModal() {
      if (!cancelForm) return;
      cancelForm.reset();
      document.querySelectorAll('.cancel-reason-item').forEach(function(l) {
        l.classList.remove('is-selected');
      });
      if (cancelCommentInput) {
        cancelCommentInput.required = false;
        cancelCommentInput.placeholder = 'Provide any additional details...';
      }
      if (commentOptionalTag) {
        commentOptionalTag.textContent = '(optional)';
        commentOptionalTag.style.color = '';
      }
      if (cancelCharCount) cancelCharCount.textContent = '0';
      if (modalFormError) {
        modalFormError.style.display = 'none';
        modalFormError.textContent = '';
      }
      if (cancelSubmitBtn) {
        cancelSubmitBtn.disabled = false;
        cancelSubmitBtn.textContent = 'Confirm Cancellation';
      }
    }

    // Cancel entire order button
    const openCancelOrderBtn = document.getElementById('openCancelOrderBtn');
    if (openCancelOrderBtn && cancelModal) {
      openCancelOrderBtn.addEventListener('click', function() {
        resetCancelModal();
        cancelForm.action = '/orders/<%= o._id %>/cancel';
        cancelModalTitle.textContent = 'Cancel Entire Order?';
        cancelModalSub.textContent = 'This action cannot be undone. All active items will be cancelled and restocked.';
        if (cancelItemPreview) cancelItemPreview.style.display = 'none';
        cancelModal.showModal();
      });
    }

    // Cancel individual item button
    document.querySelectorAll('.cancel-item-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        if (!cancelModal) return;
        resetCancelModal();
        const itemId = btn.dataset.itemId;
        const itemName = btn.dataset.itemName || 'this item';
        cancelForm.action = '/orders/<%= o._id %>/cancel?itemId=' + encodeURIComponent(itemId);
        cancelModalTitle.textContent = 'Cancel Item?';
        cancelModalSub.textContent = 'This action cannot be undone. Stock will be restored and payment refunded if prepaid.';
        if (cancelItemPreview && cancelItemPreviewName) {
          cancelItemPreviewName.textContent = itemName;
          cancelItemPreview.style.display = 'block';
        }
        cancelModal.showModal();
      });
    });

    if (cancelModalCloseBtn && cancelModal) {
      cancelModalCloseBtn.addEventListener('click', function() {
        cancelModal.close();
      });
    }

    if (cancelModal) {
      cancelModal.addEventListener('click', function(e) {
        if (e.target === cancelModal) cancelModal.close();
      });
    }

    // Highlight selected radio reason & toggle comments requirement
    document.querySelectorAll('.cancel-reason-radio').forEach(function(radio) {
      radio.addEventListener('change', function() {
        document.querySelectorAll('.cancel-reason-item').forEach(function(l) {
          l.classList.remove('is-selected');
        });
        if (this.checked) {
          this.closest('.cancel-reason-item').classList.add('is-selected');
        }
        if (modalFormError) modalFormError.style.display = 'none';

        if (this.value === 'Other') {
          if (cancelCommentInput) {
            cancelCommentInput.required = true;
            cancelCommentInput.placeholder = 'Please specify the exact reason (min 5 characters)...';
            cancelCommentInput.focus();
          }
          if (commentOptionalTag) {
            commentOptionalTag.textContent = '(required - min 5 chars)';
            commentOptionalTag.style.color = 'var(--red)';
          }
        } else {
          if (cancelCommentInput) {
            cancelCommentInput.required = false;
            cancelCommentInput.placeholder = 'Provide any additional details...';
          }
          if (commentOptionalTag) {
            commentOptionalTag.textContent = '(optional)';
            commentOptionalTag.style.color = '';
          }
        }
      });
    });

    // Character counter for comment
    if (cancelCommentInput && cancelCharCount) {
      cancelCommentInput.addEventListener('input', function() {
        cancelCharCount.textContent = this.value.length;
        if (modalFormError) modalFormError.style.display = 'none';
      });
    }

    // Form submission validation
    if (cancelForm) {
      cancelForm.addEventListener('submit', function(e) {
        const checkedRadio = document.querySelector('input[name="cancel_reason"]:checked');
        if (!checkedRadio) {
          e.preventDefault();
          if (modalFormError) {
            modalFormError.textContent = 'Please select a reason for cancellation.';
            modalFormError.style.display = 'block';
          }
          return;
        }

        if (checkedRadio.value === 'Other') {
          const commentVal = (cancelCommentInput ? cancelCommentInput.value : '').trim();
          if (commentVal.length < 5) {
            e.preventDefault();
            if (modalFormError) {
              modalFormError.textContent = 'Please specify a reason of at least 5 characters for "Other".';
              modalFormError.style.display = 'block';
            }
            if (cancelCommentInput) cancelCommentInput.focus();
            return;
          }
        }

        if (cancelSubmitBtn) {
          cancelSubmitBtn.disabled = true;
          cancelSubmitBtn.textContent = 'Cancelling...';
        }
      });
    }

    // ── Return success dialog auto-open ──────────────────────────────────────
    const returnSuccessModal = document.getElementById('returnSuccessModal');
    if (returnSuccessModal) {
      returnSuccessModal.showModal();
      returnSuccessModal.addEventListener('click', function(e) {
        if (e.target === returnSuccessModal) returnSuccessModal.close();
      });
    }
  </script>

  <!-- ── Return Success Modal ──────────────────────────────────────────── -->
  <% if (typeof query !== 'undefined' && query && query.returned) { %>
  <dialog id="returnSuccessModal" class="return-success-modal">
    <div class="return-success-inner">
      <div class="return-success-icon">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="9 12 11 14 15 10"/>
        </svg>
      </div>
      <h2 class="return-success-title">Return Request<br>Received</h2>
      <p class="return-success-body">
        Your return has been successfully placed. Our team will process
        the request and pick up the item within <strong>2–3 business days</strong>.
      </p>
      <p class="return-success-body">
        Your refund will be credited to your original payment method within <strong>7 days</strong>.
      </p>
      <a href="/orders" class="return-success-btn">Back to Orders</a>
    </div>
  </dialog>
  <% } %>

</body>
</html>

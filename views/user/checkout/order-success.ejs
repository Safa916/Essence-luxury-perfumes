<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Order Placed Successfully | Essence</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@400;500&display=swap" rel="stylesheet">
 <link rel="stylesheet" href="/user/checkout/order-success.css">
</head>
<body>

  <%
    // Expected data from your route (fallbacks shown for quick preview)
    const o = (typeof order !== 'undefined' && order) ? order : {};
    const orderId  = o.id || '#perfume-45821';
    const total    = o.total != null ? o.total : 4500;
    const payment  = o.paymentMethod || 'Razorpay / UPI';
    const delivery = o.estimatedDelivery || '3-5 Business Days';
    const items    = o.items && o.items.length ? o.items : [{
      image: '', brand: 'Dior', name: 'Sauvage Elixir',
      description: 'Professional Grade / Firm Ground', qty: 1, size: '100ML'
    }];
    const supportEmail = o.supportEmail || 'support@essence.com';
    const inr = (n) => '₹' + Number(n).toLocaleString('en-IN');
  %>

  <main class="success-page">

    <!-- Header -->
    <header class="success-header">
      <div class="success-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <h1 class="success-title">Order Placed Successfully</h1>
      <p class="success-subtitle">Thank you for your purchase</p>
    </header>

    <!-- Content -->
    <section class="success-grid">

      <!-- Items -->
      <div class="items-panel">
        <% items.forEach(function (item) { %>
          <article class="item-card">
            <div class="item-image">
              <% if (item.image) { %>
                <img src="<%= item.image %>" alt="<%= item.name %>">
              <% } %>
            </div>
            <div class="item-info">
              <p class="eyebrow"><%= item.brand || 'Essence' %></p>
              <h2 class="item-name"><%= item.name %></h2>
              <p class="item-desc"><%= item.description || '' %></p>
              <p class="item-meta">
                <span>Qty: <%= String(item.qty).padStart(2, '0') %></span>
                <span>Size: <%= item.size %></span>
              </p>
            </div>
          </article>
        <% }) %>
      </div>

      <!-- Summary -->
      <aside class="summary-panel">
        <dl class="summary-list">
          <div class="summary-row">
            <dt>Order ID</dt>
            <dd><%= orderId %></dd>
          </div>
          <div class="summary-row">
            <dt>Total Amount</dt>
            <dd class="summary-total"><%= inr(total) %></dd>
          </div>
          <div class="summary-row">
            <dt>Payment Method</dt>
            <dd><%= payment %></dd>
          </div>
          <div class="summary-row">
            <dt>Estimated Delivery</dt>
            <dd><%= delivery %></dd>
          </div>
        </dl>

        <p class="summary-note">
          A confirmation email has been sent to your registered address with tracking details.
        </p>

        <div class="help-box">
          <p class="eyebrow">Need help?</p>
          <p class="help-text">Contact our support team</p>
          <a class="help-link" href="mailto:<%= supportEmail %>"><%= supportEmail %></a>
        </div>
      </aside>

    </section>

    <div class="success-actions">
      <a href="/orders" class="btn btn-primary">View My Orders</a>
      <a href="/" class="btn btn-ghost">Continue Shopping</a>
    </div>

  </main>

</body>
</html>

<%
  // Safe defaults so the page renders even if the controller omits data
  const _items = typeof items !== 'undefined' ? items : [];
  const _address = typeof address !== 'undefined' && address ? address : null;
  const _coupon = typeof coupon !== 'undefined' ? coupon : null;
  const _subtotal = typeof subtotal !== 'undefined' ? subtotal : 0;
  const _discount = typeof discount !== 'undefined' ? discount : 0;
  const _total = typeof total !== 'undefined' ? total : _subtotal - _discount;
  const fmt = (n) => '₹' + Number(n).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Checkout — ESSENCE</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/user/common.css">
<link rel="stylesheet" href="/user/checkout/checkout.css">
</head>
<body>

  <%- include('../partials/header', { activePage: '' }) %>

  <main class="checkout">
    <form id="checkoutForm" class="checkout-grid" action="/checkout" method="POST" novalidate>

      <!-- ============ LEFT COLUMN ============ -->
      <div class="checkout-main">

        <!-- 01 Shipping -->
        <section class="co-section">
          <div class="co-heading">
            <div class="co-heading-left">
              <span class="step-badge">01</span>
              <h2 class="co-title">Shipping Details</h2>
            </div>
            <a href="/profile/addresses" class="edit-link">Edit Address</a>
          </div>

          <div class="address-card">
            <% if (_address) { %>
              <p class="field-label">Recipient</p>
              <p class="field-value"><%= _address.fullName %></p>

              <p class="field-label">Delivery Address</p>
              <p class="field-value address-lines">
                <%= _address.line1 %><% if (_address.city) { %>, <%= _address.district || '' %><% } %><br>
                <%= _address.city %>, <%= _address.state %>, <%= _address.pincode %><br>
                <%= _address.country || 'India' %>
              </p>
              <input type="hidden" name="addressId" value="<%= _address._id || _address.id %>">
            <% } else { %>
              <p class="field-value">No delivery address found.</p>
              <a href="/profile/addresses/new" class="btn btn-dark btn-sm">Add Address</a>
            <% } %>
          </div>
        </section>

        <!-- 02 Payment -->
        <section class="co-section">
          <div class="co-heading">
            <div class="co-heading-left">
              <span class="step-badge">02</span>
              <h2 class="co-title">Payment Method</h2>
            </div>
          </div>

          <div class="pay-options">
            <label class="pay-option">
              <input type="radio" name="paymentMethod" value="card" checked>
              <span class="pay-radio"></span>
              <span class="pay-text">
                <span class="pay-name">Secure Card</span>
                <span class="pay-desc">Visa, Mastercard, American Express</span>
              </span>
              <svg class="pay-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
            </label>

            <label class="pay-option">
              <input type="radio" name="paymentMethod" value="wallet">
              <span class="pay-radio"></span>
              <span class="pay-text">
                <span class="pay-name">Digital Wallet</span>
                <span class="pay-desc">Apple Pay, Google Pay, UPI</span>
              </span>
              <svg class="pay-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="3" y="6" width="18" height="14" rx="2"/><path d="M3 10h18M16 15h2"/></svg>
            </label>

            <label class="pay-option">
              <input type="radio" name="paymentMethod" value="bank">
              <span class="pay-radio"></span>
              <span class="pay-text">
                <span class="pay-name">Bank Transfer</span>
                <span class="pay-desc">Direct wire transfer from your institution</span>
              </span>
              <svg class="pay-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M3 10l9-6 9 6M5 10v8M9 10v8M15 10v8M19 10v8M3 20h18"/></svg>
            </label>
          </div>

          <!-- Card fields -->
          <div class="card-fields" id="cardFields">
            <div class="line-field">
              <label for="cardName">Cardholder Name</label>
              <input type="text" id="cardName" name="cardName" placeholder="NAME AS IT APPEARS ON CARD" autocomplete="cc-name">
            </div>

            <div class="line-field">
              <label for="cardNumber">Card Number</label>
              <input type="text" id="cardNumber" name="cardNumber" placeholder="0000 0000 0000 0000" inputmode="numeric" maxlength="19" autocomplete="cc-number">
            </div>

            <div class="line-row">
              <div class="line-field">
                <label for="cardExpiry">Expiry</label>
                <input type="text" id="cardExpiry" name="cardExpiry" placeholder="MM/YY" maxlength="5" inputmode="numeric" autocomplete="cc-exp">
              </div>
              <div class="line-field">
                <label for="cardCvv">Security Code</label>
                <input type="password" id="cardCvv" name="cardCvv" placeholder="CVV" maxlength="4" inputmode="numeric" autocomplete="cc-csc">
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- ============ RIGHT COLUMN ============ -->
      <aside class="order-summary">
        <h2 class="summary-title">Order Summary</h2>

        <ul class="summary-items">
          <% _items.forEach(function (item) { %>
            <li class="summary-item">
              <div class="summary-thumb">
                <img src="<%= item.image %>" alt="<%= item.name %>">
              </div>
              <div class="summary-info">
                <p class="summary-name"><%= item.name %></p>
                <p class="summary-meta"><%= item.size || '100ML' %> · QTY <%= item.quantity %></p>
                <p class="summary-price"><%= fmt(item.price) %></p>
              </div>
            </li>
          <% }) %>
        </ul>

        <!-- Coupons -->
        <div class="coupon-block">
          <a href="/coupons" class="coupon-link">
            <span>Available Coupons</span>
            <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 6 15 12 9 18"/></svg>
          </a>

          <div class="coupon-row">
            <input type="text" id="couponInput" placeholder="COUPON CODE" autocomplete="off">
            <button type="button" id="applyCoupon" class="btn-apply">Apply</button>
          </div>

          <% if (_coupon) { %>
            <div class="coupon-applied">
              <span><%= _coupon.code %> APPLIED</span>
              <button type="button" id="removeCoupon" class="remove-link">[Remove]</button>
            </div>
          <% } %>
        </div>

        <!-- Totals -->
        <dl class="totals">
          <div class="totals-row"><dt>Subtotal</dt><dd><%= fmt(_subtotal) %></dd></div>
          <div class="totals-row is-discount"><dt>Coupon Discount</dt><dd>−<%= fmt(_discount) %></dd></div>
          <div class="totals-row"><dt>Shipping</dt><dd>Calculated at next step</dd></div>
        </dl>

        <div class="total-row">
          <span class="total-label">Total</span>
          <span class="total-amount"><%= fmt(_total) %></span>
        </div>

        <p class="secure-note">Encrypted transaction · 100% secure</p>

        <button type="submit" class="btn-purchase">Complete Purchase</button>
      </aside>

    </form>
  </main>

  <script>
    (function () {
      const radios = document.querySelectorAll('input[name="paymentMethod"]');
      const cardFields = document.getElementById('cardFields');

      function syncPayment() {
        const selected = document.querySelector('input[name="paymentMethod"]:checked').value;
        cardFields.hidden = selected !== 'card';
      }
      radios.forEach(r => r.addEventListener('change', syncPayment));
      syncPayment();

      // Card number: groups of 4
      document.getElementById('cardNumber').addEventListener('input', function (e) {
        e.target.value = e.target.value.replace(/\D/g, '').slice(0, 16).replace(/(.{4})/g, '$1 ').trim();
      });

      // Expiry: MM/YY
      document.getElementById('cardExpiry').addEventListener('input', function (e) {
        let v = e.target.value.replace(/\D/g, '').slice(0, 4);
        if (v.length > 2) v = v.slice(0, 2) + '/' + v.slice(2);
        e.target.value = v;
      });

      // CVV: digits only
      document.getElementById('cardCvv').addEventListener('input', function (e) {
        e.target.value = e.target.value.replace(/\D/g, '');
      });

      // Coupons (adjust endpoints to match your routes)
      const post = (url, body) => fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body || {})
      }).then(r => r.json());

      const applyBtn = document.getElementById('applyCoupon');
      applyBtn.addEventListener('click', async function () {
        const code = document.getElementById('couponInput').value.trim();
        if (!code) return;
        const res = await post('/checkout/coupon/apply', { code });
        if (res.success) location.reload(); else alert(res.message || 'Invalid coupon');
      });

      const removeBtn = document.getElementById('removeCoupon');
      if (removeBtn) {
        removeBtn.addEventListener('click', async function () {
          const res = await post('/checkout/coupon/remove');
          if (res.success) location.reload();
        });
      }
    })();
  </script>
</body>
</html>

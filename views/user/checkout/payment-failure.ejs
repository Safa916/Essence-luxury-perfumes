<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= refundedToWallet ? 'Payment Refunded to Wallet' : 'Payment Failed' %> | Essence</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/user/common.css">
  <link rel="stylesheet" href="/user/checkout/order-success.css">
  <style>
    /* ── Shared card ─────────────────────────────────────────────────────── */
    .result-card {
      max-width: 560px;
      margin: 0 auto;
      background: #ffffff;
      border: 1px solid var(--border, #eadfdb);
      border-radius: 14px;
      padding: 40px 36px;
      text-align: center;
      box-shadow: 0 6px 28px rgba(0,0,0,0.04);
    }

    /* ── Icon circle ─────────────────────────────────────────────────────── */
    .result-icon {
      width: 58px;
      height: 58px;
      margin: 0 auto 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
    }
    .result-icon.is-failure {
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #dc2626;
    }
    .result-icon.is-wallet {
      background: #f0fdf4;
      border: 1px solid #86efac;
      color: #16a34a;
    }

    /* ── Title ───────────────────────────────────────────────────────────── */
    .result-title {
      font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
      font-size: 2.1rem;
      font-weight: 500;
      color: #1f2937;
      margin: 0 0 10px;
    }
    .result-subtitle {
      font-size: 0.95rem;
      color: #6b7280;
      max-width: 460px;
      margin: 0 auto 28px;
      line-height: 1.65;
    }

    /* ── Status / info box ───────────────────────────────────────────────── */
    .status-box {
      padding: 14px 18px;
      border-radius: 8px;
      font-size: 0.88rem;
      margin-bottom: 28px;
      line-height: 1.5;
    }
    .status-box.is-failure {
      background: #fef2f2;
      border: 1px dashed #fca5a5;
      color: #991b1b;
    }
    .status-box.is-wallet {
      background: #f0fdf4;
      border: 1px solid #86efac;
      color: #166534;
    }
    .status-box .status-label {
      font-weight: 600;
      display: block;
      margin-bottom: 4px;
    }

    /* ── Wallet info strip ───────────────────────────────────────────────── */
    .wallet-strip {
      display: flex;
      align-items: center;
      gap: 10px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 14px 18px;
      margin-bottom: 28px;
      text-align: left;
    }
    .wallet-strip-icon {
      font-size: 1.6rem;
      flex-shrink: 0;
    }
    .wallet-strip-text {
      font-size: 0.87rem;
      color: #374151;
      line-height: 1.5;
    }
    .wallet-strip-text strong {
      color: #111827;
    }

    /* ── Actions ─────────────────────────────────────────────────────────── */
    .result-actions {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .btn-dark-solid {
      padding: 12px 28px;
      background: #111;
      color: #fff;
      text-decoration: none;
      border-radius: 4px;
      font-family: 'Jost', sans-serif;
      font-size: 0.9rem;
      font-weight: 500;
      transition: background 0.2s;
    }
    .btn-dark-solid:hover { background: #333; }
    .btn-outline-muted {
      padding: 12px 28px;
      border: 1px solid #d1d5db;
      color: #374151;
      text-decoration: none;
      border-radius: 4px;
      font-family: 'Jost', sans-serif;
      font-size: 0.9rem;
      font-weight: 500;
      transition: border-color 0.2s;
    }
    .btn-outline-muted:hover { border-color: #9ca3af; }
    .btn-wallet {
      padding: 12px 28px;
      background: #16a34a;
      color: #fff;
      text-decoration: none;
      border-radius: 4px;
      font-family: 'Jost', sans-serif;
      font-size: 0.9rem;
      font-weight: 500;
      transition: background 0.2s;
    }
    .btn-wallet:hover { background: #15803d; }
  </style>
</head>
<body>

  <main class="success-page">
    <div class="result-card">

      <% if (refundedToWallet) { %>
        <!-- ── Wallet-refund case ───────────────────────────────────────── -->
        <div class="result-icon is-wallet" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 12V22H4V12"/>
            <path d="M22 7H2v5h20V7z"/>
            <path d="M12 22V7"/>
            <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/>
            <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
          </svg>
        </div>

        <h1 class="result-title">Payment Refunded</h1>
        <p class="result-subtitle">
          <%= reason %>
        </p>

        <div class="wallet-strip">
          <span class="wallet-strip-icon">💼</span>
          <span class="wallet-strip-text">
            <strong>Your Essence Wallet has been credited.</strong><br>
            The full payment amount has been instantly added to your wallet balance and is ready to use on your next order.
          </span>
        </div>

        <div class="result-actions">
          <a href="/wallet" class="btn-wallet">View My Wallet</a>
          <a href="/shop" class="btn-outline-muted">Continue Shopping</a>
        </div>

      <% } else { %>
        <!-- ── Generic payment failure case ───────────────────────────── -->
        <div class="result-icon is-failure" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="15" y1="9" x2="9" y2="15"></line>
            <line x1="9" y1="9" x2="15" y2="15"></line>
          </svg>
        </div>

        <h1 class="result-title">Payment Unsuccessful</h1>
        <p class="result-subtitle">
          <%= typeof reason !== 'undefined' && reason
            ? reason
            : 'Your payment transaction could not be processed at this moment. No amount was charged from your account.' %>
        </p>

        <div class="status-box is-failure">
          <span class="status-label">Status:</span>
          Payment Failed or Cancelled — your account has not been charged.
        </div>

        <div class="result-actions">
          <a href="/checkout" class="btn-dark-solid">Retry Payment</a>
          <a href="/cart" class="btn-outline-muted">Return to Cart</a>
        </div>
      <% } %>

    </div>
  </main>

</body>
</html>

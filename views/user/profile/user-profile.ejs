<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'My Profile — Essence' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/user/profile/user-profile.css">
</head>
<body>

  <% var user = typeof user !== 'undefined' && user ? user : {
    firstName: 'Safa',
    lastName: 'N',
    fullName: 'Safa N',
    memberSince: '2025',
    email: 'safa@gmail.com',
    phone: '+91 8330857937',
    referralCode: 'ESSENCE-SAFA-25',
    passwordUpdated: 'Last updated 3 months ago',
    authProvider: 'local',
    avatar: null
  }; %>


  <!-- ===== Header ===== -->
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="logo">ESSENCE</a>
      <nav class="main-nav">
        <a href="/" class="nav-link is-active">Home</a>
        <a href="/categories" class="nav-link">Categories</a>
        <a href="/brands" class="nav-link">Brands</a>
        <a href="/new-arrivals" class="nav-link">New Arrivals</a>
        <a href="/limited-edition" class="nav-link">Limited Edition</a>
      </nav>
      <div class="header-icons">
        <button class="icon-btn" aria-label="Search">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
        <a href="/wishlist" class="icon-btn" aria-label="Wishlist">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20.5s-7.5-4.6-10-9.3C.5 7.8 2.4 4.5 5.8 4c2-.3 3.9.6 5.2 2.4C12.3 4.6 14.2 3.7 16.2 4c3.4.5 5.3 3.8 3.8 7.2-2.5 4.7-10 9.3-10 9.3z"/></svg>
        </a>
        <a href="/cart" class="icon-btn" aria-label="Bag">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        </a>
        <a href="/profile" class="icon-btn" aria-label="Account">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
        </a>
      </div>
    </div>
  </header>

  <div class="account-layout">

    <!-- ===== Sidebar ===== -->
    <aside class="account-sidebar">
      <p class="sidebar-label">Account</p>
      <nav class="sidebar-nav">
        <a href="/profile" class="sidebar-link is-active">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
          Profile
        </a>
        <a href="/address" class="sidebar-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.3"/></svg>
          Address
        </a>
        <a href="/orders" class="sidebar-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="7" width="16" height="13" rx="1"/><path d="M8 7V5a4 4 0 0 1 8 0v2"/></svg>
          My Orders
        </a>
        <a href="/wallet" class="sidebar-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="13" rx="1.5"/><path d="M16 12.5h2.5"/><path d="M3 9.5h18"/></svg>
          Wallet
        </a>
      </nav>
    </aside>

    <!-- ===== Main ===== -->
    <main class="account-main">


       <% if (typeof passwordChanged !== 'undefined' && passwordChanged) { %>
    <div class="success-banner">Password updated successfully.</div>
  <% } %>
      <!-- Overview header -->
      <div class="profile-header">
        <div>
          <p class="eyebrow">Account Overview</p>
          <h1 class="page-title">My Profile</h1>
        </div>
        <div class="profile-actions">
          <a href="/profile/edit" class="btn btn-dark">Edit Profile</a>
          <button type="button" id="logoutBtn" class="btn btn-outline">Logout</button>
        </div>
      </div>

      <!-- Identity + security row -->
      <section class="identity-row">

        <div class="identity-card">
          <div class="avatar">
            <% if (user.avatar) { %>
              <img src="<%= user.avatar %>" alt="<%= user.fullName %>">
            <% } %>
          </div>
          <div class="identity-info">
            <h2><%= user.fullName %></h2>
            <p>Member since <%= user.memberSince %></p>
          </div>
        </div>

        <div class="side-cards">
          <div class="info-card">
            <p class="info-label">Security Status</p>
            <div class="info-card-row">
              <span class="info-value">Password</span>
              <% if (user.authProvider !== 'google') { %>
                <a href="/profile/security/password" class="link-change">Change</a>
              <% } %>
            </div>
            <% if (user.authProvider === 'google') { %>
              <p class="info-sub">Managed by Google — sign in with Google to access this account</p>
            <% } else { %>
              <p class="info-sub"><%= user.passwordUpdated %></p>
            <% } %>
          </div>

          <div class="info-card info-card-dark">
            <p class="info-label">Email Management</p>
            <div class="info-card-row">
              <span class="info-value"><%= user.email ? 'Email' : 'Add Email' %></span>
              <a href="/profile/security/email" class="link-change">Change</a>
            </div>
          </div>
        </div>

      </section>

      <!-- Referral -->
      <section class="referral-section">
        <h2 class="section-title">Referral Program</h2>
        <div class="referral-card">
          <div class="referral-copy">
            <p class="referral-headline">Share the luxury.</p>
            <p class="referral-body">Invite your friends to Essence. They get 15% off their first order, and you get $50 credit for every successful referral.</p>
          </div>
          <div class="referral-action">
            <span class="referral-code"><%= user.referralCode %></span>
            <button type="button" class="btn btn-dark referral-share" data-code="<%= user.referralCode %>">Share Code</button>
          </div>
        </div>
      </section>

      <!-- Personal details -->
      <section class="details-section">
        <h2 class="section-title">Personal Details</h2>
        <div class="details-grid">
          <div class="detail-field">
            <p class="detail-label">Full Name</p>
            <p class="detail-value"><%= user.fullName %></p>
          </div>
          <div class="detail-field">
            <p class="detail-label">Email Address</p>
            <p class="detail-value"><%= user.email %></p>
          </div>
          <div class="detail-field">
            <p class="detail-label">Phone Number</p>
            <p class="detail-value"><%= user.phone %></p>
          </div>
        </div>
      </section>

    </main>
  </div>

  <!-- Logout Confirmation Modal -->
  <div id="logoutModal" class="logout-modal-overlay" style="display: none;">
    <div class="logout-modal-box">
      <div class="logout-icon">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
          <polyline points="16 17 21 12 16 7"/>
          <line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
      </div>
      <h3 class="logout-title">LOGOUT</h3>
      <p class="logout-subtitle">Are you sure you want to end your session?</p>
      <button id="confirmLogout" class="btn-yes-logout">YES, LOGOUT</button>
      <button id="cancelLogout" class="btn-stay">STAY</button>
    </div>
  </div>

  <script>
    // Copy referral code to clipboard
    var shareBtn = document.querySelector('.referral-share');
    if (shareBtn) {
      shareBtn.addEventListener('click', function () {
        var code = shareBtn.getAttribute('data-code');
        if (navigator.clipboard) {
          navigator.clipboard.writeText(code).then(function () {
            var original = shareBtn.textContent;
            shareBtn.textContent = 'Copied!';
            setTimeout(function () { shareBtn.textContent = original; }, 1800);
          });
        }
      });
    }

    // Logout confirmation flow
    var logoutBtn = document.getElementById('logoutBtn');
    var logoutModal = document.getElementById('logoutModal');
    var cancelLogout = document.getElementById('cancelLogout');
    var confirmLogout = document.getElementById('confirmLogout');

    logoutBtn?.addEventListener('click', function () {
      logoutModal.style.display = 'flex';
    });

    cancelLogout?.addEventListener('click', function () {
      logoutModal.style.display = 'none';
    });

    confirmLogout?.addEventListener('click', async function () {
      await fetch('/auth/logout', { method: 'POST', credentials: 'include' });
      window.location.href = '/auth/login';
    });


   

  var banner = document.querySelector('.success-banner');

  if (window.location.search.includes('passwordChanged=true')) {
    // Clean the URL so refresh doesn't re-show the banner
    window.history.replaceState({}, document.title, '/profile');

    // Auto-hide the banner after 4 seconds
    if (banner) {
      setTimeout(function () {
        banner.style.transition = 'opacity 0.4s ease';
        banner.style.opacity = '0';
        setTimeout(function () {
          banner.style.display = 'none';
        }, 400);
      }, 4000);
    }
  }

</script>
 

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Edit Profile — Essence' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/user/common.css">
  <link rel="stylesheet" href="/user/profile/edit-profile.css">
</head>
<body>

  <% var user = typeof user !== 'undefined' && user ? user : {
    fullName: 'Safa N',
    email: 'safa@gmail.com',
    phone: '+91 8330857937',
    avatar: null
  }; %>

  <%- include('../partials/header', { activePage: 'home', user: user }) %>

  <div class="account-layout">

    <%- include('../partials/account-sidebar', { activePage: 'profile' }) %>

    <!-- ===== Main ===== -->
    <main class="account-main">

      <p class="eyebrow">Account Overview</p>
      <h1 class="page-title">Edit Profile</h1>

      <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
        <div class="error-messages">
          <% errors.forEach(function(err) { %>
            <p class="error"><%= err %></p>
          <% }) %>
        </div>
      <% } %>

      <form action="/profile/edit" method="POST" enctype="multipart/form-data" class="edit-profile-form">

        <!-- Profile portrait -->
        <div class="portrait-section">
          <div class="portrait-preview">
            <% if (user.avatar) { %>
              <img src="<%= user.avatar %>" alt="<%= user.fullName %>" id="avatar-preview-img">
            <% } else { %>
              <svg id="avatar-preview-placeholder" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
              <img src="" alt="<%= user.fullName %>" id="avatar-preview-img" hidden>
            <% } %>
          </div>
          <div class="portrait-text">
            <p class="portrait-label">Profile Portrait</p>
            <div class="portrait-actions">
              <label for="avatar-upload" class="link-upload">Upload New</label>
              <input type="file" id="avatar-upload" name="avatar" accept="image/png, image/jpeg" hidden>
              <button type="button" class="link-remove" id="avatar-remove">Remove</button>
            </div>
            <p class="portrait-note">
              Recommended format: Square JPG or PNG. Minimum 800&times;800px for high-definition displays.
            </p>
          </div>
        </div>

        <!-- Fields -->
        <div class="field-grid">
          <div class="form-field">
            <label for="fullName">Full Name</label>
            <input type="text" id="fullName" name="fullName" value="<%= user.fullName %>">
          </div>
          <div class="form-field">
            <label for="email">Email Address</label>
            <input type="email" id="email" value="<%= user.email %>" disabled>
            <a href="/profile/security/email" class="link-change" style="display:inline-block;margin-top:0.5rem;">Change Email</a>
          </div>
          <div class="form-field">
            <label for="phone">Phone Number</label>
            <input type="tel" id="phone" name="phone" value="<%= user.phone %>">
          </div>
        </div>

        <!-- Actions -->
        <div class="form-actions">
          <button type="submit" class="btn btn-dark">Save Changes</button>
          <a href="/profile" class="btn-cancel">Cancel</a>
        </div>

      </form>

    </main>
  </div>

  <%- include('../partials/logout-modal') %>

  <script>
    var uploadInput = document.getElementById('avatar-upload');
    var previewImg = document.getElementById('avatar-preview-img');
    var placeholder = document.getElementById('avatar-preview-placeholder');
    var removeBtn = document.getElementById('avatar-remove');

    if (uploadInput) {
      uploadInput.addEventListener('change', function () {
        var file = uploadInput.files && uploadInput.files[0];
        if (!file) return;
        var reader = new FileReader();
        reader.onload = function (e) {
          previewImg.src = e.target.result;
          previewImg.hidden = false;
          if (placeholder) placeholder.hidden = true;
        };
        reader.readAsDataURL(file);
      });
    }

    if (removeBtn) {
      removeBtn.addEventListener('click', function () {
        uploadInput.value = '';
        previewImg.src = '';
        previewImg.hidden = true;
        if (placeholder) placeholder.hidden = false;
      });
    }
  </script>

</body>
</html>

<%
  const _active = typeof activePage !== 'undefined' ? activePage : '';
  const _cartCount = typeof cartCount !== 'undefined' ? Number(cartCount) : (typeof locals !== 'undefined' && typeof locals.cartCount !== 'undefined' ? Number(locals.cartCount) : (typeof totalItems !== 'undefined' ? Number(totalItems) : 0));
%>
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">ESSENCE</a>

    <nav class="main-nav">
      <a href="/" class="nav-link <%= _active === 'home' ? 'is-active' : '' %>">Home</a>
      <a href="/categories" class="nav-link <%= _active === 'categories' ? 'is-active' : '' %>">Categories</a>
      <a href="/brands" class="nav-link <%= _active === 'brands' ? 'is-active' : '' %>">Brands</a>
      <a href="/shop" class="nav-link <%= _active === 'shop' ? 'is-active' : '' %>">Shop</a>
    </nav>

    <div class="header-icons">

      <% if (_active !== 'shop') { %>
      <div class="header-search" id="headerSearch">
        <button type="button" class="icon-btn" id="headerSearchToggle" aria-label="Search" aria-expanded="false">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
        <div class="header-search-panel" id="headerSearchPanel">
          <input
            type="text"
            id="headerSearchInput"
            class="header-search-input"
            placeholder="Search fragrances..."
            aria-label="Search fragrances"
          >
        </div>
      </div>
      <% } %>

      <a href="/wishlist" class="icon-btn" aria-label="Wishlist">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20.5s-7.5-4.6-10-9.3C.5 7.8 2.4 4.5 5.8 4c2-.3 3.9.6 5.2 2.4C12.3 4.6 14.2 3.7 16.2 4c3.4.5 5.3 3.8 3.8 7.2-2.5 4.7-10 9.3-10 9.3z"/></svg>
      </a>

      <a href="/cart" class="icon-btn cart-btn <%= _active === 'cart' ? 'is-active' : '' %>" aria-label="Bag" style="position: relative;">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        <% if (_cartCount > 0) { %>
          <span class="cart-badge"><%= _cartCount > 99 ? '99+' : _cartCount %></span>
        <% } %>
      </a>

      <% if (typeof user !== 'undefined' && user) { %>
        <div class="user-menu">
          <a href="/profile" class="icon-btn profile-btn" aria-label="My Profile">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
            <span class="profile-label"><%= user.fullName || user.full_name || 'Profile' %></span>
          </a>
          <button type="button" id="logoutBtn" class="btn-logout">Logout</button>
        </div>
      <% } else { %>
        <a href="/auth/login" class="icon-btn" aria-label="Account">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
        </a>
        <a href="/auth/login" class="btn btn-login">Sign In</a>
      <% } %>

      <!-- Hamburger (mobile only) -->
      <button type="button" class="hamburger" id="hamburgerBtn" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>

    </div>
  </div>
</header>

<!-- Mobile nav drawer -->
<div class="mobile-nav-overlay" id="mobileNavOverlay"></div>
<nav class="mobile-nav-drawer" id="mobileNavDrawer" aria-hidden="true">
  <div class="mobile-nav-header">
    <a href="/" class="logo">ESSENCE</a>
    <button type="button" class="mobile-nav-close" id="mobileNavClose" aria-label="Close menu">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <!-- Mobile search bar -->
  <div class="mobile-nav-search">
    <input
      type="text"
      id="mobileSearchInput"
      class="mobile-search-input"
      placeholder="Search fragrances..."
      aria-label="Search fragrances"
      autocomplete="off"
    >
    <button type="button" class="mobile-search-btn" id="mobileSearchBtn" aria-label="Search">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </button>
  </div>

  <div class="mobile-nav-links">
    <a href="/" class="mobile-nav-link <%= _active === 'home' ? 'is-active' : '' %>">Home</a>
    <a href="/categories" class="mobile-nav-link <%= _active === 'categories' ? 'is-active' : '' %>">Categories</a>
    <a href="/brands" class="mobile-nav-link <%= _active === 'brands' ? 'is-active' : '' %>">Brands</a>
    <a href="/shop" class="mobile-nav-link <%= _active === 'shop' ? 'is-active' : '' %>">Shop</a>
  </div>
  <div class="mobile-nav-footer">
    <% if (typeof user !== 'undefined' && user) { %>
      <a href="/profile" class="mobile-nav-link">My Profile</a>
      <a href="/orders" class="mobile-nav-link">My Orders</a>
      <a href="/wallet" class="mobile-nav-link">My Wallet</a>
      <a href="/coupon" class="mobile-nav-link">My Coupons</a>
      <button type="button" id="mobileLogoutBtn" class="mobile-nav-link mobile-logout-btn">Logout</button>
    <% } else { %>
      <a href="/auth/login" class="btn btn-dark mobile-signin-btn">Sign In</a>
    <% } %>
  </div>
</nav>

<script>
  (function () {
    var wrapper = document.getElementById('headerSearch');
     if (!wrapper) return;
    var toggleBtn = document.getElementById('headerSearchToggle');
    var panel = document.getElementById('headerSearchPanel');
    var input = document.getElementById('headerSearchInput');

    function openSearch() {
      wrapper.classList.add('is-open');
      toggleBtn.setAttribute('aria-expanded', 'true');
      input.focus();
    }

    function closeSearch() {
      wrapper.classList.remove('is-open');
      toggleBtn.setAttribute('aria-expanded', 'false');
    }

    toggleBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      if (wrapper.classList.contains('is-open')) {
        // Icon acts as submit once the panel is already open and has text
        if (input.value.trim()) {
          window.location.href = '/shop?search=' + encodeURIComponent(input.value.trim());
          return;
        }
        closeSearch();
      } else {
        openSearch();
      }
    });

    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        var q = input.value.trim();
        window.location.href = q ? '/shop?search=' + encodeURIComponent(q) : '/shop';
      } else if (e.key === 'Escape') {
        closeSearch();
      }
    });

    // Click anywhere outside closes the panel
    document.addEventListener('click', function (e) {
      if (!wrapper.contains(e.target)) closeSearch();
    });

    // Global helper to update cart badge dynamically from AJAX calls
    window.updateCartBadge = function(count) {
      const cartBtn = document.querySelector('.cart-btn');
      if (!cartBtn) return;
      let badge = cartBtn.querySelector('.cart-badge');
      if (count > 0) {
        if (!badge) {
          badge = document.createElement('span');
          badge.className = 'cart-badge';
          cartBtn.appendChild(badge);
        }
        badge.textContent = count > 99 ? '99+' : count;
      } else if (badge) {
        badge.remove();
      }
    };

    // ── Mobile Nav Drawer ──
    var hamburger   = document.getElementById('hamburgerBtn');
    var drawer      = document.getElementById('mobileNavDrawer');
    var overlay     = document.getElementById('mobileNavOverlay');
    var closeBtn    = document.getElementById('mobileNavClose');
    var mobileLogout = document.getElementById('mobileLogoutBtn');

    function openDrawer() {
      drawer.classList.add('is-open');
      overlay.classList.add('is-open');
      hamburger.classList.add('is-open');
      hamburger.setAttribute('aria-expanded', 'true');
      drawer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-open');
      hamburger.classList.remove('is-open');
      hamburger.setAttribute('aria-expanded', 'false');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    if (hamburger) hamburger.addEventListener('click', openDrawer);
    if (closeBtn)  closeBtn.addEventListener('click', closeDrawer);
    if (overlay)   overlay.addEventListener('click', closeDrawer);

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeDrawer();
    });

    // Wire up mobile logout button to the same form as desktop logout
    if (mobileLogout) {
      mobileLogout.addEventListener('click', function() {
        var desktopLogout = document.getElementById('logoutBtn');
        if (desktopLogout) desktopLogout.click();
        else window.location.href = '/auth/logout';
      });
    }

    // ── Mobile search ──
    var mobileSearchInput = document.getElementById('mobileSearchInput');
    var mobileSearchBtn   = document.getElementById('mobileSearchBtn');

    function doMobileSearch() {
      var q = mobileSearchInput ? mobileSearchInput.value.trim() : '';
      window.location.href = q ? '/shop?search=' + encodeURIComponent(q) : '/shop';
    }

    if (mobileSearchBtn) mobileSearchBtn.addEventListener('click', doMobileSearch);
    if (mobileSearchInput) {
      mobileSearchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); doMobileSearch(); }
      });
    }

  })();
</script>

<!-- Global Essence UI: branded toast + confirm (replaces alert/confirm sitewide) -->
<script src="/user/js/essence-ui.js"></script>


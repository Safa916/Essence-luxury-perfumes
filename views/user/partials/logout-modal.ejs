<div id="logoutModal" class="logout-modal-overlay" style="display: none;">
  <div class="logout-modal-box">
    <div class="logout-icon">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
        <polyline points="16 17 21 12 16 7"/>
        <line x1="21" y1="12" x2="9" y2="12"/>
      </svg>
    </div>
    <h3 class="logout-title">LOGOUT</h3>
    <p class="logout-subtitle">Are you sure you want to end your session?</p>
    <button id="confirmLogout" class="btn-yes-logout">YES, LOGOUT</button>
    <button id="cancelLogout" class="btn-stay">STAY ON PITCH</button>
  </div>
</div>

<script>
  window.addEventListener('pageshow', function (event) {
    if (event.persisted) window.location.reload();
  });

  const logoutBtn = document.getElementById('logoutBtn');
  const logoutModal = document.getElementById('logoutModal');
  const cancelLogout = document.getElementById('cancelLogout');
  const confirmLogout = document.getElementById('confirmLogout');

  logoutBtn?.addEventListener('click', () => {
    logoutModal.style.display = 'flex';
  });

  cancelLogout?.addEventListener('click', () => {
    logoutModal.style.display = 'none';
  });

  confirmLogout?.addEventListener('click', async () => {
    await fetch('/auth/logout', { method: 'POST', credentials: 'include' });
    localStorage.removeItem('token');
    window.location.href = '/auth/login';
  });
</script>

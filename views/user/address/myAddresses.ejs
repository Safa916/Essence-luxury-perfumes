<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'My Addresses — Essence' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/user/address/myAddresses.css">
</head>
<body>

  <% var addresses = typeof addresses !== 'undefined' ? addresses : []; %>
  <!-- ===== Header ===== -->
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="logo">ESSENCE</a>
      <nav class="main-nav">
        <a href="/" class="nav-link is-active">Home</a>
        <a href="/categories" class="nav-link">Categories</a>
        <a href="/brands" class="nav-link">Brands</a>
        <a href="/new-arrivals" class="nav-link">New Arrivals</a>
        <a href="/limited-edition" class="nav-link">Limited Edition</a>
      </nav>
      <div class="header-icons">
        <button class="icon-btn" aria-label="Search">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
        <a href="/wishlist" class="icon-btn" aria-label="Wishlist">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20.5s-7.5-4.6-10-9.3C.5 7.8 2.4 4.5 5.8 4c2-.3 3.9.6 5.2 2.4C12.3 4.6 14.2 3.7 16.2 4c3.4.5 5.3 3.8 3.8 7.2-2.5 4.7-10 9.3-10 9.3z"/></svg>
        </a>
        <a href="/cart" class="icon-btn" aria-label="Bag">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        </a>
        <a href="/profile" class="icon-btn" aria-label="Account">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
        </a>
      </div>
    </div>
  </header>

  <div class="account-layout">

    <!-- ===== Sidebar ===== -->
    <aside class="account-sidebar">
      <p class="sidebar-label">Account</p>
      <nav class="sidebar-nav">
        <a href="/profile" class="sidebar-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
          Profile
        </a>
        <a href="/address" class="sidebar-link is-active">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.3"/></svg>
          Addresses
        </a>
        <a href="/orders" class="sidebar-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="7" width="16" height="13" rx="1"/><path d="M8 7V5a4 4 0 0 1 8 0v2"/></svg>
          My Orders
        </a>
        <a href="/wishlist" class="sidebar-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20.5s-7.5-4.6-10-9.3C.5 7.8 2.4 4.5 5.8 4c2-.3 3.9.6 5.2 2.4C12.3 4.6 14.2 3.7 16.2 4c3.4.5 5.3 3.8 3.8 7.2-2.5 4.7-10 9.3-10 9.3z"/></svg>
          Wishlist
        </a>
        <a href="/wallet" class="sidebar-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="13" rx="1.5"/><path d="M16 12.5h2.5"/><path d="M3 9.5h18"/></svg>
          Wallet
        </a>
      </nav>
    </aside>

    <!-- ===== Main ===== -->
    <main class="account-main">

      <div class="address-header">
  <div>
    <p class="eyebrow">Account Management</p>
    <h1 class="page-title">My Addresses</h1>
  </div>
  <% if (addresses.length > 0) { %>
    <a href="/address/new" class="btn btn-dark btn-add">
      <span class="plus">+</span> Add New Address
    </a>
  <% } %>
</div>

      <% if (addresses.length === 0) { %>
        <div class="empty-address-state">
          <div class="empty-icon">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.3"/></svg>
          </div>
          <h2 class="empty-title">No Addresses Found</h2>
          <p class="empty-subtitle">You haven't added any shipping addresses yet. Add one to speed up your checkout process and ensure precision delivery of your order.</p>
          <a href="/address/new" class="btn btn-dark btn-add">
            <span class="plus">+</span> Add New Address
          </a>
        </div>
      <% } else { %>
        <div class="address-list">
          <% addresses.forEach(function(addr) { %>
            <article class="address-card <%= addr.isDefault ? 'is-default' : '' %>">
              <div class="address-card-top">
               <span class="address-badge <%= addr.isDefault ? 'badge-default' : 'badge-plain' %>">
  <%= addr.isDefault ? 'Default Address' : addr.label %>
</span>
                <div class="address-card-actions">
                   
                 <% if (!addr.isDefault) { %>
  <form action="/address/<%= addr.id %>/set-default" method="POST" style="display:inline;">
    <button type="submit" class="set-default-btn" aria-label="Set as default" title="Set as default">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8">
        <circle cx="12" cy="12" r="9"/>
        <path d="M8 12.5l2.5 2.5L16 9.5"/>
      </svg>
      Set as Default
    </button>
  </form>
<% } %>

                  <a href="/address/<%= addr.id %>/edit" class="icon-action" aria-label="Edit address">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
                  </a>

                  <a href="/address/<%= addr.id %>/delete" class="icon-action" aria-label="Delete address">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 7h16"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/><path d="M6 7l1 13a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-13"/></svg>
                  </a>
                </div>
              </div>

              <p class="address-name"><%= addr.name %></p>
              <p class="address-lines">
                <% addr.lines.forEach(function(line, i) { %>
                  <%= line %><% if (i < addr.lines.length - 1) { %><br><% } %>
                <% }); %>
              </p>
            </article>
          <% }); %>
        </div>
      <% } %>

    </main>
  </div>

</body>
</html>
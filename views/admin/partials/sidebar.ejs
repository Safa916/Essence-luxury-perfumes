<!-- Mobile Topbar Header -->
<header class="admin-mobile-topbar">
    <button type="button" class="admin-menu-toggle" id="adminSidebarToggle" aria-label="Open Navigation Menu">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
    </button>
    <div class="admin-mobile-brand">
        <span class="admin-mobile-title">ESSENCE</span>
        <span class="admin-mobile-badge">Admin</span>
    </div>
    <div class="admin-mobile-right">
        <% 
            const _curPage = typeof activePage !== 'undefined' ? (
                activePage === 'dashboard' ? 'Dashboard' :
                activePage === 'products' ? 'Products' :
                activePage === 'categories' || activePage === 'category' ? 'Categories' :
                activePage === 'orders' ? 'Orders' :
                activePage === 'sales-report' ? 'Sales Report' :
                activePage === 'offers' ? 'Offers' :
                activePage === 'coupons' ? 'Coupons' :
                activePage === 'referrals' ? 'Referrals' :
                activePage === 'users' ? 'Users' :
                activePage === 'returns' ? 'Returns' :
                activePage === 'brand' ? 'Brands' : ''
            ) : '';
        %>
        <% if (_curPage) { %>
            <span class="admin-mobile-curpage"><%= _curPage %></span>
        <% } %>
    </div>
</header>

<!-- Backdrop overlay for mobile drawer -->
<div class="admin-sidebar-overlay" id="adminSidebarOverlay"></div>

<aside class="sidebar" id="adminSidebar">
    <div class="brand-section">
        <div class="brand-info">
            <h1 class="brand-name">ESSENCE</h1>
            <div class="brand-role">System Admin</div>
        </div>
        <button type="button" class="admin-sidebar-close" id="adminSidebarClose" aria-label="Close Navigation">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>

    <nav class="sidebar-menu">
        <a href="/admin/dashboard" class="menu-item <%= activePage === 'dashboard' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="9"></rect>
                <rect x="14" y="3" width="7" height="5"></rect>
                <rect x="14" y="12" width="7" height="9"></rect>
                <rect x="3" y="16" width="7" height="5"></rect>
            </svg>
            Dashboard
        </a>
        <a href="/admin/products" class="menu-item <%= activePage === 'products' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 8 12 3 3 8l9 5 9-5Z"></path>
                <path d="M3 8v8l9 5 9-5V8"></path>
                <path d="M12 13v8"></path>
            </svg>
            Products
        </a>
        <a href="/admin/categories" class="menu-item <%= (activePage === 'categories' || activePage === 'category') ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="6" cy="6" r="3"></circle>
                <circle cx="18" cy="6" r="3"></circle>
                <circle cx="12" cy="18" r="3"></circle>
            </svg>
            Categories
        </a>
        <a href="/admin/orders" class="menu-item <%= activePage === 'orders' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
                <path d="M3 6h18"></path>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            Orders
        </a>
        <a href="/admin/sales-report" class="menu-item <%= activePage === 'sales-report' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 20V10"></path>
                <path d="M18 20V4"></path>
                <path d="M6 20v-4"></path>
            </svg>
            Sales Report
        </a>
        <a href="/admin/offers" class="menu-item <%= activePage === 'offers' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3.24L4 3v5.59a2 2 0 0 0 .59 1.41l9.58 9.58a2 2 0 0 0 2.83 0l3.59-3.59a2 2 0 0 0 0-2.83Z"></path>
                <circle cx="7.5" cy="7.5" r="1.5"></circle>
            </svg>
            Offers
        </a>
        <a href="/admin/coupons" class="menu-item <%= activePage === 'coupons' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="6" width="20" height="12" rx="2"></rect>
                <path d="M2 10h20"></path>
            </svg>
            Coupons
        </a>
        <a href="/admin/referrals" class="menu-item <%= activePage === 'referrals' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            Referrals
        </a>
        <a href="/admin/users" class="menu-item <%= activePage === 'users' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            Users
        </a>
        <a href="/admin/returns" class="menu-item <%= activePage === 'returns' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                <path d="M3 3v5h5"></path>
            </svg>
            Returns
        </a>
        <a href="/admin/brands" class="menu-item <%= activePage === 'brand' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m20.59 13.41-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z"></path>
                <circle cx="7.5" cy="7.5" r="1.5"></circle>
            </svg>
            Brand
        </a>
    </nav>
</aside>

<script>
(function() {
    var toggleBtn = document.getElementById('adminSidebarToggle');
    var closeBtn = document.getElementById('adminSidebarClose');
    var overlay = document.getElementById('adminSidebarOverlay');
    var sidebar = document.getElementById('adminSidebar');

    function openSidebar() {
        if (sidebar) sidebar.classList.add('is-open');
        if (overlay) overlay.classList.add('is-open');
        document.body.classList.add('admin-sidebar-open');
    }

    function closeSidebar() {
        if (sidebar) sidebar.classList.remove('is-open');
        if (overlay) overlay.classList.remove('is-open');
        document.body.classList.remove('admin-sidebar-open');
    }

    if (toggleBtn) toggleBtn.addEventListener('click', openSidebar);
    if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
    if (overlay) overlay.addEventListener('click', closeSidebar);

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeSidebar();
    });

    if (sidebar) {
        sidebar.querySelectorAll('.menu-item').forEach(function(item) {
            item.addEventListener('click', function() {
                if (window.innerWidth <= 1024) closeSidebar();
            });
        });
    }
})();
</script>

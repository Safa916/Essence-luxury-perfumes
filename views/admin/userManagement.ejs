<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Management — Essence Admin</title>
    <link rel="stylesheet" href="/admin/userManagement.css">
</head>
<body>

    <!-- Sidebar Navigation -->
    <aside class="sidebar">
        <div class="brand-section">
            <h1 class="brand-name">ESSENCE</h1>
            <div class="brand-role">System Admin</div>
        </div>

        <nav class="sidebar-menu">
            <a href="/admin/dashboard" class="menu-item">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="9"></rect>
                    <rect x="14" y="3" width="7" height="5"></rect>
                    <rect x="14" y="12" width="7" height="9"></rect>
                    <rect x="3" y="16" width="7" height="5"></rect>
                </svg>
                Dashboard
            </a>

            <div class="menu-subheader">Products</div>
            <a href="/admin/categories" class="menu-item">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="6" cy="6" r="3"></circle>
                    <circle cx="18" cy="6" r="3"></circle>
                    <circle cx="12" cy="18" r="3"></circle>
                </svg>
                Categories
            </a>
            <a href="/admin/orders" class="menu-item">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
                    <path d="M3 6h18"></path>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
                Orders
            </a>
            <a href="/admin/offers" class="menu-item">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3.24L4 3v5.59a2 2 0 0 0 .59 1.41l9.58 9.58a2 2 0 0 0 2.83 0l3.59-3.59a2 2 0 0 0 0-2.83Z"></path>
                    <circle cx="7.5" cy="7.5" r="1.5"></circle>
                </svg>
                Offers
            </a>
            <a href="/admin/coupons" class="menu-item">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="6" width="20" height="12" rx="2"></rect>
                    <path d="M2 10h20"></path>
                </svg>
                Coupons
            </a>
            <a href="/admin/users" class="menu-item active">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                Users
            </a>
            <a href="/admin/returns" class="menu-item">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                    <path d="M3 3v5h5"></path>
                </svg>
                Returns
            </a>
            <a href="/admin/review" class="menu-item">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
                Review
            </a>
            <a href="/admin/brand" class="menu-item">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="m20.59 13.41-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z"></path>
                    <circle cx="7.5" cy="7.5" r="1.5"></circle>
                </svg>
                Brand
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="main-content">

        <!-- Page Header -->
        <header class="page-header">
            <h2 class="page-title">User Management</h2>
            <div class="page-search-wrapper">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="7"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" class="page-search-input" placeholder="Search users, IDs, or emails...">
            </div>
        </header>

        <!-- Stat Cards -->
        <section class="stats-grid">
            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon-wrapper">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <span class="stat-label">Total Users</span>
                </div>
                <div class="stat-value-row">
                    <span class="stat-value">12,842</span>
                    <span class="stat-trend">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                            <polyline points="18 15 12 9 6 15"></polyline>
                        </svg>
                        12%
                    </span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon-wrapper">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <polyline points="17 11 19 13 23 9"></polyline>
                        </svg>
                    </div>
                    <span class="stat-label">Active Now</span>
                </div>
                <div class="stat-value-row">
                    <span class="stat-value">4,129</span>
                    <span class="stat-suffix">Live</span>
                </div>
            </div>
        </section>

        <!-- User Directory Table -->
        <section class="table-card">
            <div class="table-header">
                <h3 class="table-title">User Directory</h3>
            </div>

            <table class="user-table">
                <thead>
                    <tr>
                        <th class="col-sl">SL<br>NO</th>
                        <th class="col-user">User</th>
                        <th class="col-id">User ID</th>
                        <th class="col-status">Status</th>
                        <th class="col-joined">Joined At</th>
                        <th class="col-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Static rows below. To make dynamic, pass a `users` array from your route
                         and wrap this tbody content in a forEach loop in server-rendered EJS. -->
                    <tr>
                        <td class="col-sl">01</td>
                        <td class="col-user">
                            <div class="user-cell">
                                <div class="avatar-placeholder">SJ</div>
                                <div class="user-cell-text">
                                    <span class="user-name">Sarah Jenkins</span>
                                    <span class="user-email">sarah.j@example.com</span>
                                </div>
                            </div>
                        </td>
                        <td class="col-id"><span class="id-pill">123abc2</span></td>
                        <td class="col-status"><span class="status-badge active">Active</span></td>
                        <td class="col-joined">
                            <span class="joined-date">Oct 21, 2023</span>
                            <span class="joined-time">10:45 AM</span>
                        </td>
                        <td class="col-actions">
                            <div class="action-group">
                                <button class="action-btn view-btn">View</button>
                                <button class="action-icon-btn block-btn" title="Block user">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td class="col-sl">02</td>
                        <td class="col-user">
                            <div class="user-cell">
                                <img class="avatar-img" src="/images/avatars/marcus.jpg" alt="Marcus Chen" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                <div class="avatar-placeholder" style="display:none;">MC</div>
                                <div class="user-cell-text">
                                    <span class="user-name">Marcus Chen</span>
                                    <span class="user-email">marcus.c@example.com</span>
                                </div>
                            </div>
                        </td>
                        <td class="col-id"><span class="id-pill">891d34e</span></td>
                        <td class="col-status"><span class="status-badge active">Active</span></td>
                        <td class="col-joined">
                            <span class="joined-date">Nov 02, 2023</span>
                            <span class="joined-time">09:12 AM</span>
                        </td>
                        <td class="col-actions">
                            <div class="action-group">
                                <button class="action-btn view-btn">View</button>
                                <button class="action-icon-btn block-btn" title="Block user">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>

                    <tr class="row-blocked">
                        <td class="col-sl">03</td>
                        <td class="col-user">
                            <div class="user-cell">
                                <div class="avatar-placeholder muted">EL</div>
                                <div class="user-cell-text">
                                    <span class="user-name strikethrough">Emily Larsson</span>
                                    <span class="user-email">emily.l@example.com</span>
                                </div>
                            </div>
                        </td>
                        <td class="col-id"><span class="id-pill muted">abcd1234</span></td>
                        <td class="col-status"><span class="status-badge blocked">Blocked</span></td>
                        <td class="col-joined">
                            <span class="joined-date">Sep 15, 2023</span>
                            <span class="joined-time">04:30 PM</span>
                        </td>
                        <td class="col-actions">
                            <div class="action-group">
                                <button class="action-btn view-btn">View</button>
                                <button class="action-icon-btn unblock-btn" title="Unblock user">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="table-footer">
                <span class="table-count">Showing 1 to 3 of 12,842 users</span>
                <div class="pagination">
                    <button class="page-nav-btn" disabled>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </button>
                    <button class="page-num-btn active">1</button>
                    <button class="page-num-btn">2</button>
                    <button class="page-num-btn">3</button>
                    <span class="page-ellipsis">...</span>
                    <button class="page-num-btn">428</button>
                    <button class="page-nav-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>
                </div>
            </div>
        </section>

    </main>

</body>
</html>


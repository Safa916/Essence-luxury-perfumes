<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Product · Essence Admin</title>
  <link rel="stylesheet" href="/admin/products/addEditProduct.css" />
  <link rel="stylesheet" href="/admin/partials/sidebar.css" />
</head>
<body>
  <div class="layout">
    <%- include('../partials/sidebar', { activePage: 'products' }) %>

    <main class="main-content">
      <div class="topbar">
        <div class="search-box">
          <span class="search-icon">⌕</span>
          <input type="text" placeholder="Search inventory..." />
        </div>
      </div>

      <% const _bannerErrors = Object.entries(errors || {}).filter(function(kv){ return !['name','sku','full_description','brand_id','category_id'].includes(kv[0]); }); %>
      <% if (_bannerErrors.length) { %>
        <div class="form-errors">
          <% _bannerErrors.forEach(function(kv){ %><div><%= kv[1] %></div><% }); %>
        </div>
      <% } %>

      <% if (variantCount === 0) { %>
        <div class="form-errors">
          ⚠ This product has no active variants.
          <a href="/admin/products/<%= product._id %>/variants">Add one now</a>
          before continuing.
        </div>
      <% } %>

      <form class="product-form" method="POST" action="/admin/products/<%= product._id %>?_method=PUT" enctype="multipart/form-data" novalidate>
        <div class="form-main">
          <h1>EDIT PRODUCT</h1>
          <div class="section-title">GENERAL INFORMATION</div>

          <div class="form-row">
            <div class="form-group">
              <label>PRODUCT NAME</label>
              <input type="text" name="name" value="<%= product.name %>" class="<%= errors && errors.name ? 'input-invalid' : '' %>" />
              <span class="field-error <%= errors && errors.name ? 'show' : '' %>" data-error-for="name"><%= (errors && errors.name) || '' %></span>
            </div>
            <div class="form-group">
              <label>SKU</label>
              <input type="text" name="sku" value="<%= product.sku %>" class="<%= errors && errors.sku ? 'input-invalid' : '' %>" />
               <span class="field-error <%= errors && errors.sku ? 'show' : '' %>" data-error-for="sku"><%= (errors && errors.sku) || '' %></span>
            </div>
          </div>

          <div class="form-group">
            <label>PRODUCT DESCRIPTION</label>
            <textarea name="full_description" rows="5" class="<%= errors && errors.full_description ? 'input-invalid' : '' %>"><%= product.full_description || '' %></textarea>
            <span class="field-error <%= errors && errors.full_description ? 'show' : '' %>" data-error-for="full_description"><%= (errors && errors.full_description) || '' %></span>
          </div>

          <div class="form-row toggles">
            <div class="form-group">
              <label>STATUS</label>
              <label class="toggle">
                <input type="checkbox" name="status" value="active" <%= product.is_active ? 'checked' : '' %> />
                <span class="toggle-track"><span class="toggle-thumb"></span></span>
                <span class="toggle-text"><%= product.is_active ? 'ACTIVE' : 'INACTIVE' %></span>
              </label>
            </div>
          </div>

          <div class="section-title">ORGANIZATION</div>
          <div class="form-row">
            <div class="form-group">
              <label>CATEGORY</label>
              <select name="category_id" class="<%= errors && errors.category_id ? 'input-invalid' : '' %>">
                <option value="">Select category</option>
                <% (categories || []).forEach(function(c) { %>
                  <option value="<%= c._id %>" <%= String(product.category_id && product.category_id._id || product.category_id) === String(c._id) ? 'selected' : '' %>><%= c.name %></option>
                <% }); %>
              </select>
              <span class="field-error <%= errors && errors.category_id ? 'show' : '' %>" data-error-for="category_id"><%= (errors && errors.category_id) || '' %></span>
            </div>
            <div class="form-group">
              <label>BRAND</label>
              <select name="brand_id" class="<%= errors && errors.brand_id ? 'input-invalid' : '' %>">
                <option value="">Select brand</option>
                <% (brands || []).forEach(function(b) { %>
                  <option value="<%= b._id %>" <%= String(product.brand_id && product.brand_id._id || product.brand_id) === String(b._id) ? 'selected' : '' %>><%= b.name %></option>
                <% }); %>
              </select>
              <span class="field-error <%= errors && errors.brand_id ? 'show' : '' %>" data-error-for="brand_id"><%= (errors && errors.brand_id) || '' %></span>
            </div>
            <div class="form-group">
              <label>GST RATE</label>
              <select name="gst_rate">
                <option value="18" <%= (product.gst_rate == 18 || !product.gst_rate) ? 'selected' : '' %>>18% (Standard Perfumes)</option>
                <option value="28" <%= (product.gst_rate == 28) ? 'selected' : '' %>>28% (Luxury Goods)</option>
                <option value="12" <%= (product.gst_rate == 12) ? 'selected' : '' %>>12%</option>
                <option value="5" <%= (product.gst_rate == 5) ? 'selected' : '' %>>5%</option>
                <option value="0" <%= (product.gst_rate == 0) ? 'selected' : '' %>>0% (Exempt)</option>
              </select>
            </div>
          </div>

          <div class="section-title">VARIANTS</div>
          <!--
            No inline variant form here on purpose — unlike Add, an existing
            product can have many variants, not exactly one, so a single
            concentration/size/qty/price form has no well-defined target to
            edit. Variant CRUD lives entirely in the Variant Manager
            (variantController.js: addVariant/updateVariant/deleteVariant),
            this is just a summary + link to it.

            Price and Stock are shown read-only for the same reason: they're
            derived from the product's variants (recalcProductStock /
            recalcProductPrice run automatically whenever a variant is
            added, edited, or deleted), not values an admin sets directly
            here — that's what kept them from drifting out of sync with
            what's actually purchasable.
          -->
          <div class="variant-summary-card">
            <div class="form-row">
              <div class="form-group">
                <label>LISTED PRICE (₹)</label>
                <input type="text" value="<%= product.price %>" disabled />
              </div>
              <div class="form-group">
                <label>TOTAL STOCK</label>
                <input type="text" value="<%= product.stock %>" disabled />
              </div>
            </div>
            <p style="font-size:12px; color:#8a8a8a; margin: 4px 0 14px;">
              <%= variantCount %> variant<%= variantCount === 1 ? '' : 's' %> ·
              price and stock are derived from them and update automatically.
            </p>
            <a href="/admin/products/<%= product._id %>/variants" class="btn-cancel" style="display:inline-block;">
              MANAGE VARIANTS
            </a>
          </div>

          <div class="form-footer">
            <a href="/admin/products" class="btn-cancel">CANCEL</a>
            <button type="submit" class="btn-save">UPDATE PRODUCT</button>
          </div>
        </div>

        <aside class="form-media">
          <div class="section-title">PRODUCT IMAGES</div>
          <div class="existing-images" id="existingImages">
            <% (product.images || []).forEach(function(img) { %>
              <div class="existing-image" data-src="<%= img %>">
                <img src="<%= img %>" alt="<%= product.name %>" />
                <button type="button" class="remove-image-btn" onclick="markImageForRemoval(this, '<%= img %>')">✕</button>
              </div>
            <% }); %>
          </div>
          <input type="hidden" name="removed_images" id="removedImagesInput" value="" />

          <label class="dropzone" for="imagesInput">
            <div class="dropzone-icon">⬆</div>
            <div class="dropzone-text">ADD MORE IMAGES</div>
            <span class="dropzone-btn">SELECT FILES</span>
          </label>
          <input id="imagesInput" type="file" name="images" accept="image/*" multiple style="display:none" />

          <div class="image-previews" id="imagePreviews"></div>
          <div class="image-count-hint" id="imageCountHint">At least 3 images required in total</div>
        </aside>
      </form>
    </main>
  </div>

  <%- include('../partials/cropperModal') %>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
  <script>
    window.__EXISTING_IMAGE_COUNT__ = <%= (product.images || []).length %>;
  </script>
  <script src="/admin/js/productForm.js" data-mode="edit" data-min-images="3"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const form = document.querySelector('.product-form');
      if (!form) return;

      function showError(fieldName, message) {
        const input = document.querySelector(`[name="${fieldName}"]`);
        const errorEl = document.querySelector(`[data-error-for="${fieldName}"]`);
        if (input) input.classList.add('input-invalid');
        if (errorEl) { errorEl.textContent = message; errorEl.classList.add('show'); }
      }

      function clearError(fieldName) {
        const input = document.querySelector(`[name="${fieldName}"]`);
        const errorEl = document.querySelector(`[data-error-for="${fieldName}"]`);
        if (input) input.classList.remove('input-invalid');
        if (errorEl) { errorEl.textContent = ''; errorEl.classList.remove('show'); }
      }

      // ===== Field validation functions =====
      function validateNameField(liveOnly) {
        const input = document.querySelector('[name="name"]');
        if (!input) return true;
        const val = input.value.trim();

        if (!val) {
          showError('name', 'Product name is required.');
          return false;
        }
        if (val.length < 3 || val.length > 100) {
          showError('name', 'Product name must be between 3 and 100 characters.');
          return false;
        }
        const letterCount = (val.match(/[a-zA-Z]/g) || []).length;
        if (letterCount < 3) {
          showError('name', 'Product name must contain letters (symbols or numbers only are not allowed).');
          return false;
        }
        if (/^[-_.,/()&'\s]+$/.test(val)) {
          showError('name', 'Product name cannot consist only of special characters or symbols.');
          return false;
        }
        if (!/^[a-zA-Z0-9\s&',.\-()/]+$/.test(val)) {
          showError('name', "Only letters, numbers, spaces, and (&, ', ., -, /, ()) are allowed.");
          return false;
        }
        const errEl = document.querySelector('[data-error-for="name"]');
        if (errEl && errEl.textContent.includes('already exists')) {
          return false;
        }
        clearError('name');
        return true;
      }

      function validateSkuField() {
        const input = document.querySelector('[name="sku"]');
        if (!input) return true;
        const val = input.value.trim().toUpperCase();

        if (!val) {
          showError('sku', 'SKU is required.');
          return false;
        }
        if (val.length < 3 || val.length > 30) {
          showError('sku', 'SKU must be between 3 and 30 characters.');
          return false;
        }
        const alphanumCount = (val.match(/[A-Z0-9]/g) || []).length;
        if (alphanumCount < 2) {
          showError('sku', 'SKU must contain letters or numbers (e.g. CHANEL-CN-50ML).');
          return false;
        }
        if (/^[-_.\s]+$/.test(val)) {
          showError('sku', 'SKU cannot consist only of symbols.');
          return false;
        }
        if (!/^[A-Z0-9]+([-_][A-Z0-9]+)*$/.test(val)) {
          showError('sku', 'SKU must start and end with letters or numbers, using only single hyphens or underscores in between.');
          return false;
        }
        const errEl = document.querySelector('[data-error-for="sku"]');
        if (errEl && errEl.textContent.includes('already taken')) {
          return false;
        }
        clearError('sku');
        return true;
      }

      function validateDescriptionField() {
        const input = document.querySelector('[name="full_description"]');
        if (!input) return true;
        const val = input.value.trim();

        if (!val) {
          showError('full_description', 'Product description is required.');
          return false;
        }
        if (val.length < 15) {
          showError('full_description', 'Product description must be at least 15 characters.');
          return false;
        }
        const letterCount = (val.match(/[a-zA-Z]/g) || []).length;
        if (letterCount < 10) {
          showError('full_description', 'Product description must contain meaningful text with letters.');
          return false;
        }
        clearError('full_description');
        return true;
      }

      function validateBrandField() {
        const val = document.querySelector('[name="brand_id"]')?.value;
        if (!val) { showError('brand_id', 'Please select a brand.'); return false; }
        clearError('brand_id'); return true;
      }

      function validateCategoryField() {
        const val = document.querySelector('[name="category_id"]')?.value;
        if (!val) { showError('category_id', 'Please select a category.'); return false; }
        clearError('category_id'); return true;
      }

      const descInput = document.querySelector('[name="full_description"]');
      if (descInput) {
        descInput.addEventListener('input', validateDescriptionField);
        descInput.addEventListener('blur', validateDescriptionField);
      }
      const brandInput = document.querySelector('[name="brand_id"]');
      if (brandInput) brandInput.addEventListener('change', validateBrandField);
      const catInput = document.querySelector('[name="category_id"]');
      if (catInput) catInput.addEventListener('change', validateCategoryField);

      // Total image count = existing images still present (not marked for
      // removal) + any newly selected files. #removedImagesInput is kept
      // up to date by markImageForRemoval() in productForm.js.
      function currentImageCount() {
        const removedRaw = (document.getElementById('removedImagesInput').value || '').trim();
        const removedCount = removedRaw ? removedRaw.split(',').filter(Boolean).length : 0;
        const remainingExisting = Math.max((window.__EXISTING_IMAGE_COUNT__ || 0) - removedCount, 0);
        const newSlots = document.querySelectorAll('#imagePreviews .preview-slot:not(.empty)').length;
        return remainingExisting + newSlots;
      }

      // ===== Live duplicate name check on blur ================================
      const nameInput = document.querySelector('[name="name"]');
      let nameCheckTimeout = null;

      if (nameInput) {
        nameInput.addEventListener('input', () => {
          clearTimeout(nameCheckTimeout);
          validateNameField(true);
        });
        nameInput.addEventListener('blur', function () {
          if (!validateNameField(false)) return;
          const val = this.value.trim();
          clearTimeout(nameCheckTimeout);
          nameCheckTimeout = setTimeout(async () => {
            try {
              const res = await fetch('/admin/products/check-name?name=' + encodeURIComponent(val) + '&excludeId=<%= product._id %>');
              const data = await res.json();
              if (data.exists) {
                showError('name', 'A product named "' + val + '" already exists. Please use a different name.');
              }
            } catch (_) { /* silently ignore network errors */ }
          }, 200);
        });
      }

      // ===== Live duplicate SKU check on blur =================================
      const skuInput = document.querySelector('[name="sku"]');
      let skuCheckTimeout = null;

      if (skuInput) {
        skuInput.addEventListener('input', () => {
          clearTimeout(skuCheckTimeout);
          validateSkuField();
        });
        skuInput.addEventListener('blur', function () {
          if (!validateSkuField()) return;
          const val = this.value.trim();
          clearTimeout(skuCheckTimeout);
          skuCheckTimeout = setTimeout(async () => {
            try {
              const res = await fetch('/admin/products/check-sku?sku=' + encodeURIComponent(val) + '&excludeId=<%= product._id %>');
              const data = await res.json();
              if (data.exists) {
                const usedBy = data.usedBy ? ' It is already assigned to ' + data.usedBy + '.' : '';
                showError('sku', 'SKU "' + val.toUpperCase() + '" is already taken.' + usedBy + ' Please use a unique SKU.');
              }
            } catch (_) { /* silently ignore network errors */ }
          }, 200);
        });
      }
      // ========================================================================

      form.addEventListener('submit', function (e) {
        const isNameOk = validateNameField(false);
        const isSkuOk = validateSkuField();
        const isDescOk = validateDescriptionField();
        const isBrandOk = validateBrandField();
        const isCatOk = validateCategoryField();

        const imageCount = currentImageCount();
        let isImagesOk = true;
        if (imageCount < 3) {
          const hint = document.getElementById('imageCountHint');
          if (hint) {
            hint.textContent = `${imageCount} of 3 minimum images selected — please add more.`;
            hint.classList.add('warn');
            hint.classList.remove('ok');
          }
          isImagesOk = false;
        }

        const hasNameErr = document.querySelector('[data-error-for="name"]')?.classList.contains('show');
        const hasSkuErr = document.querySelector('[data-error-for="sku"]')?.classList.contains('show');

        if (!isNameOk || !isSkuOk || !isDescOk || !isBrandOk || !isCatOk || !isImagesOk ||
            hasNameErr || hasSkuErr) {
          e.preventDefault();
          const firstInvalid = document.querySelector('.input-invalid');
          if (firstInvalid) {
            firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
            firstInvalid.focus();
          }
        }
      });
    });
  </script>
</body>
</html>

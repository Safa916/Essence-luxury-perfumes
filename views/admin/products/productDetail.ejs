<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> — Essence Admin</title>
    <link rel="stylesheet" href="/admin/partials/sidebar.css" />
    <link rel="stylesheet" href="/admin/products/productDetail.css" />
</head>
<body>

    <%- include('../partials/sidebar', { activePage: 'products' }) %>

    <main class="main-content">

        <p class="breadcrumb-label">Product Management</p>

        <header class="detail-header">
            <div>
                <h1 class="detail-title"><%= product.name %></h1>
                <span class="sku-badge">SKU</span>
                <span class="sku-value"><%= product.sku || '—' %></span>
            </div>

            <div class="detail-actions">
                <a href="/admin/products/<%= product._id %>/variants" class="action-btn action-btn-outline">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3.24L4 3a1 1 0 0 0-1 1l.24 5.59a2 2 0 0 0 .59 1.41l9.58 9.58a2 2 0 0 0 2.83 0l4.35-4.35a2 2 0 0 0 0-2.82Z"/><circle cx="7.5" cy="7.5" r="1.2"/></svg>
                    View Variants
                </a>
                <a href="/admin/products/<%= product._id %>/edit" class="action-btn action-btn-dark">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path></svg>
                    Edit Product
                </a>
                <button type="button" class="action-btn action-btn-danger" id="openDeleteModalBtn">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    Delete Product
                </button>
            </div>
        </header>

        <section class="detail-body">

            <div class="detail-image-panel">
                <img
                    src="<%= (product.images && product.images[0]) || '/admin/images/placeholder.jpg' %>"
                    alt="<%= product.name %>"
                >
            </div>

            <div class="detail-specs-panel">
                <h2 class="specs-heading">Core Specifications</h2>

                <div class="specs-grid">
                    <div class="spec-item">
                        <p class="spec-label">Category</p>
                        <p class="spec-value"><%= product.category_id ? product.category_id.name : '—' %></p>
                    </div>
                    <div class="spec-item">
                        <p class="spec-label">Collection</p>
                        <p class="spec-value"><%= product.is_limited_edition ? 'Limited Edition' : 'Standard' %></p>
                    </div>
                    <div class="spec-item">
                        <p class="spec-label">Base Price</p>
                        <p class="spec-value">₹<%= Number(product.price).toFixed(2) %></p>
                    </div>
                    <div class="spec-item">
                        <p class="spec-label">Stock Health</p>
                        <p class="spec-value spec-value-status">
                            <span class="status-dot status-<%= stockHealth %>"></span>
                            <% if (stockHealth === 'optimal') { %>Optimal
                            <% } else if (stockHealth === 'low') { %>Low Stock
                            <% } else if (stockHealth === 'critical') { %>Critical
                            <% } else { %>Sold Out
                            <% } %>
                        </p>
                    </div>
                </div>

                <hr class="specs-divider">

                <p class="narrative-label">Product Narrative</p>
                <p class="narrative-text"><%= product.short_description || product.full_description || 'No description added yet.' %></p>

                <p class="variant-count-note"><%= variantCount %> variant<%= variantCount === 1 ? '' : 's' %> configured</p>
            </div>

        </section>

    </main>

    <!-- ===== DELETE PRODUCT MODAL ===== -->
    <div class="modal-overlay" id="deleteModalOverlay">
        <div class="modal-box">
            <div class="modal-header">
                <h2>Delete Product</h2>
                <button type="button" class="modal-close" data-close="deleteModalOverlay">✕</button>
            </div>
            <div class="delete-warning">
                <span class="warning-icon">⚠</span>
                <span class="warning-label">Permanent Action</span>
            </div>
            <p class="delete-message">
                Are you sure you want to delete <strong><%= product.name %></strong>?
                This will remove it (and its variants) from the store frontend. This can be
                reversed later by an admin, but it will not be visible to customers until then.
            </p>
            <form id="deleteProductForm">
                <div class="modal-actions">
                    <button type="button" class="btn-cancel" data-close="deleteModalOverlay">Cancel</button>
                    <button type="submit" class="btn-delete-confirm">Delete</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openModal(id) { document.getElementById(id).classList.add('open'); }
        function closeModal(id) { document.getElementById(id).classList.remove('open'); }

        document.querySelectorAll('[data-close]').forEach((btn) => {
            btn.addEventListener('click', () => closeModal(btn.dataset.close));
        });
        document.querySelectorAll('.modal-overlay').forEach((overlay) => {
            overlay.addEventListener('click', (e) => {
                if (e.target === overlay) closeModal(overlay.id);
            });
        });

        document.getElementById('openDeleteModalBtn').addEventListener('click', () => {
            openModal('deleteModalOverlay');
        });

        document.getElementById('deleteProductForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            try {
                const res = await fetch('/admin/products/<%= product._id %>', {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                });
                const data = await res.json();
                if (data.success) {
                    window.location.href = '/admin/products?deleted=<%= product._id %>';
                } else {
                    alert(data.message || 'Could not delete product');
                }
            } catch (err) {
                console.error(err);
                alert('Something went wrong deleting this product.');
            }
        });
    </script>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add Product · Essence Admin</title>
  <link rel="stylesheet" href="/admin/products/addEditProduct.css" />
  <link rel="stylesheet" href="/admin/partials/sidebar.css" />
</head>
<body>
  <div class="layout">
    <%- include('../partials/sidebar', { activePage: 'products' }) %>

    <main class="main-content">
      <div class="topbar">
        <div class="search-box">
          <span class="search-icon">⌕</span>
          <input type="text" placeholder="Quick find product or SKU..." />
        </div>
      </div>

      <% if (errors && Object.keys(errors).length) { %>
        <div class="form-errors">
          <% Object.values(errors).forEach(function(e) { %><div><%= e %></div><% }); %>
        </div>
      <% } %>

      <form class="product-form" method="POST" action="/admin/products/add" enctype="multipart/form-data" novalidate>
        <div class="form-main">
          <h1>ADD NEW PRODUCT</h1>
          <div class="section-title">GENERAL INFORMATION</div>

          <div class="form-row">
            <div class="form-group">
              <label>PRODUCT NAME</label>
              <input type="text" name="name" placeholder="e.g.Coco Noir Chanel," value="<%= oldInput && oldInput.name || '' %>" class="<%= errors && errors.name ? 'input-invalid' : '' %>" />
               <span class="field-error <%= errors && errors.name ? 'show' : '' %>" data-error-for="name"><%= (errors && errors.name) || '' %></span>
            </div>
            <div class="form-group">
              <label>SKU IDENTIFICATION</label>
              <input type="text" name="sku" placeholder="CHANEL-CN-50ML" value="<%= oldInput && oldInput.sku || '' %>" class="<%= errors && errors.sku ? 'input-invalid' : '' %>" />
               <span class="field-error <%= errors && errors.sku ? 'show' : '' %>" data-error-for="sku"><%= (errors && errors.sku) || '' %></span>
            </div>
          </div>

          <div class="form-group">
            <label>PRODUCT DESCRIPTION</label>
            <div class="rte-toolbar"><span>B</span><span><i>I</i></span><span>≔</span><span>⛓</span></div>
            <textarea name="full_description" rows="5" placeholder="A luxurious floral bouquet of rose, jasmine, and geranium. Think of it like a rich velvet cloth layered over fresh spring petals." class="<%= errors && errors.full_description ? 'input-invalid' : '' %>"><%= oldInput && oldInput.full_description || '' %></textarea>
            <span class="field-error <%= errors && errors.full_description ? 'show' : '' %>" data-error-for="full_description"><%= (errors && errors.full_description) || '' %></span>
          </div>

          <!--
            NOTE: "Base Price" and "Initial Stock" fields were removed here.
            They now come from the FIRST VARIANT section below — the product's
            price/stock are derived from the variant server-side, so there's
            no longer a second number that can drift out of sync with it.
          -->

          <div class="form-row toggles">
            <div class="form-group">
              <label>STATUS</label>
              <label class="toggle">
                <input type="checkbox" name="status" value="active" checked />
                <span class="toggle-track"><span class="toggle-thumb"></span></span>
                <span class="toggle-text">ACTIVE</span>
              </label>
            </div>
          </div>

          <div class="section-title">ORGANIZATION</div>
          <div class="form-row">
            <div class="form-group">
              <label>BRAND</label>
              <select name="brand_id" class="<%= errors && errors.brand_id ? 'input-invalid' : '' %>">
                <option value="">Select brand</option>
                <% (brands || []).forEach(function(b) { %>
                  <option value="<%= b._id %>" <%= oldInput && oldInput.brand_id === String(b._id) ? 'selected' : '' %>><%= b.name %></option>
                <% }); %>
              </select>
              <span class="field-error <%= errors && errors.brand_id ? 'show' : '' %>" data-error-for="brand_id"><%= (errors && errors.brand_id) || '' %></span>
            </div>
            <div class="form-group">
              <label>CATEGORY</label>
              <select name="category_id" class="<%= errors && errors.category_id ? 'input-invalid' : '' %>">
                <option value="">Select category</option>
                <% (categories || []).forEach(function(c) { %>
                  <option value="<%= c._id %>" <%= oldInput && oldInput.category_id === String(c._id) ? 'selected' : '' %>><%= c.name %></option>
                <% }); %>
              </select>
              <span class="field-error <%= errors && errors.category_id ? 'show' : '' %>" data-error-for="category_id"><%= (errors && errors.category_id) || '' %></span>
            </div>
          </div>

          <div class="section-title">FIRST VARIANT (REQUIRED)</div>
          <p style="font-size:12px; color:#8a8a8a; margin-bottom:14px;">
            Every product needs at least one purchasable variant, matching what you'll see in the Variant Manager.
            This variant's price and stock also become the product's listed price and stock.
          </p>
          <div class="form-row">
            <div class="form-group">
              <label>CONCENTRATION</label>
              <input type="text" name="variant_concentration" placeholder="e.g. EDP" value="<%= oldInput && oldInput.variant_concentration || '' %>" class="<%= errors && errors.variant_concentration ? 'input-invalid' : '' %>" />
              <span class="field-error <%= errors && errors.variant_concentration ? 'show' : '' %>" data-error-for="variant_concentration"><%= (errors && errors.variant_concentration) || '' %></span>
            </div>
            <div class="form-group">
              <label>SIZE (ML)</label>
              <input type="number" name="variant_size_ml" min="1" placeholder="100" value="<%= oldInput && oldInput.variant_size_ml || '' %>" class="<%= errors && errors.variant_size_ml ? 'input-invalid' : '' %>" />
              <span class="field-error <%= errors && errors.variant_size_ml ? 'show' : '' %>" data-error-for="variant_size_ml"><%= (errors && errors.variant_size_ml) || '' %></span>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>STOCK LEVEL</label>
              <input type="number" name="variant_quantity" min="0" placeholder="0" value="<%= oldInput && oldInput.variant_quantity || '' %>" class="<%= errors && errors.variant_quantity ? 'input-invalid' : '' %>" />
              <span class="field-error <%= errors && errors.variant_quantity ? 'show' : '' %>" data-error-for="variant_quantity"><%= (errors && errors.variant_quantity) || '' %></span>
            </div>
            <div class="form-group">
              <label>VARIANT PRICE (₹)</label>
              <input type="number" step="0.01" min="0" name="variant_price" placeholder="4400.00" value="<%= oldInput && oldInput.variant_price || '' %>" class="<%= errors && errors.variant_price ? 'input-invalid' : '' %>" />
              <span class="field-error <%= errors && errors.variant_price ? 'show' : '' %>" data-error-for="variant_price"><%= (errors && errors.variant_price) || '' %></span>
            </div>
          </div>

          <div class="form-footer">
            <a href="/admin/products" class="btn-cancel">CANCEL</a>
            <button type="submit" class="btn-save">SAVE PRODUCT</button>
          </div>
        </div>

        <aside class="form-media">
          <div class="section-title">MEDIA</div>
          <label class="dropzone" for="imagesInput">
            <div class="dropzone-icon">⬆</div>
            <div class="dropzone-text">DRAG &amp; DROP PRODUCT IMAGE</div>
            <div class="dropzone-hint">4000 X 4000PX RECOMMENDED · MIN 3 IMAGES</div>
            <span class="dropzone-btn">SELECT FILES</span>
          </label>
          <input id="imagesInput" type="file" name="images" accept="image/*" multiple style="display:none" />

          <div class="image-previews" id="imagePreviews">
            <div class="preview-slot empty">+</div>
            <div class="preview-slot empty">+</div>
            <div class="preview-slot empty">+</div>
          </div>
          <div class="image-count-hint" id="imageCountHint">0 of 3 minimum images selected</div>
        </aside>
      </form>
    </main>
  </div>

  <%- include('../partials/cropperModal') %>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
  <script src="/admin/js/productForm.js" data-mode="add" data-min-images="3"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const form = document.querySelector('.product-form');
      if (!form) return;

      function showError(fieldName, message) {
        const input = document.querySelector(`[name="${fieldName}"]`);
        const errorEl = document.querySelector(`[data-error-for="${fieldName}"]`);
        if (input) input.classList.add('input-invalid');
        if (errorEl) { errorEl.textContent = message; errorEl.classList.add('show'); }
      }

      function clearError(fieldName) {
        const input = document.querySelector(`[name="${fieldName}"]`);
        const errorEl = document.querySelector(`[data-error-for="${fieldName}"]`);
        if (input) input.classList.remove('input-invalid');
        if (errorEl) { errorEl.textContent = ''; errorEl.classList.remove('show'); }
      }

      // ===== clear a field's error the moment the user edits/selects it =====
      ['name', 'sku', 'full_description', 'brand_id', 'category_id', 'variant_concentration', 'variant_size_ml', 'variant_quantity', 'variant_price'].forEach((fieldName) => {
        const el = document.querySelector(`[name="${fieldName}"]`);
        if (!el) return;
        el.addEventListener('input', () => clearError(fieldName));
        el.addEventListener('change', () => clearError(fieldName));
      });
      // ========================================================================

      form.addEventListener('submit', function (e) {
        let isValid = true;

        const name = document.querySelector('[name="name"]').value.trim();
        const sku = document.querySelector('[name="sku"]').value.trim();
        const description = document.querySelector('[name="full_description"]').value.trim();
        const brandId = document.querySelector('[name="brand_id"]').value;
        const categoryId = document.querySelector('[name="category_id"]').value;
        const imageSlots = document.querySelectorAll('.preview-slot:not(.empty)').length;

        if (!name) { showError('name', 'Product name is required.'); isValid = false; }
        if (!sku) { showError('sku', 'SKU is required.'); isValid = false; }
        if (!description) { showError('full_description', 'Product description is required.'); isValid = false; }
        if (!brandId) { showError('brand_id', 'Please select a brand.'); isValid = false; }
        if (!categoryId) { showError('category_id', 'Please select a category.'); isValid = false; }

        const variantConcentration = document.querySelector('[name="variant_concentration"]').value.trim();
        const variantSize = document.querySelector('[name="variant_size_ml"]').value.trim();
        const variantQty = document.querySelector('[name="variant_quantity"]').value.trim();
        const variantPrice = document.querySelector('[name="variant_price"]').value.trim();

        if (!variantConcentration) {
          showError('variant_concentration', 'Concentration is required.');
          isValid = false;
        }

        if (!variantSize || Number(variantSize) <= 0) {
          showError('variant_size_ml', 'Size is required.');
          isValid = false;
        }

        if (variantQty === '' || Number(variantQty) < 0) {
          showError('variant_quantity', 'Stock level is required.');
          isValid = false;
        }

        if (!variantPrice || Number(variantPrice) <= 0) {
          showError('variant_price', 'Variant price is required.');
          isValid = false;
        }

        if (imageSlots < 3) {
          const hint = document.getElementById('imageCountHint');
          if (hint) {
            hint.textContent = `${imageSlots} of 3 minimum images selected — please add more.`;
            hint.classList.add('warn');
            hint.classList.remove('ok');
          }
          isValid = false;
        }

        if (!isValid) {
          e.preventDefault();
          const firstInvalid = document.querySelector('.input-invalid');
          if (firstInvalid) firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });
  </script>

</body>
</html>

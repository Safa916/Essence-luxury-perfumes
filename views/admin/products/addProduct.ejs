<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add Product · Essence Admin</title>
  <link rel="stylesheet" href="/admin/products/addEditProduct.css" />
  <link rel="stylesheet" href="/admin/partials/sidebar.css" />
</head>
<body>
  <div class="layout">
    <%- include('../partials/sidebar', { activePage: 'products' }) %>

    <main class="main-content">
      <div class="topbar">
        <div class="search-box">
          <span class="search-icon">⌕</span>
          <input type="text" placeholder="Quick find product or SKU..." />
        </div>
      </div>

      <% const _bannerErrors = Object.entries(errors || {}).filter(function(kv){ return !['name','sku','full_description','brand_id','category_id'].includes(kv[0]); }); %>
      <% if (_bannerErrors.length) { %>
        <div class="form-errors">
          <% _bannerErrors.forEach(function(kv){ %><div><%= kv[1] %></div><% }); %>
        </div>
      <% } %>

      <form class="product-form" method="POST" action="/admin/products/add" enctype="multipart/form-data" novalidate>
        <div class="form-main">
          <h1>ADD NEW PRODUCT</h1>
          <div class="section-title">GENERAL INFORMATION</div>

          <div class="form-row">
            <div class="form-group">
              <label>PRODUCT NAME</label>
              <input type="text" name="name" placeholder="e.g.Coco Noir Chanel," value="<%= oldInput && oldInput.name || '' %>" class="<%= errors && errors.name ? 'input-invalid' : '' %>" />
               <span class="field-error <%= errors && errors.name ? 'show' : '' %>" data-error-for="name"><%= (errors && errors.name) || '' %></span>
            </div>
            <div class="form-group">
              <label>SKU IDENTIFICATION</label>
              <input type="text" name="sku" placeholder="CHANEL-CN-50ML" value="<%= oldInput && oldInput.sku || '' %>" class="<%= errors && errors.sku ? 'input-invalid' : '' %>" />
               <span class="field-error <%= errors && errors.sku ? 'show' : '' %>" data-error-for="sku"><%= (errors && errors.sku) || '' %></span>
            </div>
          </div>

          <div class="form-group">
            <label>PRODUCT DESCRIPTION</label>
            <div class="rte-toolbar"><span>B</span><span><i>I</i></span><span>≔</span><span>⛓</span></div>
            <textarea name="full_description" rows="5" placeholder="A luxurious floral bouquet of rose, jasmine, and geranium. Think of it like a rich velvet cloth layered over fresh spring petals." class="<%= errors && errors.full_description ? 'input-invalid' : '' %>"><%= oldInput && oldInput.full_description || '' %></textarea>
            <span class="field-error <%= errors && errors.full_description ? 'show' : '' %>" data-error-for="full_description"><%= (errors && errors.full_description) || '' %></span>
          </div>

          <!--
            NOTE: "Base Price" and "Initial Stock" fields were removed here.
            They now come from the FIRST VARIANT section below — the product's
            price/stock are derived from the variant server-side, so there's
            no longer a second number that can drift out of sync with it.
          -->

          <div class="form-row toggles">
            <div class="form-group">
              <label>STATUS</label>
              <label class="toggle">
                <input type="checkbox" name="status" value="active" checked />
                <span class="toggle-track"><span class="toggle-thumb"></span></span>
                <span class="toggle-text">ACTIVE</span>
              </label>
            </div>
          </div>

          <div class="section-title">ORGANIZATION</div>
          <div class="form-row">
            <div class="form-group">
              <label>BRAND</label>
              <select name="brand_id" class="<%= errors && errors.brand_id ? 'input-invalid' : '' %>">
                <option value="">Select brand</option>
                <% (brands || []).forEach(function(b) { %>
                  <option value="<%= b._id %>" <%= oldInput && oldInput.brand_id === String(b._id) ? 'selected' : '' %>><%= b.name %></option>
                <% }); %>
              </select>
              <span class="field-error <%= errors && errors.brand_id ? 'show' : '' %>" data-error-for="brand_id"><%= (errors && errors.brand_id) || '' %></span>
            </div>
            <div class="form-group">
              <label>CATEGORY</label>
              <select name="category_id" class="<%= errors && errors.category_id ? 'input-invalid' : '' %>">
                <option value="">Select category</option>
                <% (categories || []).forEach(function(c) { %>
                  <option value="<%= c._id %>" <%= oldInput && oldInput.category_id === String(c._id) ? 'selected' : '' %>><%= c.name %></option>
                <% }); %>
              </select>
              <span class="field-error <%= errors && errors.category_id ? 'show' : '' %>" data-error-for="category_id"><%= (errors && errors.category_id) || '' %></span>
            </div>
            <div class="form-group">
              <label>GST RATE</label>
              <select name="gst_rate" id="gstRateSelect">
                <option value="18" <%= (!oldInput || oldInput.gst_rate == '18') ? 'selected' : '' %>>18% (Standard Perfumes)</option>
                <option value="28" <%= (oldInput && oldInput.gst_rate == '28') ? 'selected' : '' %>>28% (Luxury Goods)</option>
                <option value="12" <%= (oldInput && oldInput.gst_rate == '12') ? 'selected' : '' %>>12%</option>
                <option value="5" <%= (oldInput && oldInput.gst_rate == '5') ? 'selected' : '' %>>5%</option>
                <option value="0" <%= (oldInput && oldInput.gst_rate == '0') ? 'selected' : '' %>>0% (Exempt)</option>
              </select>
            </div>
          </div>

          <div class="section-title">FIRST VARIANT (REQUIRED)</div>
          <p style="font-size:12px; color:#8a8a8a; margin-bottom:14px;">
            Every product needs at least one purchasable variant, matching what you'll see in the Variant Manager.
            This variant's price and stock also become the product's listed price and stock.
          </p>
          <div class="form-row">
            <div class="form-group">
              <label>CONCENTRATION</label>
              <input type="text" name="variant_concentration" placeholder="e.g. EDP" value="<%= oldInput && oldInput.variant_concentration || '' %>" class="<%= errors && errors.variant_concentration ? 'input-invalid' : '' %>" />
              <span class="field-error <%= errors && errors.variant_concentration ? 'show' : '' %>" data-error-for="variant_concentration"><%= (errors && errors.variant_concentration) || '' %></span>
            </div>
            <div class="form-group">
              <label>SIZE (ML)</label>
              <input type="number" name="variant_size_ml" min="1" placeholder="100" value="<%= oldInput && oldInput.variant_size_ml || '' %>" class="<%= errors && errors.variant_size_ml ? 'input-invalid' : '' %>" />
              <span class="field-error <%= errors && errors.variant_size_ml ? 'show' : '' %>" data-error-for="variant_size_ml"><%= (errors && errors.variant_size_ml) || '' %></span>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>STOCK LEVEL</label>
              <input type="number" name="variant_quantity" min="0" placeholder="0" value="<%= oldInput && oldInput.variant_quantity || '' %>" class="<%= errors && errors.variant_quantity ? 'input-invalid' : '' %>" />
              <span class="field-error <%= errors && errors.variant_quantity ? 'show' : '' %>" data-error-for="variant_quantity"><%= (errors && errors.variant_quantity) || '' %></span>
            </div>
            <div class="form-group">
              <label>VARIANT PRICE (₹)</label>
              <input type="number" step="0.01" min="0" name="variant_price" placeholder="4400.00" value="<%= oldInput && oldInput.variant_price || '' %>" class="<%= errors && errors.variant_price ? 'input-invalid' : '' %>" />
              <span class="field-error <%= errors && errors.variant_price ? 'show' : '' %>" data-error-for="variant_price"><%= (errors && errors.variant_price) || '' %></span>
            </div>
          </div>

          <div class="form-footer">
            <a href="/admin/products" class="btn-cancel">CANCEL</a>
            <button type="submit" class="btn-save">SAVE PRODUCT</button>
          </div>
        </div>

        <aside class="form-media">
          <div class="section-title">MEDIA</div>
          <label class="dropzone" for="imagesInput">
            <div class="dropzone-icon">⬆</div>
            <div class="dropzone-text">DRAG &amp; DROP PRODUCT IMAGE</div>
            <div class="dropzone-hint">4000 X 4000PX RECOMMENDED · MIN 3 IMAGES</div>
            <span class="dropzone-btn">SELECT FILES</span>
          </label>
          <input id="imagesInput" type="file" name="images" accept="image/*" multiple style="display:none" />

          <div class="image-previews" id="imagePreviews">
            <div class="preview-slot empty">+</div>
            <div class="preview-slot empty">+</div>
            <div class="preview-slot empty">+</div>
          </div>
          <div class="image-count-hint" id="imageCountHint">0 of 3 minimum images selected</div>
        </aside>
      </form>
    </main>
  </div>

  <%- include('../partials/cropperModal') %>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
  <script src="/admin/js/productForm.js" data-mode="add" data-min-images="3"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const form = document.querySelector('.product-form');
      if (!form) return;

      function showError(fieldName, message) {
        const input = document.querySelector(`[name="${fieldName}"]`);
        const errorEl = document.querySelector(`[data-error-for="${fieldName}"]`);
        if (input) input.classList.add('input-invalid');
        if (errorEl) { errorEl.textContent = message; errorEl.classList.add('show'); }
      }

      function clearError(fieldName) {
        const input = document.querySelector(`[name="${fieldName}"]`);
        const errorEl = document.querySelector(`[data-error-for="${fieldName}"]`);
        if (input) input.classList.remove('input-invalid');
        if (errorEl) { errorEl.textContent = ''; errorEl.classList.remove('show'); }
      }

      // ===== Field validation functions =====
      function validateNameField(liveOnly) {
        const input = document.querySelector('[name="name"]');
        if (!input) return true;
        const val = input.value.trim();

        if (!val) {
          showError('name', 'Product name is required.');
          return false;
        }
        if (val.length < 3 || val.length > 100) {
          showError('name', 'Product name must be between 3 and 100 characters.');
          return false;
        }
        const letterCount = (val.match(/[a-zA-Z]/g) || []).length;
        if (letterCount < 3) {
          showError('name', 'Product name must contain letters (symbols or numbers only are not allowed).');
          return false;
        }
        if (/^[-_.,/()&'\s]+$/.test(val)) {
          showError('name', 'Product name cannot consist only of special characters or symbols.');
          return false;
        }
        if (!/^[a-zA-Z0-9\s&',.\-()/]+$/.test(val)) {
          showError('name', "Only letters, numbers, spaces, and (&, ', ., -, /, ()) are allowed.");
          return false;
        }
        const errEl = document.querySelector('[data-error-for="name"]');
        if (errEl && errEl.textContent.includes('already exists')) {
          return false;
        }
        clearError('name');
        return true;
      }

      function validateSkuField() {
        const input = document.querySelector('[name="sku"]');
        if (!input) return true;
        const val = input.value.trim().toUpperCase();

        if (!val) {
          showError('sku', 'SKU is required.');
          return false;
        }
        if (val.length < 3 || val.length > 30) {
          showError('sku', 'SKU must be between 3 and 30 characters.');
          return false;
        }
        const alphanumCount = (val.match(/[A-Z0-9]/g) || []).length;
        if (alphanumCount < 2) {
          showError('sku', 'SKU must contain letters or numbers (e.g. CHANEL-CN-50ML).');
          return false;
        }
        if (/^[-_.\s]+$/.test(val)) {
          showError('sku', 'SKU cannot consist only of symbols.');
          return false;
        }
        if (!/^[A-Z0-9]+([-_][A-Z0-9]+)*$/.test(val)) {
          showError('sku', 'SKU must start and end with letters or numbers, using single hyphens or underscores in between.');
          return false;
        }
        const errEl = document.querySelector('[data-error-for="sku"]');
        if (errEl && errEl.textContent.includes('already taken')) {
          return false;
        }
        clearError('sku');
        return true;
      }

      function validateDescriptionField() {
        const input = document.querySelector('[name="full_description"]');
        if (!input) return true;
        const val = input.value.trim();

        if (!val) {
          showError('full_description', 'Product description is required.');
          return false;
        }
        if (val.length < 15) {
          showError('full_description', 'Product description must be at least 15 characters.');
          return false;
        }
        const letterCount = (val.match(/[a-zA-Z]/g) || []).length;
        if (letterCount < 10) {
          showError('full_description', 'Product description must contain meaningful text with letters.');
          return false;
        }
        clearError('full_description');
        return true;
      }

      function validateBrandField() {
        const val = document.querySelector('[name="brand_id"]')?.value;
        if (!val) { showError('brand_id', 'Please select a brand.'); return false; }
        clearError('brand_id'); return true;
      }

      function validateCategoryField() {
        const val = document.querySelector('[name="category_id"]')?.value;
        if (!val) { showError('category_id', 'Please select a category.'); return false; }
        clearError('category_id'); return true;
      }

      function validateConcentrationField() {
        const input = document.querySelector('[name="variant_concentration"]');
        if (!input) return true;
        const val = input.value.trim();
        if (!val) { showError('variant_concentration', 'Concentration is required.'); return false; }
        if (val.length < 2 || !/[a-zA-Z]/.test(val)) {
          showError('variant_concentration', 'Please enter a valid concentration (e.g. Eau de Parfum).');
          return false;
        }
        clearError('variant_concentration'); return true;
      }

      function validateSizeField() {
        const input = document.querySelector('[name="variant_size_ml"]');
        if (!input) return true;
        const val = input.value.trim();
        const num = Number(val);
        if (!val || isNaN(num) || num <= 0 || !Number.isInteger(num)) {
          showError('variant_size_ml', 'Size must be a positive integer in ml (e.g. 50, 100).');
          return false;
        }
        clearError('variant_size_ml'); return true;
      }

      function validateQuantityField() {
        const input = document.querySelector('[name="variant_quantity"]');
        if (!input) return true;
        const val = input.value.trim();
        const num = Number(val);
        if (val === '' || isNaN(num) || num < 0 || !Number.isInteger(num)) {
          showError('variant_quantity', 'Stock level must be a non-negative integer (0 or more).');
          return false;
        }
        clearError('variant_quantity'); return true;
      }

      function validatePriceField() {
        const input = document.querySelector('[name="variant_price"]');
        if (!input) return true;
        const val = input.value.trim();
        const num = Number(val);
        if (!val || isNaN(num) || num <= 0) {
          showError('variant_price', 'Variant price must be greater than 0.');
          return false;
        }
        clearError('variant_price'); return true;
      }

      function validateImagesField() {
        const imageSlots = document.querySelectorAll('.preview-slot:not(.empty)').length;
        const hint = document.getElementById('imageCountHint');
        if (imageSlots < 3) {
          if (hint) {
            hint.textContent = `${imageSlots} of 3 minimum images selected — please add more.`;
            hint.classList.add('warn');
            hint.classList.remove('ok');
          }
          return false;
        }
        if (hint) {
          hint.textContent = `${imageSlots} images selected (minimum 3 met).`;
          hint.classList.remove('warn');
          hint.classList.add('ok');
        }
        return true;
      }

      // ===== Attach real-time validation listeners =====
      const nameInput = document.querySelector('[name="name"]');
      let nameCheckTimeout = null;
      if (nameInput) {
        nameInput.addEventListener('input', () => {
          clearTimeout(nameCheckTimeout);
          validateNameField(true);
        });
        nameInput.addEventListener('blur', function () {
          if (!validateNameField(false)) return;
          const val = this.value.trim();
          clearTimeout(nameCheckTimeout);
          nameCheckTimeout = setTimeout(async () => {
            try {
              const res = await fetch('/admin/products/check-name?name=' + encodeURIComponent(val));
              const data = await res.json();
              if (data.exists) {
                showError('name', 'A product named "' + val + '" already exists. Please use a different name.');
              }
            } catch (_) { /* ignore network error */ }
          }, 200);
        });
      }

      const skuInput = document.querySelector('[name="sku"]');
      let skuCheckTimeout = null;
      if (skuInput) {
        skuInput.addEventListener('input', () => {
          clearTimeout(skuCheckTimeout);
          validateSkuField();
        });
        skuInput.addEventListener('blur', function () {
          if (!validateSkuField()) return;
          const val = this.value.trim();
          clearTimeout(skuCheckTimeout);
          skuCheckTimeout = setTimeout(async () => {
            try {
              const res = await fetch('/admin/products/check-sku?sku=' + encodeURIComponent(val));
              const data = await res.json();
              if (data.exists) {
                const usedBy = data.usedBy ? ' It is already assigned to ' + data.usedBy + '.' : '';
                showError('sku', 'SKU "' + val.toUpperCase() + '" is already taken.' + usedBy + ' Please use a unique SKU.');
              }
            } catch (_) { /* ignore network error */ }
          }, 200);
        });
      }

      const descInput = document.querySelector('[name="full_description"]');
      if (descInput) {
        descInput.addEventListener('input', validateDescriptionField);
        descInput.addEventListener('blur', validateDescriptionField);
      }
      const brandInput = document.querySelector('[name="brand_id"]');
      if (brandInput) brandInput.addEventListener('change', validateBrandField);
      const catInput = document.querySelector('[name="category_id"]');
      if (catInput) catInput.addEventListener('change', validateCategoryField);

      const concInput = document.querySelector('[name="variant_concentration"]');
      if (concInput) {
        concInput.addEventListener('input', validateConcentrationField);
        concInput.addEventListener('blur', validateConcentrationField);
      }
      const sizeInput = document.querySelector('[name="variant_size_ml"]');
      if (sizeInput) {
        sizeInput.addEventListener('input', validateSizeField);
        sizeInput.addEventListener('blur', validateSizeField);
      }
      const qtyInput = document.querySelector('[name="variant_quantity"]');
      if (qtyInput) {
        qtyInput.addEventListener('input', validateQuantityField);
        qtyInput.addEventListener('blur', validateQuantityField);
      }
      const priceInput = document.querySelector('[name="variant_price"]');
      if (priceInput) {
        priceInput.addEventListener('input', validatePriceField);
        priceInput.addEventListener('blur', validatePriceField);
      }

      // ===== Form submit handler =====
      form.addEventListener('submit', function (e) {
        const isNameOk = validateNameField(false);
        const isSkuOk = validateSkuField();
        const isDescOk = validateDescriptionField();
        const isBrandOk = validateBrandField();
        const isCatOk = validateCategoryField();
        const isConcOk = validateConcentrationField();
        const isSizeOk = validateSizeField();
        const isQtyOk = validateQuantityField();
        const isPriceOk = validatePriceField();
        const isImagesOk = validateImagesField();

        const hasNameErr = document.querySelector('[data-error-for="name"]')?.classList.contains('show');
        const hasSkuErr = document.querySelector('[data-error-for="sku"]')?.classList.contains('show');

        if (!isNameOk || !isSkuOk || !isDescOk || !isBrandOk || !isCatOk ||
            !isConcOk || !isSizeOk || !isQtyOk || !isPriceOk || !isImagesOk ||
            hasNameErr || hasSkuErr) {
          e.preventDefault();
          const firstInvalid = document.querySelector('.input-invalid');
          if (firstInvalid) {
            firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
            firstInvalid.focus();
          }
        }
      });

      // ── Image persistence: restore on server-error re-render ──────────────
      <% if (typeof errors !== 'undefined' && errors && Object.keys(errors).length > 0) { %>
        // Server returned validation errors — restore previously selected images
        if (typeof window.restoreImagesFromSession === 'function') {
          window.restoreImagesFromSession();
        }
      <% } else { %>
        // Fresh page load (no errors) — clear any stale saved images
        sessionStorage.removeItem('addProduct_images');
      <% } %>
    });


  </script>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Coupon — Essence Admin</title>
  <link rel="stylesheet" href="/admin/dashboard.css">
  <link rel="stylesheet" href="/admin/partials/sidebar.css">
  <style>
    .edit-card {
      background:#fff; border:1px solid #f0f0f0;
      max-width:620px; padding:2rem;
    }
    .form-row { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
    .form-group { margin-bottom:1.1rem; }
    .form-group label {
      display:block; font-size:0.72rem; font-weight:600;
      letter-spacing:0.07em; text-transform:uppercase; color:#6b7280; margin-bottom:0.4rem;
    }
    .form-group input,
    .form-group select {
      width:100%; padding:0.65rem 0.75rem; border:1px solid #e5e7eb;
      font-size:0.875rem; color:#111; outline:none; background:#fff;
      transition:border-color .15s; box-sizing:border-box;
    }
    .form-group input:focus,
    .form-group select:focus { border-color:#111; }
    .form-hint { font-size:0.7rem; color:#9ca3af; margin-top:0.25rem; }
    .code-display {
      font-size:1.4rem; font-weight:700; letter-spacing:0.08em;
      color:#111; margin-bottom:0.25rem;
    }
    .code-note { font-size:0.75rem; color:#9ca3af; margin-bottom:2rem; }
    .form-actions { display:flex; gap:0.75rem; margin-top:1.5rem; }
    .btn-save {
      padding:0.65rem 1.5rem; background:#111; color:#fff; border:none;
      font-size:0.78rem; font-weight:600; letter-spacing:0.06em;
      text-transform:uppercase; cursor:pointer;
    }
    .btn-save:hover { background:#333; }
    .btn-back {
      padding:0.65rem 1.2rem; border:1px solid #e5e7eb; background:#fff;
      font-size:0.78rem; font-weight:600; letter-spacing:0.06em;
      text-transform:uppercase; cursor:pointer; text-decoration:none; color:#374151;
    }
    .btn-back:hover { border-color:#111; color:#111; }
    .field-error {
      font-size:0.72rem; color:#dc2626; margin-top:0.3rem; display:none;
    }
    .input-error {
      border-color:#dc2626 !important;
      background:#fff8f8 !important;
    }
  </style>
</head>
<body>
  <%- include('../partials/sidebar', { activePage: 'coupons' }) %>

  <main class="main-content">
    <div style="padding:2rem 2.5rem;">

      <div style="margin-bottom:1.75rem;">
        <a href="/admin/coupons" style="font-size:0.8rem; color:#6b7280; text-decoration:none;">
          ← Back to Coupons
        </a>
      </div>

      <div class="edit-card">
        <% if (locals.query && locals.query.error === 'invalid_desc') { %>
          <div style="background:#fef2f2; border:1px solid #fecaca; color:#dc2626; padding:0.8rem 1rem; margin-bottom:1.2rem; font-size:0.82rem; font-weight:500;">
            ⚠ Invalid description. Must contain at least 3 letters/numbers (symbols only like "----------" are not allowed).
          </div>
        <% } else if (locals.query && locals.query.error === 'invalid_value') { %>
          <div style="background:#fef2f2; border:1px solid #fecaca; color:#dc2626; padding:0.8rem 1rem; margin-bottom:1.2rem; font-size:0.82rem; font-weight:500;">
            ⚠ Invalid discount value. Must be greater than 0 (and ≤ 100% for percentage).
          </div>
        <% } else if (locals.query && locals.query.error === 'fixed_gt_min') { %>
          <div style="background:#fef2f2; border:1px solid #fecaca; color:#dc2626; padding:0.8rem 1rem; margin-bottom:1.2rem; font-size:0.82rem; font-weight:500;">
            ⚠ Fixed discount cannot be equal to or greater than the minimum order value.
          </div>
        <% } else if (locals.query && locals.query.error === 'invalid_max_cap') { %>
          <div style="background:#fef2f2; border:1px solid #fecaca; color:#dc2626; padding:0.8rem 1rem; margin-bottom:1.2rem; font-size:0.82rem; font-weight:500;">
            ⚠ Maximum discount cap is required and must be greater than 0 for percentage discounts.
          </div>
        <% } else if (locals.query && locals.query.error === 'invalid_limit') { %>
          <div style="background:#fef2f2; border:1px solid #fecaca; color:#dc2626; padding:0.8rem 1rem; margin-bottom:1.2rem; font-size:0.82rem; font-weight:500;">
            ⚠ Usage limit per user is required and must be a positive integer (at least 1).
          </div>
        <% } else if (locals.query && locals.query.error === 'invalid_total_limit') { %>
          <div style="background:#fef2f2; border:1px solid #fecaca; color:#dc2626; padding:0.8rem 1rem; margin-bottom:1.2rem; font-size:0.82rem; font-weight:500;">
            ⚠ Total usage limit must be a positive integer (at least 1).
          </div>
        <% } else if (locals.query && locals.query.error === 'invalid_date') { %>
          <div style="background:#fef2f2; border:1px solid #fecaca; color:#dc2626; padding:0.8rem 1rem; margin-bottom:1.2rem; font-size:0.82rem; font-weight:500;">
            ⚠ Expiry date cannot be in the past.
          </div>
        <% } else if (locals.query && locals.query.error) { %>
          <div style="background:#fef2f2; border:1px solid #fecaca; color:#dc2626; padding:0.8rem 1rem; margin-bottom:1.2rem; font-size:0.82rem; font-weight:500;">
            ⚠ Failed to update coupon. Please check your inputs and try again.
          </div>
        <% } %>

        <p class="code-display"><%= coupon.code %></p>
        <p class="code-note">Coupon code cannot be changed after creation.</p>

        <form id="editForm" method="POST" action="/admin/coupons/<%= coupon._id %>/edit" novalidate>

          <!-- Description -->
          <div class="form-group">
            <label>Description *</label>
            <input type="text" id="e-desc" name="description"
              maxlength="100"
              value="<%= coupon.description %>"
              oninput="clearErr('e-err-desc')">
            <p class="form-hint">Describe this promotion (minimum 3 characters, no symbols-only).</p>
            <span class="field-error" id="e-err-desc">Description is required.</span>
          </div>

          <!-- Discount type + value -->
          <div class="form-row">
            <div class="form-group">
              <label>Discount Type *</label>
              <select name="discount_type" id="editDiscType" onchange="onTypeChange()">
                <option value="percentage" <%= coupon.discount_type === 'percentage' ? 'selected' : '' %>>Percentage (%)</option>
                <option value="fixed"      <%= coupon.discount_type === 'fixed'      ? 'selected' : '' %>>Fixed Amount (₹)</option>
              </select>
            </div>
            <div class="form-group">
              <label>Discount Value *</label>
              <input type="number" id="e-disc-val" name="discount_value"
                min="0.01" step="0.01"
                value="<%= coupon.discount_value %>"
                oninput="clearErr('e-err-disc-val')">
              <span class="field-error" id="e-err-disc-val">Enter a valid discount value greater than 0.</span>
            </div>
          </div>

          <!-- Min order + Max cap -->
          <div class="form-row">
            <div class="form-group">
              <label>Min Order Value (₹) *</label>
              <input type="number" id="e-min-order" name="min_order_value"
                min="0" step="0.01"
                value="<%= coupon.min_order_value !== undefined ? coupon.min_order_value : '' %>"
                placeholder="0"
                oninput="clearErr('e-err-min-order')">
              <p class="form-hint">Enter 0 if there is no minimum order requirement.</p>
              <span class="field-error" id="e-err-min-order">Min order value is required.</span>
            </div>
            <div class="form-group" id="editMaxCapGroup" style="<%= coupon.discount_type === 'fixed' ? 'display:none;' : '' %>">
              <label>Max Discount Cap (₹) *</label>
              <input type="number" id="e-max-cap" name="max_discount_amount"
                min="0.01" step="0.01"
                value="<%= coupon.max_discount_amount || '' %>"
                placeholder="e.g. 500"
                oninput="clearErr('e-err-max-cap')">
              <p class="form-hint">Max amount deducted for percentage discounts.</p>
              <span class="field-error" id="e-err-max-cap">Max discount cap is required for percentage discounts.</span>
            </div>
          </div>

          <!-- Usage Limits -->
          <div class="form-row">
            <div class="form-group">
              <label>Usage Limit Per User *</label>
              <input type="number" id="e-limit-user" name="usage_limit_per_user"
                min="1" step="1"
                value="<%= coupon.usage_limit_per_user || 1 %>"
                placeholder="1"
                oninput="clearErr('e-err-limit-user')">
              <p class="form-hint">How many times each customer can redeem this coupon.</p>
              <span class="field-error" id="e-err-limit-user">Usage limit per user must be at least 1.</span>
            </div>
            <div class="form-group">
              <label>Total Usage Limit <span style="color:#9ca3af;font-weight:400">(optional)</span></label>
              <input type="number" id="e-limit-total" name="total_usage_limit"
                min="1" step="1"
                value="<%= coupon.total_usage_limit || '' %>"
                placeholder="Leave blank for unlimited"
                oninput="clearErr('e-err-limit-total')">
              <p class="form-hint">Total redemptions across all customers.</p>
              <span class="field-error" id="e-err-limit-total">Total usage limit must be at least 1.</span>
            </div>
          </div>

          <!-- Valid until + Status -->
          <div class="form-row">
            <div class="form-group">
              <label>Valid Until <span style="color:#9ca3af;font-weight:400">(optional)</span></label>
              <input type="date" id="e-valid" name="valid_until"
                min="<%= new Date().toISOString().split('T')[0] %>"
                value="<%= coupon.valid_until || '' %>"
                oninput="clearErr('e-err-valid')">
              <span class="field-error" id="e-err-valid">Expiry date must be today or in the future.</span>
            </div>
            <div class="form-group">
              <label>Status</label>
              <select name="is_active">
                <option value="true"  <%= coupon.is_active  ? 'selected' : '' %>>Active</option>
                <option value="false" <%= !coupon.is_active ? 'selected' : '' %>>Inactive</option>
              </select>
            </div>
          </div>

          <div class="form-actions">
            <a href="/admin/coupons" class="btn-back">Cancel</a>
            <button type="button" class="btn-save" onclick="submitEditForm()">Save Changes</button>
          </div>

        </form>
      </div>
    </div>
  </main>

  <script>
    // Show/hide max cap group when type changes
    function onTypeChange() {
      const type  = document.getElementById('editDiscType').value;
      const group = document.getElementById('editMaxCapGroup');
      if (group) group.style.display = type === 'fixed' ? 'none' : '';
    }

    function clearErr(errId) {
      const err = document.getElementById(errId);
      if (!err) return;
      err.style.display = 'none';
      let prev = err.previousElementSibling;
      while (prev && prev.tagName === 'P') prev = prev.previousElementSibling;
      if (prev && (prev.tagName === 'INPUT' || prev.tagName === 'SELECT')) {
        prev.classList.remove('input-error');
      }
    }

    function showErr(inputId, errId, msg) {
      const input = document.getElementById(inputId);
      const err   = document.getElementById(errId);
      if (input) input.classList.add('input-error');
      if (err)   { if (msg) err.textContent = msg; err.style.display = 'block'; }
    }

    function submitEditForm() {
      let valid = true;

      // 1. Description
      const descInput = document.getElementById('e-desc');
      const cleanDesc = descInput.value.trim();
      const descAlphanumCount = cleanDesc.replace(/[^a-zA-Z0-9]/g, '').length;

      if (!cleanDesc) {
        showErr('e-desc', 'e-err-desc', 'Description is required.');
        valid = false;
      } else if (cleanDesc.length < 3 || cleanDesc.length > 100) {
        showErr('e-desc', 'e-err-desc', 'Description must be between 3 and 100 characters.');
        valid = false;
      } else if (descAlphanumCount < 3) {
        showErr('e-desc', 'e-err-desc', 'Description must contain actual words/letters, not just symbols (e.g. "----------").');
        valid = false;
      } else { clearErr('e-err-desc'); }

      // 2. Discount value
      const discInput = document.getElementById('e-disc-val');
      const dv = parseFloat(discInput.value);
      const discType = document.getElementById('editDiscType').value;

      if (!discInput.value || isNaN(dv) || dv <= 0) {
        showErr('e-disc-val', 'e-err-disc-val', 'Enter a valid discount value greater than 0.');
        valid = false;
      } else if (discType === 'percentage' && dv > 100) {
        showErr('e-disc-val', 'e-err-disc-val', 'Percentage discount cannot exceed 100%.');
        valid = false;
      } else { clearErr('e-err-disc-val'); }

      // 3. Min Order Value — required, >= 0
      const minOrder = document.getElementById('e-min-order');
      const mov = minOrder.value !== '' ? parseFloat(minOrder.value) : 0;
      if (minOrder.value === '' || minOrder.value === null || isNaN(mov) || mov < 0) {
        showErr('e-min-order', 'e-err-min-order', 'Min order value is required and cannot be negative. Enter 0 if no minimum.');
        valid = false;
      } else if (discType === 'fixed' && mov > 0 && dv >= mov) {
        showErr('e-disc-val', 'e-err-disc-val', 'Fixed discount (₹' + dv + ') must be less than min order value (₹' + mov + ').');
        valid = false;
      } else { clearErr('e-err-min-order'); }

      // 4. Max Discount Cap — required only for percentage
      if (discType === 'percentage') {
        const maxCap = document.getElementById('e-max-cap');
        const capVal = parseFloat(maxCap.value);
        if (!maxCap.value || isNaN(capVal) || capVal <= 0) {
          showErr('e-max-cap', 'e-err-max-cap', 'Max discount cap is required and must be greater than 0 for percentage discounts.');
          valid = false;
        } else { clearErr('e-err-max-cap'); }
      } else {
        clearErr('e-err-max-cap');
      }

      // 5. Valid Until — if filled, must not be in the past
      const validUntil = document.getElementById('e-valid');
      if (validUntil.value) {
        const chosen = new Date(validUntil.value);
        const today  = new Date(); today.setHours(0, 0, 0, 0);
        if (chosen < today) {
          showErr('e-valid', 'e-err-valid', 'Expiry date must be today or in the future.');
          valid = false;
        } else { clearErr('e-err-valid'); }
      } else {
        clearErr('e-err-valid');
      }

      // 6. Usage Limit Per User
      const userLimitInput = document.getElementById('e-limit-user');
      const userLimitVal = parseInt(userLimitInput.value, 10);
      if (!userLimitInput.value || isNaN(userLimitVal) || userLimitVal < 1) {
        showErr('e-limit-user', 'e-err-limit-user', 'Usage limit per user is required and must be at least 1.');
        valid = false;
      } else { clearErr('e-err-limit-user'); }

      // 7. Total Usage Limit (optional)
      const totalLimitInput = document.getElementById('e-limit-total');
      if (totalLimitInput.value) {
        const totalLimitVal = parseInt(totalLimitInput.value, 10);
        if (isNaN(totalLimitVal) || totalLimitVal < 1) {
          showErr('e-limit-total', 'e-err-limit-total', 'Total usage limit must be at least 1.');
          valid = false;
        } else if (userLimitVal > totalLimitVal) {
          showErr('e-limit-total', 'e-err-limit-total', 'Total limit cannot be smaller than per-user limit.');
          valid = false;
        } else { clearErr('e-err-limit-total'); }
      } else { clearErr('e-err-limit-total'); }

      if (valid) {
        document.getElementById('editForm').submit();
      }
    }
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Coupons — Essence Admin</title>
  <link rel="stylesheet" href="/admin/dashboard.css">
  <link rel="stylesheet" href="/admin/partials/sidebar.css">
  <style>
    /* ── Page layout ── */
    .page-header { display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:2rem; gap:1rem; flex-wrap:wrap; }
    .page-title  { font-size:2rem; font-weight:700; letter-spacing:-0.02em; margin:0 0 0.25rem; }
    .page-sub    { font-size:0.85rem; color:#6b7280; margin:0; max-width:260px; line-height:1.5; }

    .btn-add {
      display:inline-flex; align-items:center; gap:0.4rem;
      background:#111; color:#fff; border:none;
      padding:0.7rem 1.4rem; font-size:0.78rem; font-weight:600;
      letter-spacing:0.06em; text-transform:uppercase; cursor:pointer;
      text-decoration:none; white-space:nowrap;
      transition:background .15s;
    }
    .btn-add:hover { background:#333; }

    /* ── Search ── */
    .search-bar {
      position:relative; margin-bottom:1.5rem;
    }
    .search-bar svg {
      position:absolute; left:1rem; top:50%; transform:translateY(-50%);
      color:#9ca3af; pointer-events:none;
    }
    .search-input {
      width:100%; padding:0.75rem 1rem 0.75rem 2.75rem;
      border:1px solid #e5e7eb; background:#f9fafb;
      font-size:0.875rem; outline:none; color:#111;
      transition:border-color .15s;
    }
    .search-input:focus { border-color:#111; background:#fff; }

    /* ── Flash messages ── */
    .flash { padding:0.7rem 1.1rem; margin-bottom:1.2rem; font-size:0.83rem; border-left:3px solid; }
    .flash-success { background:#f0fdf4; border-color:#22c55e; color:#166534; }
    .flash-error   { background:#fef2f2; border-color:#ef4444; color:#991b1b; }

    /* ── Table ── */
    .coupon-table { width:100%; border-collapse:collapse; }
    .coupon-table th {
      font-size:0.68rem; font-weight:600; letter-spacing:0.08em;
      color:#9ca3af; text-transform:uppercase; padding:0.75rem 1rem;
      border-bottom:1px solid #f0f0f0; text-align:left; white-space:nowrap;
    }
    .coupon-table td {
      padding:1rem 1rem; border-bottom:1px solid #f7f7f7;
      font-size:0.85rem; vertical-align:middle;
    }
    .coupon-table tr:last-child td { border-bottom:none; }
    .coupon-table tr:hover td { background:#fafafa; }

    .code-cell { font-weight:700; font-size:0.9rem; letter-spacing:0.04em; }
    .disc-value { font-weight:700; }
    .disc-type  { font-size:0.7rem; font-weight:600; letter-spacing:0.08em; color:#9ca3af; text-transform:uppercase; margin-top:2px; }

    /* Progress bar */
    .usage-wrap  { min-width:100px; }
    .usage-label { font-size:0.75rem; color:#6b7280; margin-bottom:4px; }
    .usage-bar   { height:4px; background:#e5e7eb; border-radius:2px; overflow:hidden; }
    .usage-fill  { height:100%; background:#111; border-radius:2px; transition:width .3s; }
    .usage-pct   { font-size:0.7rem; color:#6b7280; margin-top:3px; }

    .expiry-cell { font-size:0.82rem; white-space:nowrap; color:#374151; }
    .expiry-none { color:#d1d5db; }

    /* Status badge */
    .badge {
      display:inline-block; padding:0.25rem 0.7rem;
      font-size:0.65rem; font-weight:700; letter-spacing:0.1em;
      text-transform:uppercase; border-radius:2px;
    }
    .badge-active   { background:#111; color:#fff; }
    .badge-inactive { background:#e5e7eb; color:#9ca3af; }

    /* Actions */
    .action-btns { display:flex; align-items:center; gap:0.5rem; }
    .action-btn {
      background:none; border:1px solid #e5e7eb; padding:0.35rem 0.55rem;
      cursor:pointer; color:#6b7280; border-radius:2px;
      transition:all .15s; text-decoration:none; display:inline-flex;
      align-items:center; justify-content:center;
    }
    .action-btn:hover { border-color:#111; color:#111; }
    .action-btn.del:hover { border-color:#ef4444; color:#ef4444; }

    /* Pagination */
    .pagination { display:flex; align-items:center; gap:0.4rem; justify-content:flex-end; margin-top:1.5rem; }
    .page-btn {
      width:32px; height:32px; display:flex; align-items:center; justify-content:center;
      border:1px solid #e5e7eb; background:#fff; font-size:0.8rem;
      cursor:pointer; text-decoration:none; color:#374151;
      transition:all .15s; border-radius:2px;
    }
    .page-btn.active { background:#111; color:#fff; border-color:#111; }
    .page-btn:hover:not(.active):not(.disabled) { border-color:#111; color:#111; }
    .page-btn.disabled { opacity:0.4; pointer-events:none; }

    .table-footer { display:flex; align-items:center; justify-content:space-between; margin-top:1.25rem; }
    .showing-text { font-size:0.78rem; color:#9ca3af; }

    /* Modal */
    .modal-overlay {
      position:fixed; inset:0; background:rgba(0,0,0,0.5);
      z-index:1000; display:none; align-items:center; justify-content:center;
    }
    .modal-overlay.open { display:flex; }
    .modal {
      background:#fff; width:100%; max-width:520px;
      padding:2rem; position:relative; margin:1rem;
    }
    .modal-title { font-size:1.1rem; font-weight:700; margin:0 0 1.5rem; }
    .modal-close {
      position:absolute; top:1rem; right:1rem;
      background:none; border:none; font-size:1.2rem; cursor:pointer; color:#9ca3af;
    }
    .modal-close:hover { color:#111; }
    .form-row { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
    .form-group { margin-bottom:1.1rem; }
    .form-group label {
      display:block; font-size:0.72rem; font-weight:600;
      letter-spacing:0.07em; text-transform:uppercase; color:#6b7280; margin-bottom:0.4rem;
    }
    .form-group input,
    .form-group select {
      width:100%; padding:0.6rem 0.75rem; border:1px solid #e5e7eb;
      font-size:0.875rem; color:#111; outline:none; background:#fff;
      transition:border-color .15s; box-sizing:border-box;
    }
    .form-group input:focus,
    .form-group select:focus { border-color:#111; }
    .form-hint { font-size:0.7rem; color:#9ca3af; margin-top:0.25rem; }
    .modal-actions { display:flex; gap:0.75rem; justify-content:flex-end; margin-top:1.5rem; }
    .btn-cancel {
      padding:0.6rem 1.2rem; border:1px solid #e5e7eb; background:#fff;
      font-size:0.78rem; font-weight:600; cursor:pointer; letter-spacing:0.05em;
      text-transform:uppercase;
    }
    .btn-save {
      padding:0.6rem 1.4rem; background:#111; color:#fff; border:none;
      font-size:0.78rem; font-weight:600; cursor:pointer; letter-spacing:0.05em;
      text-transform:uppercase;
    }
    .btn-save:hover { background:#333; }

    /* Inline validation */
    .field-error {
      font-size:0.72rem; color:#dc2626; margin-top:0.3rem; display:none;
    }
    .input-error {
      border-color:#dc2626 !important;
      background:#fff8f8 !important;
    }
  </style>
</head>
<body>
  <%- include('../partials/sidebar', { activePage: 'coupons' }) %>

  <main class="main-content">
    <div style="padding:2rem 2.5rem;">

      <!-- Flash messages -->
      <% if (query && query.created) { %>
        <div class="flash flash-success">✓ Coupon created successfully.</div>
      <% } else if (query && query.updated) { %>
        <div class="flash flash-success">✓ Coupon updated successfully.</div>
      <% } else if (query && query.error === 'duplicate') { %>
        <div class="flash flash-error">⚠ A coupon with that code already exists. Please choose a different code.</div>
      <% } else if (query && query.error === 'invalid_code') { %>
        <div class="flash flash-error">⚠ Invalid coupon code. Code must be 3–15 characters and contain letters/numbers (symbols only like "----------" are not allowed).</div>
      <% } else if (query && query.error === 'invalid_desc') { %>
        <div class="flash flash-error">⚠ Invalid description. It must be at least 3 characters and contain meaningful words (not just symbols).</div>
      <% } else if (query && query.error === 'invalid_value') { %>
        <div class="flash flash-error">⚠ Invalid discount value. Percentage must be between 1% and 100%, and fixed amount must be greater than 0.</div>
      <% } else if (query && query.error === 'invalid_min_order') { %>
        <div class="flash flash-error">⚠ Minimum order value cannot be negative.</div>
      <% } else if (query && query.error === 'fixed_gt_min') { %>
        <div class="flash flash-error">⚠ Fixed discount cannot be equal to or greater than the minimum order value.</div>
      <% } else if (query && query.error === 'invalid_max_cap') { %>
        <div class="flash flash-error">⚠ Maximum discount cap must be greater than 0 for percentage discounts.</div>
      <% } else if (query && query.error === 'invalid_limit') { %>
        <div class="flash flash-error">⚠ Usage limit per user must be a positive integer (at least 1).</div>
      <% } else if (query && query.error === 'invalid_total_limit') { %>
        <div class="flash flash-error">⚠ Total usage limit must be a positive integer (at least 1).</div>
      <% } else if (query && query.error === 'invalid_date') { %>
        <div class="flash flash-error">⚠ Expiry date must be today or in the future.</div>
      <% } else if (query && query.error) { %>
        <div class="flash flash-error">⚠ Something went wrong. Please check your inputs and try again.</div>
      <% } %>

      <!-- Page header -->
      <div class="page-header">
        <div>
          <h1 class="page-title">COUPONS</h1>
          <p class="page-sub">Manage and organize your discount codes and promotions.</p>
        </div>
        <button class="btn-add" onclick="openAddModal()">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add Coupon
        </button>
      </div>

      <!-- Search -->
      <form method="GET" action="/admin/coupons" class="search-bar">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input
          type="text"
          name="search"
          class="search-input"
          placeholder="Search coupons by code..."
          value="<%= search || '' %>"
          autocomplete="off"
        >
      </form>

      <!-- Table -->
      <div style="background:#fff; border:1px solid #f0f0f0;">
        <table class="coupon-table">
          <thead>
            <tr>
              <th>Code</th>
              <th>Discount</th>
              <th>Min Purchase / Max Disc.</th>
              <th>Usage</th>
              <th>Expiry Date</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!coupons.length) { %>
              <tr>
                <td colspan="7" style="text-align:center; padding:3rem; color:#9ca3af; font-size:0.875rem;">
                  No coupons found.
                  <% if (search) { %> Try a different search term. <% } %>
                </td>
              </tr>
            <% } %>
            <% coupons.forEach(function(c) {
                const pct = c.used_count ? 100 : 0; /* no usage_limit in schema yet */
                const expiryStr = c.valid_until
                  ? new Date(c.valid_until).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' })
                  : null;
                const isExpired = c.valid_until && new Date(c.valid_until) < new Date();
            %>
            <tr>
              <td class="code-cell"><%= c.code %></td>
              <td>
                <div class="disc-value">
                  <% if (c.discount_type === 'percentage') { %>
                    <%= c.discount_value %>% OFF
                  <% } else { %>
                    ₹<%= c.discount_value.toLocaleString('en-IN') %> OFF
                  <% } %>
                </div>
                <div class="disc-type"><%= c.discount_type %></div>
              </td>
              <td>
                <% if (c.min_order_value > 0) { %>
                  <span style="font-size:0.8rem;">Min: ₹<%= c.min_order_value.toLocaleString('en-IN') %></span><br>
                <% } else { %>
                  <span style="color:#d1d5db; font-size:0.8rem;">—</span><br>
                <% } %>
                <% if (c.max_discount_amount > 0) { %>
                  <span style="font-size:0.75rem; color:#6b7280;">Max: ₹<%= c.max_discount_amount.toLocaleString('en-IN') %></span>
                <% } %>
              </td>
              <td>
                <div class="usage-wrap">
                  <div class="usage-label">
                    <%= c.used_count %> uses
                    <% if (c.total_usage_limit) { %> / <%= c.total_usage_limit %><% } %>
                  </div>
                  <div class="usage-bar">
                    <div class="usage-fill" style="width:<%= c.total_usage_limit ? Math.min(100, Math.round((c.used_count / c.total_usage_limit) * 100)) : Math.min(100, c.used_count) %>%;"></div>
                  </div>
                  <span style="font-size:0.7rem; color:#6b7280; display:block; margin-top:3px;">
                    Limit: <%= c.usage_limit_per_user || 1 %>/user
                  </span>
                </div>
              </td>
              <td class="expiry-cell">
                <% if (expiryStr) { %>
                  <span style="<%= isExpired ? 'color:#ef4444;' : '' %>"><%= expiryStr %><% if (isExpired) { %> <span style="font-size:0.65rem;">(expired)</span><% } %></span>
                <% } else { %>
                  <span class="expiry-none">—</span>
                <% } %>
              </td>
              <td>
                <span class="badge <%= c.is_active ? 'badge-active' : 'badge-inactive' %>">
                  <%= c.is_active ? 'Active' : 'Inactive' %>
                </span>
              </td>
              <td>
                <div class="action-btns">
                  <a href="/admin/coupons/<%= c._id %>/edit" class="action-btn" title="Edit">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </a>
                  <button class="action-btn del" title="Delete" onclick="deleteCoupon('<%= c._id %>', '<%= c.code %>')">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                  </button>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- Footer: count + pagination -->
      <div class="table-footer">
        <span class="showing-text">
          Showing <%= ((page-1)*8)+1 %>–<%= Math.min(page*8, total) %> of <%= total %> coupon<%= total !== 1 ? 's' : '' %>
        </span>
        <% if (totalPages > 1) { %>
        <div class="pagination">
          <a href="?page=<%= page-1 %>&search=<%= search %>" class="page-btn <%= page <= 1 ? 'disabled' : '' %>">‹</a>
          <% for (let p = 1; p <= totalPages; p++) { %>
            <a href="?page=<%= p %>&search=<%= search %>" class="page-btn <%= p === page ? 'active' : '' %>"><%= p %></a>
          <% } %>
          <a href="?page=<%= page+1 %>&search=<%= search %>" class="page-btn <%= page >= totalPages ? 'disabled' : '' %>">›</a>
        </div>
        <% } %>
      </div>

    </div>
  </main>

  <!-- ── Add Coupon Modal ──────────────────────────────────────────────────── -->
  <div class="modal-overlay" id="addModal">
    <div class="modal">
      <button type="button" class="modal-close" onclick="closeAddModal()">✕</button>
      <h2 class="modal-title">Add New Coupon</h2>
      <form id="addCouponForm" method="POST" action="/admin/coupons" novalidate>

        <div class="form-row">
          <div class="form-group">
            <label>Code *</label>
            <input
              type="text" id="f-code" name="code"
              placeholder="e.g. SAVE20"
              maxlength="15"
              autocomplete="off" spellcheck="false"
              oninput="this.value=this.value.toUpperCase().replace(/\s+/g, ''); clearErr('err-code')"
            >
            <p class="form-hint">3–15 uppercase letters/numbers. Cannot be only symbols.</p>
            <span class="field-error" id="err-code">Coupon code is required.</span>
          </div>
          <div class="form-group">
            <label>Discount Type *</label>
            <select name="discount_type" id="addDiscType" onchange="toggleMaxDisc('add')">
              <option value="percentage">Percentage (%)</option>
              <option value="fixed">Fixed Amount (₹)</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label>Description *</label>
          <input
            type="text" id="f-desc" name="description"
            placeholder="e.g. Summer sale 20% off"
            maxlength="100"
            oninput="clearErr('err-desc')"
          >
          <p class="form-hint">Describe this promotion (minimum 3 characters, no symbols-only).</p>
          <span class="field-error" id="err-desc">Description is required.</span>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Discount Value *</label>
            <input
              type="number" id="f-disc-val" name="discount_value"
              min="0.01" step="0.01" placeholder="20"
              oninput="clearErr('err-disc-val')"
            >
            <p class="form-hint">Enter % for percentage, or ₹ amount for fixed.</p>
            <span class="field-error" id="err-disc-val">Enter a valid discount value greater than 0.</span>
          </div>
          <div class="form-group">
            <label>Min Order Value (₹) <span style="color:#9ca3af;font-weight:400">(optional)</span></label>
            <input
              type="number" id="f-min-order" name="min_order_value"
              min="0" step="0.01" placeholder="0"
              oninput="clearErr('err-min-order')"
            >
            <p class="form-hint">Enter 0 if there is no minimum requirement.</p>
            <span class="field-error" id="err-min-order">Min order value cannot be negative.</span>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group" id="addMaxDiscGroup">
            <label>Max Discount Cap (₹) *</label>
            <input
              type="number" id="f-max-cap" name="max_discount_amount"
              min="0.01" step="0.01" placeholder="e.g. 500"
              oninput="clearErr('err-max-cap')"
            >
            <p class="form-hint">Required maximum discount cap for percentage discounts.</p>
            <span class="field-error" id="err-max-cap">Max discount cap is required for percentage discounts.</span>
          </div>
          <div class="form-group">
            <label>Valid Until <span style="color:#9ca3af;font-weight:400">(optional)</span></label>
            <input type="date" id="f-valid" name="valid_until" min="<%= new Date().toISOString().split('T')[0] %>" oninput="clearErr('err-valid')">
            <p class="form-hint">Leave blank for no expiration date.</p>
            <span class="field-error" id="err-valid">Expiry date must be today or in the future.</span>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Usage Limit Per User *</label>
            <input
              type="number" id="f-limit-user" name="usage_limit_per_user"
              min="1" step="1" value="1" placeholder="1"
              oninput="clearErr('err-limit-user')"
            >
            <p class="form-hint">How many times each customer can redeem this code (default: 1).</p>
            <span class="field-error" id="err-limit-user">Usage limit per user must be at least 1.</span>
          </div>
          <div class="form-group">
            <label>Total Usage Limit <span style="color:#9ca3af;font-weight:400">(optional)</span></label>
            <input
              type="number" id="f-limit-total" name="total_usage_limit"
              min="1" step="1" placeholder="Leave blank for unlimited"
              oninput="clearErr('err-limit-total')"
            >
            <p class="form-hint">Total overall redemptions across all users.</p>
            <span class="field-error" id="err-limit-total">Total usage limit must be at least 1.</span>
          </div>
        </div>

        <div class="form-group">
          <label>Status</label>
          <select name="is_active">
            <option value="true">Active</option>
            <option value="false">Inactive</option>
          </select>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn-cancel" onclick="closeAddModal()">Cancel</button>
          <button type="button" class="btn-save" onclick="submitAddCoupon()">Create Coupon</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openAddModal()  { document.getElementById('addModal').classList.add('open'); }
    function closeAddModal() {
      document.getElementById('addModal').classList.remove('open');
      // Clear all errors when closing
      document.querySelectorAll('#addCouponForm .field-error').forEach(function(el) { el.style.display = 'none'; });
      document.querySelectorAll('#addCouponForm .input-error').forEach(function(el) { el.classList.remove('input-error'); });
    }

    // Close on backdrop click
    document.getElementById('addModal').addEventListener('click', function(e) {
      if (e.target === this) closeAddModal();
    });

    // Show/hide max discount cap field based on type
    function toggleMaxDisc(prefix) {
      const type  = document.getElementById(prefix + 'DiscType').value;
      const group = document.getElementById(prefix + 'MaxDiscGroup');
      if (group) group.style.display = type === 'fixed' ? 'none' : '';
    }

    // Helper to clear a single field error
    function clearErr(id) {
      const el = document.getElementById(id);
      if (el) el.style.display = 'none';
      let prev = el && el.previousElementSibling;
      while (prev && prev.tagName === 'P') prev = prev.previousElementSibling;
      if (prev && (prev.tagName === 'INPUT' || prev.tagName === 'SELECT')) {
        prev.classList.remove('input-error');
      }
    }

    // Helper to show a single field error
    function showErr(inputId, errId, msg) {
      const input = document.getElementById(inputId);
      const err   = document.getElementById(errId);
      if (input) input.classList.add('input-error');
      if (err)   { if (msg) err.textContent = msg; err.style.display = 'block'; }
      return false;
    }

    // Validate and submit the Add Coupon form
    function submitAddCoupon() {
      let valid = true;

      // 1. Code
      const codeInput = document.getElementById('f-code');
      const cleanCode = codeInput.value.trim().toUpperCase();
      const codeAlphanumCount = cleanCode.replace(/[^A-Z0-9]/g, '').length;

      if (!cleanCode) {
        showErr('f-code', 'err-code', 'Coupon code is required.');
        valid = false;
      } else if (cleanCode.length < 3 || cleanCode.length > 15) {
        showErr('f-code', 'err-code', 'Coupon code must be between 3 and 15 characters.');
        valid = false;
      } else if (codeAlphanumCount < 3) {
        showErr('f-code', 'err-code', 'Code must contain at least 3 letters or numbers (symbols only like "----------" are not allowed).');
        valid = false;
      } else if (!/^[A-Z0-9]+([-_][A-Z0-9]+)*$/.test(cleanCode)) {
        showErr('f-code', 'err-code', 'Must start and end with letters/numbers. Only single hyphens (-) or underscores (_) allowed in between.');
        valid = false;
      } else {
        clearErr('err-code');
      }

      // 2. Description
      const descInput = document.getElementById('f-desc');
      const cleanDesc = descInput.value.trim();
      const descAlphanumCount = cleanDesc.replace(/[^a-zA-Z0-9]/g, '').length;

      if (!cleanDesc) {
        showErr('f-desc', 'err-desc', 'Description is required.');
        valid = false;
      } else if (cleanDesc.length < 3 || cleanDesc.length > 100) {
        showErr('f-desc', 'err-desc', 'Description must be between 3 and 100 characters.');
        valid = false;
      } else if (descAlphanumCount < 3) {
        showErr('f-desc', 'err-desc', 'Description must contain actual words/letters, not just symbols (e.g. "----------").');
        valid = false;
      } else {
        clearErr('err-desc');
      }

      // 3. Discount Type & Value
      const discValInput = document.getElementById('f-disc-val');
      const dv = parseFloat(discValInput.value);
      const discType = document.getElementById('addDiscType').value;

      if (!discValInput.value || isNaN(dv) || dv <= 0) {
        showErr('f-disc-val', 'err-disc-val', 'Enter a valid discount value greater than 0.');
        valid = false;
      } else if (discType === 'percentage' && dv > 100) {
        showErr('f-disc-val', 'err-disc-val', 'Percentage discount cannot exceed 100%.');
        valid = false;
      } else {
        clearErr('err-disc-val');
      }

      // 4. Min Order Value
      const minOrderInput = document.getElementById('f-min-order');
      const minOrderVal = minOrderInput.value !== '' ? parseFloat(minOrderInput.value) : 0;
      if (minOrderInput.value !== '' && (isNaN(minOrderVal) || minOrderVal < 0)) {
        showErr('f-min-order', 'err-min-order', 'Min order value cannot be negative.');
        valid = false;
      } else if (discType === 'fixed' && minOrderVal > 0 && dv >= minOrderVal) {
        showErr('f-disc-val', 'err-disc-val', 'Fixed discount (₹' + dv + ') must be less than min order value (₹' + minOrderVal + ').');
        valid = false;
      } else {
        clearErr('err-min-order');
      }

      // 5. Max Discount Cap (for percentage discounts)
      if (discType === 'percentage') {
        const maxCapInput = document.getElementById('f-max-cap');
        const capVal = parseFloat(maxCapInput.value);
        if (!maxCapInput.value || isNaN(capVal) || capVal <= 0) {
          showErr('f-max-cap', 'err-max-cap', 'Max discount cap is required and must be greater than 0 for percentage discounts.');
          valid = false;
        } else {
          clearErr('err-max-cap');
        }
      } else {
        clearErr('err-max-cap');
      }

      // 6. Valid Until
      const validUntil = document.getElementById('f-valid');
      if (validUntil.value) {
        const chosen = new Date(validUntil.value);
        const today  = new Date(); today.setHours(0,0,0,0);
        if (chosen < today) {
          showErr('f-valid', 'err-valid', 'Expiry date must be today or in the future.');
          valid = false;
        } else {
          clearErr('err-valid');
        }
      } else {
        clearErr('err-valid');
      }

      // 7. Usage Limit Per User
      const userLimitInput = document.getElementById('f-limit-user');
      const userLimitVal = parseInt(userLimitInput.value, 10);
      if (!userLimitInput.value || isNaN(userLimitVal) || userLimitVal < 1) {
        showErr('f-limit-user', 'err-limit-user', 'Usage limit per user is required and must be at least 1.');
        valid = false;
      } else {
        clearErr('err-limit-user');
      }

      // 8. Total Usage Limit (optional)
      const totalLimitInput = document.getElementById('f-limit-total');
      if (totalLimitInput.value) {
        const totalLimitVal = parseInt(totalLimitInput.value, 10);
        if (isNaN(totalLimitVal) || totalLimitVal < 1) {
          showErr('f-limit-total', 'err-limit-total', 'Total usage limit must be at least 1 if specified.');
          valid = false;
        } else if (userLimitVal > totalLimitVal) {
          showErr('f-limit-total', 'err-limit-total', 'Total limit cannot be smaller than per-user limit.');
          valid = false;
        } else {
          clearErr('err-limit-total');
        }
      } else {
        clearErr('err-limit-total');
      }

      if (valid) {
        document.getElementById('addCouponForm').submit();
      }
    }

    // Delete coupon
    function deleteCoupon(id, code) {
      if (!confirm('Delete coupon "' + code + '"? This cannot be undone.')) return;
      fetch('/admin/coupons/' + id, {
        method : 'DELETE',
        headers: { 'Content-Type': 'application/json' },
      })
      .then(r => r.json())
      .then(data => {
        if (data.success) window.location.reload();
        else alert('Could not delete. Please try again.');
      })
      .catch(() => alert('Server error.'));
    }

    <% if (locals.query && locals.query.open === 'add') { %>
      openAddModal();
    <% } %>
  </script>
</body>
</html>

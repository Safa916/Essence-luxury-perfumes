<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Returns | Essence Admin</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/admin/partials/sidebar.css">
  <link rel="stylesheet" href="/admin/orders/admin-returns.css">
</head>
<body>

  <div class="layout">
    <%- include('../partials/sidebar', { activePage: 'returns' }) %>

    <main class="main-content">
      <header class="page-header">
        <div class="header-titles">
          <h1 class="page-title">ORDER RETURNS</h1>
          <p class="page-desc">Manage customer return requests and refund approvals.</p>
        </div>
        <button class="btn-export">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          EXPORT REPORTS
        </button>
      </header>

      <% if (typeof query !== 'undefined' && query && query.flash === 'approved') { %>
        <div class="flash-alert flash-success">Return request approved successfully. Wallet refunded.</div>
      <% } else if (typeof query !== 'undefined' && query && query.flash === 'rejected') { %>
        <div class="flash-alert flash-error">Return request rejected.</div>
      <% } else if (typeof query !== 'undefined' && query && query.flash === 'error') { %>
        <div class="flash-alert flash-error">An error occurred while processing the return request. Please try again.</div>
      <% } else if (typeof query !== 'undefined' && query && query.flash === 'invalid') { %>
        <div class="flash-alert flash-error">Return request not found or has already been processed.</div>
      <% } %>

      <div class="card returns-registry">
        <div class="card-header">
          <h2 class="card-title">Return Requests Registry</h2>
          <form class="search-box" method="GET" action="/admin/returns">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" name="search" placeholder="Search by Order ID or customer..." value="<%= typeof searchTerm !== 'undefined' ? searchTerm : '' %>">
            <% if (statusFilter !== 'all') { %><input type="hidden" name="status" value="<%= statusFilter %>"><% } %>
          </form>
        </div>

        <div class="table-responsive">
          <table class="returns-table">
            <thead>
              <tr>
                <th>RETURN / ORDER ID</th>
                <th>CUSTOMER NAME</th>
                <th>RETURN DATE</th>
                <th>REASON</th>
                <th>STATUS</th>
                <th>ACTIONS</th>
              </tr>
            </thead>
            <tbody>
              <% if (returns.length === 0) { %>
                <tr>
                  <td colspan="6" class="empty-state">No return requests found.</td>
                </tr>
              <% } else { %>
                <% returns.forEach(r => { 
                   const d = new Date(r.createdAt);
                   const formattedDate = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                %>
                  <tr>
                    <td class="cell-id">
                      <span class="text-danger" title="Return ID">#<%= r.returnId || 'N/A' %></span>
                      <br>
                      <small class="text-muted" style="font-size: 0.75rem;" title="Order ID">Order: #<%= r.order.id %></small>
                    </td>
                    <td class="cell-customer">
                      <span class="cust-name"><%= r.customer.name %></span>
                    </td>
                    <td class="cell-date"><%= formattedDate %></td>
                    <td class="cell-reason"><%= r.reason %></td>
                    <td class="cell-status">
                      <span class="badge badge-<%= r.status %>">
                        <%= r.status === 'requested' ? 'PENDING' : (r.status === 'refunded' ? 'APPROVED' : r.status.toUpperCase()) %>
                      </span>
                    </td>
                    <td class="cell-actions">
                      <% if (r.status === 'requested') { %>
                        <div class="action-buttons">
                          <form action="/admin/returns/<%= r._id %>/approve" method="POST" style="display:inline;">
                            <button type="submit" class="btn-action btn-approve" title="Approve & Refund">Approve</button>
                          </form>
                          <form action="/admin/returns/<%= r._id %>/reject" method="POST" style="display:inline;">
                            <button type="submit" class="btn-action btn-reject" title="Reject">Reject</button>
                          </form>
                        </div>
                      <% } else { %>
                        <span class="text-muted">—</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>

        <% if (totalPages > 1) { %>
          <div class="pagination">
            <span class="pagination-info">Showing <%= ((currentPage - 1) * 10) + 1 %>–<%= Math.min(currentPage * 10, total) %> of <%= total %> returns</span>
            <div class="pagination-controls">
              <% if (currentPage > 1) { %>
                <a href="/admin/returns?page=<%= currentPage - 1 %>&status=<%= statusFilter %>" class="page-link">&lt;</a>
              <% } %>
              
              <% for(let i = 1; i <= totalPages; i++) { %>
                <a href="/admin/returns?page=<%= i %>&status=<%= statusFilter %>" class="page-link <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
              <% } %>

              <% if (currentPage < totalPages) { %>
                <a href="/admin/returns?page=<%= currentPage + 1 %>&status=<%= statusFilter %>" class="page-link">&gt;</a>
              <% } %>
            </div>
          </div>
        <% } %>

      </div>

    </main>
  </div>

  <!-- SweetAlert2 for nice popups -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    // Global sleek toast for admin
    function adminToast(message, type = 'success') {
      let toastContainer = document.getElementById('adminToastContainer');
      if (!toastContainer) {
        toastContainer = document.createElement('div');
        toastContainer.id = 'adminToastContainer';
        toastContainer.style.cssText = 'position:fixed;top:24px;right:24px;z-index:99999;display:flex;flex-direction:column;gap:10px;pointer-events:none;';
        document.body.appendChild(toastContainer);
      }

      const toast = document.createElement('div');
      const bg = type === 'success' ? '#10b981' : (type === 'error' ? '#ef4444' : '#1f2937');
      const icon = type === 'success' ? '✓' : (type === 'error' ? '✕' : 'ℹ');

      toast.style.cssText = `
        display:flex;align-items:center;gap:10px;
        background:#ffffff;color:#111827;
        border-left:4px solid ${bg};
        padding:12px 18px;border-radius:6px;
        box-shadow:0 10px 25px -5px rgba(0,0,0,0.1),0 8px 10px -6px rgba(0,0,0,0.1);
        font-size:0.85rem;font-weight:600;font-family:'Space Grotesk',sans-serif;
        transform:translateX(120%);opacity:0;
        transition:transform 0.3s cubic-bezier(0.16,1,0.3,1),opacity 0.25s ease;
        pointer-events:auto;max-width:380px;
      `;
      toast.innerHTML = `<span style="display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;border-radius:50%;background:${bg}20;color:${bg};font-weight:700;font-size:0.75rem;">${icon}</span><span>${message}</span>`;

      toastContainer.appendChild(toast);
      requestAnimationFrame(() => {
        toast.style.transform = 'translateX(0)';
        toast.style.opacity = '1';
      });

      setTimeout(() => {
        toast.style.transform = 'translateX(120%)';
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
      }, 2500);
    }

    // Auto-dismiss flash messages and clean the ?flash= from the URL immediately
    const flashEl = document.querySelector('.flash-alert');
    if (flashEl) {
      const cleanUrl = window.location.pathname + (window.location.search.replace(/([?&])flash=[^&]*/g, '').replace(/^&/, '?').replace(/\?$/, '') || '');
      history.replaceState(null, '', cleanUrl);
      setTimeout(() => {
        flashEl.classList.add('flash-alert--dismiss');
        setTimeout(() => flashEl.remove(), 400);
      }, 1500);
    }

    function confirmDialog(title, text, confirmBtnText, isDanger) {
      if (typeof Swal !== 'undefined') {
        return Swal.fire({
          title,
          text,
          icon: isDanger ? 'warning' : 'question',
          showCancelButton: true,
          confirmButtonColor: isDanger ? '#d93025' : '#111',
          cancelButtonColor: '#aaa',
          confirmButtonText: confirmBtnText
        }).then(res => res.isConfirmed);
      }
      return Promise.resolve(window.confirm(text || title));
    }

    async function handleReturnAction(form, isApprove) {
      const title = isApprove ? 'Approve Return?' : 'Reject Return?';
      const text = isApprove
        ? "This will approve the return and automatically refund the amount to the customer's wallet."
        : "Are you sure you want to reject this return request?";
      const confirmBtnText = isApprove ? 'Yes, approve it!' : 'Yes, reject it!';

      const confirmed = await confirmDialog(title, text, confirmBtnText, !isApprove);
      if (!confirmed) return;

      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          }
        });

        const data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error(data.message || 'Action failed');
        }

        const tr = form.closest('tr');
        if (tr) {
          const badge = tr.querySelector('.badge');
          if (badge) {
            badge.className = `badge badge-${data.status}`;
            badge.textContent = data.statusLabel || data.status.toUpperCase();
          }
          const actionsCell = tr.querySelector('.cell-actions');
          if (actionsCell) {
            actionsCell.innerHTML = '<span class="text-muted">—</span>';
          }
        }

        adminToast(data.message, 'success');
      } catch (err) {
        console.error(err);
        adminToast(err.message || 'Something went wrong', 'error');
        if (submitBtn) submitBtn.disabled = false;
      }
    }

    document.querySelectorAll('.btn-approve').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        handleReturnAction(this.closest('form'), true);
      });
    });

    document.querySelectorAll('.btn-reject').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        handleReturnAction(this.closest('form'), false);
      });
    });
  </script>

</body>
</html>
